{{- $isWSL := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $kernel := output "uname" "-r" | lower -}}
{{-   if contains "microsoft" $kernel -}}
{{-     $isWSL = true -}}
{{-   end -}}
{{- end -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[update]
    init = true
    force = true
    refreshExternals = "always"

[data]
    isWSL = {{ $isWSL }}
    # Go base install — base version must support GOTOOLCHAIN (≥ 1.21).
    # ⚠ Pinned Linux tarball patch version — REVIEW EVERY 6 MONTHS:
    #     https://go.dev/dl/
    goMinVersion = "1.24"
    goLinuxTarballVersion = "1.24.4"

# Prepend ~/.local/bin to PATH for every chezmoi-spawned subprocess (run_*,
# modify_* via [interpreters.sh] bash, hooks). Without this, on a fresh
# Windows VM the first `chezmoi apply` fails:
#   * `.claude/settings.json` (modify_) sorts alphabetically before
#     `.local/bin/jq.exe` (external) in chezmoi's step-4 update phase, so
#     jq.exe is not yet on disk when `modify_settings.json.sh.tmpl` runs.
#   * Even if we land jq.exe in run_before_ (see run_onchange_before_setup-paths.ps1.tmpl),
#     the bash subprocess chezmoi spawns for the modify_ script inherits
#     chezmoi's PATH at startup — which on a fresh VM lacks ~/.local/bin.
# scriptEnv plugs that gap by injecting PATH at subprocess-spawn time.
# Existing machines: harmless duplicate of ~/.local/bin at the head of PATH.
#
# Windows deliberately does NOT use `env "PATH"` for the rest of PATH. `env "PATH"`
# is the *launching shell's process PATH*, frozen at chezmoi startup; it goes stale
# whenever a migration updates the registry PATH but the shell isn't restarted (a
# pre-migration shell is exactly why run_install-02-npm-tools once reported "npm not
# found" — the nvm dir was already in the registry User PATH but not in that shell).
# Instead we read the authoritative persisted PATH straight from the registry
# (Machine + User) at render time, so every chezmoi subprocess sees the current PATH
# — node/npm and any future registry-managed tool — regardless of the launching
# shell. .NET expands REG_EXPAND_SZ, so no %VAR% leaks through. Unix keeps env "PATH"
# (its login shells stay fresh; nvm is sourced via the load-nvm template fragment).
[scriptEnv]
{{- if eq .chezmoi.os "windows" }}
    PATH = {{ printf "%s;%s" (joinPath .chezmoi.homeDir ".local/bin") (output "powershell" "-NoProfile" "-Command" "[Environment]::GetEnvironmentVariable('Path','Machine')+';'+[Environment]::GetEnvironmentVariable('Path','User')" | trim) | quote }}
{{- else }}
    PATH = {{ printf "%s:%s" (joinPath .chezmoi.homeDir ".local/bin") (env "PATH") | quote }}
{{- end }}

# Windows 需要明確指定 .sh 的 interpreter，否則 modify_ script
# 無法執行（"not a valid Win32 application"）。Unix 上會忽略此設定，
# 直接依 shebang 執行。
#
# Windows 上必須用「絕對路徑」指向 Git Bash 的 wrapper（bin/bash.exe）：
# 1. 從 PowerShell 7 執行 chezmoi 時，PATH 上 `bash` 會解析到
#    C:\Windows\System32\bash.exe（WSL bash），無法處理 chezmoi
#    傳入的 Windows 暫存檔路徑。
# 2. 必須用 bin/bash.exe 而非 usr/bin/bash.exe — 後者是 real bash，
#    從非 MSYS parent 直接呼叫時 MSYSTEM 環境沒設好，coreutils
#    （cat 等）會 DLL 載入失敗。bin/bash.exe 是設環境再 exec real bash 的 wrapper。
# 前提：Windows 上 git 一律用 scoop 安裝。
[interpreters.sh]
{{- if eq .chezmoi.os "windows" }}
    command = {{ joinPath .chezmoi.homeDir "scoop/apps/git/current/bin/bash.exe" | quote }}
{{- else }}
    command = "bash"
{{- end }}
