# Compiled binaries
*.exe
# `go build` inside tools/statusline/ drops the binary next to its source.
tools/statusline/statusline
# Invoke-Pester -CI writes a JUnit report into the working directory.
testResults.xml
# Ad-hoc debug captures, e.g. `chezmoi apply -v > apply.log`. Nothing here is a
# source file; add a `!` exception if a sample log ever needs tracking.
*.log

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OpenSpec generated (per-project, managed by openspec CLI)
.claude/commands/opsx/
.claude/skills/
.codex/skills/
.agent/skills/
openspec/config.yaml

# chezmoi
.chezmoi*.toml.bak
.spectra/
.spectra.yaml
openspec/.vector-search.db*

# Git worktrees
.worktrees/
.claude/handoffs/

# codegraph local index
.codegraph/

# Scratch dir for review-cross-model: the counterpart agent works inside the
# repo so its session is filed against this project, and writes its findings
# here. Removed at the end of every run, including the failed ones.
.cross-model-review/
