{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_ script — npm 全域工具安裝（Windows）
# 需要 npm，由 install-01-runtimes 安裝
#
# 用 run_（每次 apply 都重跑），而非 run_once_：Node runtime 一旦被換掉
# （scoop→nvm 遷移、或 nvm 版本升級換成空的 global node_modules），舊 Node 底下
# 的 npm 全域套件就全部失效。每次 apply 重新檢查、缺什麼補什麼，即可自動補回。
# 下方每個安裝都有 Get-Command idempotent 守衛，已安裝者直接略過，重跑成本極低。

$ErrorActionPreference = "Stop"

Write-Host "=== npm Global Tools Setup ===" -ForegroundColor Cyan

if (-not (Get-Command "npm" -ErrorAction SilentlyContinue)) {
    Write-Host "[npm-tools] npm not found, skipping all npm installs." -ForegroundColor Yellow
    exit 0
}

function Install-NpmPackage {
    param([string]$Command, [string]$Package)
    if (Get-Command $Command -ErrorAction SilentlyContinue) {
        Write-Host "[$Command] already installed, skipping." -ForegroundColor Gray
    } else {
        Write-Host "[$Command] Installing $Package..." -ForegroundColor Yellow
        npm install -g $Package
    }
}

# ── Claude Code ──────────────────────────────────────────────────────────
Install-NpmPackage "claude" "@anthropic-ai/claude-code"

# ── Codex CLI ────────────────────────────────────────────────────────────
Install-NpmPackage "codex" "@openai/codex"

# ── codegraph (semantic code graph MCP) ──────────────────────────────────
Install-NpmPackage "codegraph" "@colbymchenry/codegraph"

# ── OpenSpec CLI ─────────────────────────────────────────────────────────
if (Get-Command "openspec" -ErrorAction SilentlyContinue) {
    Write-Host "[openspec] already installed, skipping." -ForegroundColor Gray
} else {
    Write-Host "[openspec] Installing..." -ForegroundColor Yellow
    npm install -g @fission-ai/openspec
    openspec config set delivery skills
    Write-Host "[openspec] Configured (delivery=skills)." -ForegroundColor Green
}

Write-Host "=== npm tools setup complete. ===" -ForegroundColor Cyan
{{ end -}}
