{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 安裝 ccusage CLI（Unix/macOS/WSL）
# 只在 ccusage 指令不存在時執行安裝，冪等設計

if command -v ccusage &>/dev/null; then
    exit 0  # 已安裝，跳過
fi

{{ template "scripts/load-nvm" }}

if command -v bun &>/dev/null; then
    echo "Installing ccusage (bun)..."
    bun install -g ccusage
elif command -v npm &>/dev/null; then
    echo "Installing ccusage (npm)..."
    npm install -g ccusage
else
    echo "[ccusage] Neither bun nor npm found, skipping install."
    exit 0
fi
{{ end -}}
