{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_onchange_ script — Claude Code plugins + MCP 設定（Windows）
# 需要 claude CLI，由 install-02-npm-tools 安裝
# 腳本內容改變時自動重新執行

$ErrorActionPreference = "Stop"

Write-Host "=== Claude Code Config Setup ===" -ForegroundColor Cyan

if (-not (Get-Command "claude" -ErrorAction SilentlyContinue)) {
    Write-Host "WARNING: claude command not found. Skipping Claude config setup." -ForegroundColor Yellow
    exit 0
}

# ── Plugins ──────────────────────────────────────────────────────────────
# Continue for the whole section: `2>&1` turns native stderr into ErrorRecords,
# which are terminating under Stop. A plugin CLI warning would otherwise abort
# the script here, skipping cache cleanup, hook repair and MCP registration --
# and run_onchange_ records no state on failure, so it would retry every apply.
$ErrorActionPreference = "Continue"

Write-Host "[plugins] Adding superpowers marketplace..." -ForegroundColor Yellow
claude plugin marketplace add obra/superpowers-marketplace 2>&1 | Out-Null

Write-Host "[plugins] Installing slack..." -ForegroundColor Yellow
claude plugin install slack 2>&1 | Out-Null

Write-Host "[plugins] Installing episodic-memory..." -ForegroundColor Yellow
claude plugin install episodic-memory@superpowers-marketplace 2>&1 | Out-Null

Write-Host "[plugins] Installing elements-of-style..." -ForegroundColor Yellow
claude plugin install elements-of-style@superpowers-marketplace 2>&1 | Out-Null

# ── Output style plugin: explanatory (insight-only, replaces learning) ──
# Learning 會要求 scaffold + 留 5-10 行給使用者寫；explanatory 只留 ★ Insight 解說。
$installedPlugins = claude plugin list 2>$null | Out-String
if ($installedPlugins -notmatch "explanatory-output-style@claude-plugins-official") {
    Write-Host "[plugins] Installing explanatory-output-style..." -ForegroundColor Yellow
    claude plugin install explanatory-output-style@claude-plugins-official 2>&1 | Out-Null
}
if ($installedPlugins -match "learning-output-style@claude-plugins-official") {
    Write-Host "[plugins] Removing learning-output-style (superseded by explanatory)..." -ForegroundColor Yellow
    claude plugin uninstall learning-output-style@claude-plugins-official 2>&1 | Out-Null
}

# ── Retired plugin: superpowers ─────────────────────────────────────────
# Workflow skills replaced by the in-house discipline skills in ~/.claude/skills/.
# remove-superpowers-plugin only dropped the install line, so machines that had
# already applied it kept the plugin -- and run_update-claude-plugins, which
# iterates enabledPlugins, kept updating it on every apply. Uninstall here so
# the removal converges on every machine, not just the one where it was run
# by hand.
if ($installedPlugins -match "superpowers@claude-plugins-official") {
    Write-Host "[plugins] Removing superpowers (retired, replaced by in-house discipline skills)..." -ForegroundColor Yellow
    claude plugin uninstall superpowers@claude-plugins-official 2>&1 | Out-Null
}

$ErrorActionPreference = "Stop"

# ── jdtls（Java LSP 依賴）───────────────────────────────────────────────
# jdtls moved OFF scoop in Wave 11 (2026-06-18): now provided by
# .chezmoiexternal.toml at ~/.local/opt/jdtls, launched via ~/.local/bin/jdtls(.cmd).
# Do NOT reintroduce `scoop install jdtls` here -- it would undo the migration.

# ── Plugin cache cleanup ─────────────────────────────────────────────────
Write-Host "[cleanup] Removing stale plugin caches..." -ForegroundColor Yellow
$pluginCache = "$env:USERPROFILE\.claude\plugins\cache"
if (Test-Path "$pluginCache\superpowers-marketplace\superpowers") {
    Remove-Item -Recurse -Force "$pluginCache\superpowers-marketplace\superpowers"
    Write-Host "  Removed marketplace superpowers" -ForegroundColor Green
}
# uninstall clears installed_plugins.json + enabledPlugins but leaves the cache behind
if (Test-Path "$pluginCache\claude-plugins-official\superpowers") {
    Remove-Item -Recurse -Force "$pluginCache\claude-plugins-official\superpowers"
    Write-Host "  Removed official superpowers cache" -ForegroundColor Green
}

# ── episodic-memory dep repair (onnxruntime-common hoist) ────────────────
# The published episodic-memory lockfile nests onnxruntime-common only under
# onnxruntime-node/-web, but @huggingface/transformers does a bare
# `import 'onnxruntime-common'` that needs it at the package root -> its
# SessionStart sync hook dies with ERR_MODULE_NOT_FOUND. Reinstalling reproduces
# the broken layout (it's baked into the lockfile), so surface a top-level copy
# from the already-present, version-matched nested one. Offline + idempotent;
# iterates version dirs so it self-heals across plugin upgrades.
$emBase = Join-Path $pluginCache "superpowers-marketplace\episodic-memory"
if (Test-Path $emBase) {
    foreach ($verDir in (Get-ChildItem -Path $emBase -Directory -ErrorAction SilentlyContinue)) {
        $nm  = Join-Path $verDir.FullName "node_modules"
        $top = Join-Path $nm "onnxruntime-common"
        if (-not (Test-Path $top)) {
            $nested = @(
                (Join-Path $nm "onnxruntime-node\node_modules\onnxruntime-common"),
                (Join-Path $nm "onnxruntime-web\node_modules\onnxruntime-common")
            ) | Where-Object { Test-Path $_ } | Select-Object -First 1
            if ($nested) {
                Copy-Item -LiteralPath $nested -Destination $top -Recurse -Force
                Write-Host "  Repaired episodic-memory deps (onnxruntime-common): $($verDir.Name)" -ForegroundColor Green
            }
        }
    }
}

# ── Hook 路徑修復（backslash → cygpath workaround）──────────────────────
$pluginCache = Join-Path $env:USERPROFILE ".claude\plugins\cache"

if (Test-Path $pluginCache) {
    $hooksFiles = Get-ChildItem -Path $pluginCache -Recurse -Filter "hooks.json" |
        Where-Object { $_.FullName -match "\\hooks\\hooks\.json$" }

    foreach ($file in $hooksFiles) {
        $content = Get-Content $file.FullName -Raw
        if ($content -match '\$\{CLAUDE_PLUGIN_ROOT\}/' -and $content -notmatch 'cygpath') {
            $lines = $content -split "`n"
            $result = @()
            foreach ($line in $lines) {
                if ($line -match '"command"\s*:\s*"\$\{CLAUDE_PLUGIN_ROOT\}/(.+)"' -and $line -notmatch 'cygpath') {
                    $scriptPath = $Matches[1]
                    $hasComma   = $line.TrimEnd().EndsWith(',')
                    $indent     = $line -replace '^(\s*).*', '$1'
                    $newCmd     = "bash -c 'FIXED_ROOT=`$(cygpath -u \`"`${CLAUDE_PLUGIN_ROOT}\`" 2>/dev/null || echo \`"`${CLAUDE_PLUGIN_ROOT}\`"); \`"`$FIXED_ROOT/$scriptPath\`"'"
                    $comma      = if ($hasComma) { ',' } else { '' }
                    $result    += "${indent}`"command`": `"$newCmd`"$comma"
                } else {
                    $result += $line
                }
            }
            $utf8NoBom = New-Object System.Text.UTF8Encoding $false
            [System.IO.File]::WriteAllText($file.FullName, ($result -join "`n"), $utf8NoBom)
            Write-Host "  Patched hooks: $($file.FullName)" -ForegroundColor Gray
        }
    }
}

# ── .sh CRLF 修復 ───────────────────────────────────────────────────────
if (Get-Command "dos2unix" -ErrorAction SilentlyContinue) {
    $shFiles = @(Get-ChildItem -Path $pluginCache -Recurse -Filter "*.sh" -ErrorAction SilentlyContinue)
    $ErrorActionPreference = "Continue"
    foreach ($file in $shFiles) { dos2unix $file.FullName 2>$null }
    $ErrorActionPreference = "Stop"
} else {
    Write-Host "  WARNING: dos2unix not found. Plugin .sh scripts may have CRLF issues." -ForegroundColor Yellow
    Write-Host "  Re-run 'chezmoi apply' to fetch ~/.local/bin/dos2unix.exe (provided by .chezmoiexternal.toml)." -ForegroundColor Yellow
}

# ── hooks.json UTF-8 BOM 移除 ───────────────────────────────────────────
if (Test-Path $pluginCache) {
    $hooksJsonFiles = @(Get-ChildItem -Path $pluginCache -Recurse -Filter "hooks.json" |
        Where-Object { $_.FullName -match "\\hooks\\hooks\.json$" })
    $utf8NoBom = New-Object System.Text.UTF8Encoding $false
    foreach ($file in $hooksJsonFiles) {
        $bytes = [System.IO.File]::ReadAllBytes($file.FullName)
        if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {
            $content = [System.Text.Encoding]::UTF8.GetString($bytes, 3, $bytes.Length - 3)
            [System.IO.File]::WriteAllText($file.FullName, $content, $utf8NoBom)
            Write-Host "  Fixed BOM: $($file.FullName)" -ForegroundColor Gray
        }
    }
}

# ── MCP Servers ──────────────────────────────────────────────────────────
Write-Host "[mcp] Setting up MCP servers..." -ForegroundColor Yellow

function Add-McpIfMissing {
    param([string]$Name, [string[]]$CommandArgs)
    $existing = claude mcp list 2>$null | Select-String -Pattern "^${Name}:" -Quiet
    if ($existing) {
        Write-Host "[mcp] ${Name} already registered, skipping." -ForegroundColor Gray
    } else {
        claude mcp add --scope user $Name -- @CommandArgs
        Write-Host "[mcp] ${Name} registered." -ForegroundColor Green
    }
}

if (Get-Command "codegraph" -ErrorAction SilentlyContinue) {
    Add-McpIfMissing -Name "codegraph" -CommandArgs @("codegraph", "serve", "--mcp")
} else {
    Write-Host "[mcp] codegraph not found, skipping." -ForegroundColor Yellow
}

# ── User-level preferences in ~/.claude.json ────────────────────────────
$claudeJson = Join-Path $env:USERPROFILE ".claude.json"
if ((Test-Path $claudeJson) -and (Get-Command "jq" -ErrorAction SilentlyContinue)) {
    $current = & jq -r '.copyOnSelect // "unset"' $claudeJson
    if ($current -ne "false") {
        $patched = & jq '.copyOnSelect = false' $claudeJson
        $utf8NoBom = New-Object System.Text.UTF8Encoding $false
        [System.IO.File]::WriteAllText($claudeJson, ($patched -join "`n"), $utf8NoBom)
        Write-Host "[config] Set copyOnSelect=false in ~/.claude.json" -ForegroundColor Green
    }
}

Write-Host "=== Claude config setup complete. Restart Claude Code to activate. ===" -ForegroundColor Cyan
{{ end -}}
