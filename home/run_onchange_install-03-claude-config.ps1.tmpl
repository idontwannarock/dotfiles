{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_onchange_ script — Claude Code plugins + MCP 設定（Windows）
# 需要 claude CLI，由 install-02-npm-tools 安裝
# 腳本內容改變時自動重新執行

$ErrorActionPreference = "Stop"

{{ template "scripts/log.ps1" }}

Log-Begin "Claude Code config"
try {
    Log-Section "check claude CLI is available -- every step below drives it"
    if (-not (Get-Command "claude" -ErrorAction SilentlyContinue)) {
        Log-Warn "claude command not found; skipping Claude config setup"
        return
    }

    # Continue for the whole plugin section: `2>&1` turns native stderr into
    # ErrorRecords, which are terminating under Stop. A plugin CLI warning would
    # otherwise abort the script here, skipping cache cleanup, hook repair and MCP
    # registration -- and run_onchange_ records no state on failure, so it would
    # retry every apply. Under the try/catch below it would also surface as a
    # FAILED banner for what is only a warning.
    $ErrorActionPreference = "Continue"

    Log-Section "install Claude Code plugins"
    # Captured, not streamed -- and captured rather than discarded, so a failure
    # still has its diagnostic. The plugin is normally already installed, so the
    # output only says nothing happened. Mirrors the bash half.
    $pluginOut = & claude plugin install slack 2>&1
    if ($LASTEXITCODE -eq 0) {
        if (Test-LogVerbose) { $pluginOut | ForEach-Object { "        $_" } }
        Log-Skip "[plugins] slack present"
    } else {
        $pluginOut | ForEach-Object { "        $_" }
        Log-Warn "[plugins] 'claude plugin install slack' failed; continuing"
    }

    $installedPlugins = claude plugin list 2>$null | Out-String

    # Retired plugins. Dropping the install line is NOT enough: machines that already
    # applied it keep the plugin, and run_update-claude-plugins iterates enabledPlugins
    # and keeps updating it every apply. Uninstall here so removal converges everywhere,
    # not just on the machine where the decision was made.
    #
    # Adding a retirement = adding a row here. Reason text is user-facing.
    $retiredPlugins = @(
        @{ Id = "superpowers@claude-plugins-official";           Reason = "workflow skills replaced by the in-house discipline skills in ~/.claude/skills/" }
        @{ Id = "claude-md-management@claude-plugins-official";  Reason = "unused" }
        @{ Id = "context7@claude-plugins-official";              Reason = "unused" }
        @{ Id = "code-simplifier@claude-plugins-official";       Reason = "unused; a same-named agent once lived in exact_agents/, retired with the review lenses -- unrelated to this plugin either way" }
        @{ Id = "playwright@claude-plugins-official";            Reason = "unused" }
        @{ Id = "commit-commands@claude-plugins-official";       Reason = "unused" }
        @{ Id = "security-guidance@claude-plugins-official";     Reason = "unused" }
        @{ Id = "pr-review-toolkit@claude-plugins-official";     Reason = "unused; review lives in the repo's own code:review-* commands" }
        @{ Id = "pyright-lsp@claude-plugins-official";           Reason = "unused" }
        @{ Id = "jdtls-lsp@claude-plugins-official";             Reason = "unused" }
        @{ Id = "claude-code-setup@claude-plugins-official";     Reason = "unused" }
        @{ Id = "learning-output-style@claude-plugins-official";   Reason = "output styles are served by ~/.claude/output-styles/ELI5.md; the plugin variants only fight it" }
        @{ Id = "explanatory-output-style@claude-plugins-official"; Reason = "its SessionStart hook injects 'you may exceed typical length constraints', which contradicts the ELI5 output style" }
        @{ Id = "code-review@claude-plugins-official";             Reason = "its only surface is /code-review, duplicated by the repo's own code:review-* commands" }
        @{ Id = "elements-of-style@superpowers-marketplace";  Reason = "its rules are rhetorical (Strunk) and aimed at prose someone reads for pleasure; commit messages, MR descriptions, docs and work chat are read for instruction, so CLAUDE.md/AGENTS.md section 5 now names the ASD-STE100 principles instead" }
        @{ Id = "episodic-memory@superpowers-marketplace";    Reason = "27 recorded calls in 508 transcripts (20 search, 7 read, 1 subagent) against 2.3 GB on disk (1.1 GB plugin cache plus 1.2 GB of archive and index under ~/.config/superpowers) and a bespoke onnxruntime patch; keyword search over the raw jsonl in ~/.claude/projects/ covers what remains" }
    )

    Log-Section "uninstall retired plugins so their removal converges on every machine"
    foreach ($p in $retiredPlugins) {
        # Check first: uninstalling something absent writes to stderr, and 11 of those
        # every apply would bury the real output.
        if ($installedPlugins -match [regex]::Escape($p.Id)) {
            Log-Step "[plugins] removing $($p.Id) -- $($p.Reason)"
            claude plugin uninstall $p.Id 2>&1 | Out-Null
        } else {
            Log-Skip "[plugins] $($p.Id) not installed"
        }
    }

    $ErrorActionPreference = "Stop"

    # jdtls moved OFF scoop in Wave 11 (2026-06-18): now provided by
    # .chezmoiexternal.toml at ~/.local/opt/jdtls, launched via ~/.local/bin/jdtls(.cmd).
    # Do NOT reintroduce `scoop install jdtls` here -- it would undo the migration.

    $pluginCache = Join-Path $env:USERPROFILE ".claude\plugins\cache"

    Log-Section "drop the stale caches the retired plugins leave behind"
    # Unconditional, NOT gated on "did we just uninstall": uninstall clears
    # installed_plugins.json + enabledPlugins but leaves the cache dir. A machine
    # where the plugin was removed by hand still has the cache to clean.
    foreach ($p in $retiredPlugins) {
        $id, $marketplace = $p.Id -split "@", 2
        $dir = Join-Path $pluginCache (Join-Path $marketplace $id)
        if (Test-Path $dir) {
            Remove-Item -Recurse -Force $dir
            Log-Step "[cleanup] removed $marketplace/$id cache"
        } else {
            Log-Skip "[cleanup] no stale $marketplace/$id cache"
        }
    }
    # superpowers-marketplace has no consumers left: superpowers, episodic-memory and
    # elements-of-style are all retired. Drop the whole marketplace, not just the
    # three plugin dirs -- a registered marketplace with nothing installed still
    # gets refreshed on every plugin operation. Remove the cache first: the
    # marketplace command does not prune it.
    if (Test-Path "$pluginCache\superpowers-marketplace") {
        Remove-Item -Recurse -Force "$pluginCache\superpowers-marketplace"
        Log-Step "[cleanup] removed superpowers-marketplace cache"
    } else {
        Log-Skip "[cleanup] no stale superpowers-marketplace cache"
    }
    if ((claude plugin marketplace list 2>$null | Out-String) -match "superpowers-marketplace") {
        Log-Step "[plugins] removing marketplace superpowers-marketplace -- no plugin uses it"
        claude plugin marketplace remove superpowers-marketplace 2>&1 | Out-Null
    } else {
        Log-Skip "[plugins] superpowers-marketplace not registered"
    }

    Log-Section "rewrite plugin hook commands through cygpath -- Git Bash cannot use the backslash paths Claude emits"
    if (Test-Path $pluginCache) {
        $hooksFiles = Get-ChildItem -Path $pluginCache -Recurse -Filter "hooks.json" |
            Where-Object { $_.FullName -match "\\hooks\\hooks\.json$" }

        foreach ($file in $hooksFiles) {
            $content = Get-Content $file.FullName -Raw
            if ($content -match '\$\{CLAUDE_PLUGIN_ROOT\}/' -and $content -notmatch 'cygpath') {
                $lines = $content -split "`n"
                $result = @()
                foreach ($line in $lines) {
                    if ($line -match '"command"\s*:\s*"\$\{CLAUDE_PLUGIN_ROOT\}/(.+)"' -and $line -notmatch 'cygpath') {
                        $scriptPath = $Matches[1]
                        $hasComma   = $line.TrimEnd().EndsWith(',')
                        $indent     = $line -replace '^(\s*).*', '$1'
                        $newCmd     = "bash -c 'FIXED_ROOT=`$(cygpath -u \`"`${CLAUDE_PLUGIN_ROOT}\`" 2>/dev/null || echo \`"`${CLAUDE_PLUGIN_ROOT}\`"); \`"`$FIXED_ROOT/$scriptPath\`"'"
                        $comma      = if ($hasComma) { ',' } else { '' }
                        $result    += "${indent}`"command`": `"$newCmd`"$comma"
                    } else {
                        $result += $line
                    }
                }
                $utf8NoBom = New-Object System.Text.UTF8Encoding $false
                [System.IO.File]::WriteAllText($file.FullName, ($result -join "`n"), $utf8NoBom)
                Log-Step "[hooks] patched $($file.FullName)"
            }
        }
    }

    Log-Section "strip CRLF from plugin .sh files -- Git Bash refuses to run them otherwise"
    if (Get-Command "dos2unix" -ErrorAction SilentlyContinue) {
        $shFiles = @(Get-ChildItem -Path $pluginCache -Recurse -Filter "*.sh" -ErrorAction SilentlyContinue)
        Log-Step "[crlf] converting $($shFiles.Count) plugin .sh files"
        $ErrorActionPreference = "Continue"
        foreach ($file in $shFiles) { dos2unix $file.FullName 2>$null }
        $ErrorActionPreference = "Stop"
    } else {
        Log-Warn "[crlf] dos2unix not found; plugin .sh scripts may have CRLF issues"
        Log-Warn "[crlf] re-run 'chezmoi apply' to fetch ~/.local/bin/dos2unix.exe (from .chezmoiexternal.toml)"
    }

    Log-Section "strip UTF-8 BOM from hooks.json -- Claude's JSON parser rejects it"
    if (Test-Path $pluginCache) {
        $hooksJsonFiles = @(Get-ChildItem -Path $pluginCache -Recurse -Filter "hooks.json" |
            Where-Object { $_.FullName -match "\\hooks\\hooks\.json$" })
        $utf8NoBom = New-Object System.Text.UTF8Encoding $false
        foreach ($file in $hooksJsonFiles) {
            $bytes = [System.IO.File]::ReadAllBytes($file.FullName)
            if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {
                $content = [System.Text.Encoding]::UTF8.GetString($bytes, 3, $bytes.Length - 3)
                [System.IO.File]::WriteAllText($file.FullName, $content, $utf8NoBom)
                Log-Step "[bom] stripped BOM from $($file.FullName)"
            }
        }
    }

    Log-Section "register user-scope MCP servers -- a stdio server costs one process per session"
    # The cost of user scope is per session, not per machine, so a stdio server
    # earns the scope only if every session genuinely uses it. An http server
    # spawns nothing locally and is close to free. Everything still out of
    # scope (chrome-devtools, agent-browser, codex) is installed by install-02
    # but left unregistered: each repo opts in with
    # `claude mcp add --scope project`. See docs/claude-code.md.
    #
    # -AddArgs is handed to `claude mcp add` verbatim, so a row can carry
    # `--transport http` ahead of a url or `--` ahead of a command.
    function Add-McpIfMissing {
        param([string]$Name, [string[]]$AddArgs)
        $existing = claude mcp list 2>$null | Select-String -Pattern "^${Name}:" -Quiet
        if ($existing) {
            Log-Skip "[mcp] ${Name} already registered"
        } else {
            claude mcp add --scope user $Name @AddArgs
            Log-Step "[mcp] ${Name} registered"
        }
    }

    # Retired MCP servers. Same convergence rule as the retired plugins above:
    # dropping the add line leaves the entry in ~/.claude.json on every machine
    # that already applied, and a stdio server keeps costing a process per
    # session there.
    #
    # Adding a retirement = adding a row here.
    # Keep this list identical to the bash twin in the .sh.tmpl.
    $retiredMcp = @{
        "codegraph" = "2 calls across the whole transcript history, one of them a status probe; its 9 tool schemas loaded every session regardless"
    }
    foreach ($name in $retiredMcp.Keys) {
        $present = claude mcp list 2>$null | Select-String -Pattern "^${name}:" -Quiet
        if ($present) {
            Log-Step "[mcp] unregistering ${name} -- $($retiredMcp[$name])"
            # 2>$null for the same reason as the `claude mcp list` guard above:
            # this section runs under Stop, where 2>&1 makes native stderr
            # terminating.
            claude mcp remove --scope user $name 2>$null | Out-Null
        } else {
            Log-Skip "[mcp] ${name} not registered"
        }
    }

    # http transport: no binary to guard on, and no per-session process. The
    # script registers it but cannot log in -- run /mcp and pick atlassian to
    # finish the OAuth flow on a new machine.
    #
    # /v2/mcp replaces /v1/mcp/authv2. It swaps 40 flat tools for ~10 plus a
    # discover/execute layer over 243 operations, and reaches Bitbucket, Loom,
    # Talent, Goals and Projects. It drops Compass. The guard above matches on
    # name only, so a machine already holding the old url keeps it -- see
    # docs/claude-code.md for the one-line migration.
    Add-McpIfMissing -Name "atlassian" -AddArgs @("--transport", "http", "https://mcp.atlassian.com/v2/mcp")

    Log-Section "set user preferences in ~/.claude.json"
    $claudeJson = Join-Path $env:USERPROFILE ".claude.json"
    if ((Test-Path $claudeJson) -and (Get-Command "jq" -ErrorAction SilentlyContinue)) {
        # `jq -e` on a comparison, not `// "unset"`. jq's // treats false and
        # null alike, so a copyOnSelect that was already false read back as
        # "unset" and this rewrote ~/.claude.json on every single apply while
        # reporting a change that had already been made. -e exits non-zero when
        # the result is false or null, which is exactly the "needs setting" case.
        & jq -e '.copyOnSelect == false' $claudeJson *> $null
        if ($LASTEXITCODE -eq 0) {
            Log-Skip "[config] copyOnSelect already false"
        } else {
            $patched = & jq '.copyOnSelect = false' $claudeJson
            $utf8NoBom = New-Object System.Text.UTF8Encoding $false
            [System.IO.File]::WriteAllText($claudeJson, ($patched -join "`n"), $utf8NoBom)
            Log-Step "[config] set copyOnSelect=false"
        }
    } else {
        Log-Skip "[config] ~/.claude.json or jq missing"
    }

    Log-Step "restart Claude Code to activate the changes above"
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
