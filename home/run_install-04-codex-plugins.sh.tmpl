{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_ script -- Codex MCP servers (Unix/macOS/WSL)
# Requires codex from install-02-npm-tools and config.toml from the file-write phase.

set -euo pipefail

{{ template "scripts/load-nvm" }}

echo "=== Codex MCP Setup ==="

if ! command -v codex &>/dev/null; then
    echo "[codex-mcp] codex not found, skipping."
    exit 0
fi

if codex mcp get slack &>/dev/null; then
    echo "[codex-mcp] slack already registered, skipping."
else
    echo "[codex-mcp] Registering slack MCP server..."
    # `codex mcp add` writes the server entry, then auto-starts an OAuth flow
    # that cannot complete non-interactively, so it exits non-zero even though
    # the registration succeeded. Tolerate that and verify the entry landed.
    codex mcp add slack --url https://mcp.slack.com/mcp &>/dev/null || true
    if ! codex mcp get slack &>/dev/null; then
        echo "[codex-mcp] ERROR: failed to register slack MCP server." >&2
        exit 1
    fi
    echo "[codex-mcp] slack registered. Log in from the Codex CLI to authenticate (per-machine)."
fi

echo "=== Codex MCP setup complete. ==="
{{ end -}}
