{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_before_ script — 安裝後續 phase 需要的 CLI 依賴
#
# jq: modify_settings.json.sh.tmpl 用來 patch Claude Code settings.json

{{ template "scripts/log.sh" }}

log_begin "apply prereqs"

log_section "ensure jq — modify_settings.json.sh.tmpl needs it to patch Claude Code settings"
if command -v jq &>/dev/null; then
    log_skip "[jq] already installed"
    exit 0
fi

{{- if eq .chezmoi.os "darwin" }}
log_step "[jq] installing via brew"
brew install jq
{{- else }}
log_step "[jq] installing via apt (Linux/WSL)"
sudo apt-get update -q && sudo apt-get install -y jq
{{- end }}
{{ end -}}
