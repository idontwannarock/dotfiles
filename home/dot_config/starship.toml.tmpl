# Starship prompt configuration
# https://starship.rs/config/
#
# This must live at ~/.config/starship.toml — the path starship reads by default.
# A ~/.config/starship/ subdirectory is NOT searched, and a missing config fails
# silently (starship falls back to built-in defaults and still draws a prompt),
# so a misplaced file looks exactly like a working one.

# Increase command timeout so git_status can finish instead of being cut off.
# The worst case is WSL reading a repo on a mounted Windows drive (/mnt/c, /mnt/d):
# every file access crosses the filesystem boundary. Measured on /mnt/d with one
# untracked file present: at 1000ms git_status returned an empty string and the
# prompt showed a clean repo; at 5000ms it needed 1150-1560ms and reported "[?]".
# A clean repo hides this, because an empty result is then the correct answer.
# Raising the ceiling costs nothing where git is fast (10ms on native Linux paths,
# 289ms on Windows) — the timeout only applies when it is exceeded.
command_timeout = 5000

# Shell indicator — show which shell the prompt belongs to, since every shell
# shares this one config and otherwise looks identical.
# pwsh_indicator defaults to unset and falls back to powershell_indicator, so
# without it PowerShell 5.1 and 7+ are indistinguishable. The split comes from
# starship's own init script, which sets STARSHIP_SHELL to "powershell" on 5.1
# and "pwsh" on 6+.
[shell]
disabled = false
bash_indicator = "bash"
zsh_indicator = "zsh"
fish_indicator = "fish"
powershell_indicator = "ps5"
pwsh_indicator = "pwsh"
cmd_indicator = "cmd"
# Default is an empty string, which would hide an unrecognised shell entirely
unknown_indicator = "?sh"
style = "bold yellow"
format = "[$indicator]($style) "
{{- if eq .chezmoi.os "windows" }}

# Windows only: git modules off.
# Finding a git repository costs about 775 ms on this machine, whatever the
# repository size, and git_status adds 289 ms on top. Every module that needs the
# repository pays that 775 ms, so turning off git_status alone saves little.
# Measured in D:\ws\github\dotfiles: 1282 ms per prompt with these on, 200 ms off.
# In D:\ws\github\OpenSearch: 2208 ms on, 352 ms off.
# truncate_to_repo must go too. It is what makes the directory module ask for the
# repository, so leaving it on keeps the 775 ms even with every git module off.
# WSL is unaffected and keeps all git modules: it renders in 15 ms on a native
# Linux path, because the cost is Windows process and file access, not starship.
[directory]
truncate_to_repo = false

[git_branch]
disabled = true

[git_status]
disabled = true

[git_state]
disabled = true

[git_commit]
disabled = true
{{- end }}
