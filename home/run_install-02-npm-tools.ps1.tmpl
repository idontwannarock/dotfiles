{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_ script — npm 全域工具安裝（Windows）
# 需要 npm，由 install-01-runtimes 安裝
#
# 用 run_（每次 apply 都重跑），而非 run_once_：Node runtime 一旦被換掉
# （scoop→nvm 遷移、或 nvm 版本升級換成空的 global node_modules），舊 Node 底下
# 的 npm 全域套件就全部失效。每次 apply 重新檢查、缺什麼補什麼，即可自動補回。
# 下方每個安裝都有 Get-Command idempotent 守衛，已安裝者直接略過，重跑成本極低。

$ErrorActionPreference = "Stop"

{{ template "scripts/log.ps1" }}
{{ template "scripts/npm-install.ps1" }}

Log-Begin "npm global tools"
try {
    Log-Section "check npm is available -- every install below needs it"
    if (-not (Get-Command "npm" -ErrorAction SilentlyContinue)) {
        Log-Warn "[npm-tools] npm not found; skipping all npm installs"
        return
    }

    # Retired npm tools. Dropping the install line is NOT enough: machines that
    # already applied keep the package forever. Uninstall here so removal
    # converges everywhere, not just on the machine where the decision was made.
    # Keep this list identical to the bash twin in the .sh.tmpl.
    Log-Section "uninstall retired npm tools so removal converges on every machine"
    # 2>$null, NOT 2>&1: this file runs under $ErrorActionPreference = "Stop",
    # where 2>&1 turns native stderr into a terminating ErrorRecord. `npm ls` for
    # an absent package writes to stderr -- which is the normal case on a clean
    # machine -- so 2>&1 here would abort the whole script before it installed
    # anything. $LASTEXITCODE still carries npm's answer either way.
    npm ls -g --depth=0 "@colbymchenry/codegraph" 2>$null | Out-Null
    if ($LASTEXITCODE -eq 0) {
        Log-Step "[npm-tools] removing codegraph -- 2 calls across the whole transcript history, one of them a status probe; its 9 tool schemas loaded every session regardless"
        npm uninstall -g "@colbymchenry/codegraph" 2>$null | Out-Null
    } else {
        Log-Skip "[npm-tools] codegraph not installed"
    }

    Log-Section "install Claude Code CLI"
    Install-NpmPackage -Command "claude" -Package "@anthropic-ai/claude-code"

    Log-Section "install Codex CLI"
    Install-NpmPackage -Command "codex" -Package "@openai/codex"

    # The app-server daemon keeps its own copy of Codex and, by default,
    # updates it hourly. npm never updates the CLI on its own, so the CLI falls
    # behind and the daemon refuses it ("Background server has incompatible
    # feature settings"). Fix: chezmoi owns the version. Upgrade the CLI here,
    # turn the daemon updater off, and pin the daemon to the CLI package.
    # Keep this logic identical to the bash twin in the .sh.tmpl.
    Log-Section "upgrade Codex CLI -- the daemon gets pinned to this package below"
    $codexCurrent = ((codex --version 2>$null) -split ' ')[-1]
    $codexLatest = npm view "@openai/codex" version 2>$null
    if ($LASTEXITCODE -ne 0 -or -not $codexLatest) {
        Log-Warn "[codex] npm registry unreachable; keeping $codexCurrent"
    } elseif ($codexCurrent -eq $codexLatest.Trim()) {
        Log-Skip "[codex] already at $codexCurrent"
    } else {
        $codexLatest = $codexLatest.Trim()
        Log-Step "[codex] upgrading $codexCurrent -> $codexLatest"
        npm install -g "@openai/codex@$codexLatest"
    }

    Log-Section "turn off the daemon updater -- otherwise the daemon moves ahead of the CLI within an hour"
    $codexHome = if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $HOME ".codex" }
    $daemonSettings = Join-Path $codexHome "app-server-daemon\settings.json"
    $settings = if (Test-Path $daemonSettings) { Get-Content -Raw $daemonSettings | ConvertFrom-Json } else { [pscustomobject]@{} }
    $daemonSettingsChanged = $false
    if ($settings.updater -and $settings.updater.autoUpdateEnabled -eq $false) {
        Log-Skip "[codex] daemon updater already off"
    } else {
        Log-Step "[codex] setting updater.autoUpdateEnabled=false in $daemonSettings"
        if (-not $settings.updater) {
            $settings | Add-Member -NotePropertyName updater -NotePropertyValue ([pscustomobject]@{}) -Force
        }
        $settings.updater | Add-Member -NotePropertyName autoUpdateEnabled -NotePropertyValue $false -Force
        New-Item -ItemType Directory -Force -Path (Split-Path $daemonSettings) | Out-Null
        # WriteAllText, not Set-Content: PowerShell 5.1 writes a BOM with
        # -Encoding utf8, and the daemon's JSON parser may reject it.
        [IO.File]::WriteAllText($daemonSettings, ($settings | ConvertTo-Json -Depth 10))
        $daemonSettingsChanged = $true
    }

    # Also pin when the settings just changed: a running updater only reads
    # the new setting after a daemon restart, and the pin restarts the daemon.
    Log-Section "pin the daemon to the CLI package -- a running daemon restarts"
    $daemonCodex = Join-Path $codexHome "packages\app-server-daemon\current\bin\codex.exe"
    $codexCurrent = ((codex --version 2>$null) -split ' ')[-1]
    if (-not (Test-Path $daemonCodex)) {
        Log-Skip "[codex] no daemon package yet; the first daemon start copies the CLI package"
    } else {
        $daemonVersion = ((& $daemonCodex --version 2>$null) -split ' ')[-1]
        if ($daemonVersion -eq $codexCurrent -and -not $daemonSettingsChanged) {
            Log-Skip "[codex] daemon already at $codexCurrent"
        } else {
            Log-Step "[codex] pinning daemon $daemonVersion -> CLI $codexCurrent"
            $pinOut = codex app-server daemon update --from-cli --yes 2>$null
            if ($LASTEXITCODE -ne 0) {
                Log-Warn "[codex] daemon pin failed: $pinOut"
            }
        }
    }

    # The two browser MCP servers are INSTALLED here but deliberately NOT
    # registered by install-03: user scope would spawn them in every session,
    # including the many that never touch a browser. A repo that needs one
    # opts in with `claude mcp add --scope project`. Installing globally
    # rather than leaving it to `npx -y <pkg>@latest` still matters -- npx
    # adds an `npm exec` wrapper plus a `sh -c` layer, 3 processes where a
    # binary costs 1.
    Log-Section "install chrome-devtools-mcp -- available for repos that opt in, not registered globally"
    Install-NpmPackage -Command "chrome-devtools-mcp" -Package "chrome-devtools-mcp"

    Log-Section "install agent-browser-mcp -- same deal as chrome-devtools-mcp"
    Install-NpmPackage -Command "agent-browser-mcp" -Package "agent-browser-mcp"

    Log-Section "install OpenSpec CLI -- spec/change tracking used by dev-workflow"
    if (Get-Command "openspec" -ErrorAction SilentlyContinue) {
        Log-Skip "[openspec] already installed"
    } else {
        Log-Step "[openspec] installing @fission-ai/openspec"
        npm install -g @fission-ai/openspec
        Log-Step "[openspec] setting delivery=skills (no slash commands)"
        openspec config set delivery skills
    }
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
