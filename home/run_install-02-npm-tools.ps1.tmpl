{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_ script — npm 全域工具安裝（Windows）
# 需要 npm，由 install-01-runtimes 安裝
#
# 用 run_（每次 apply 都重跑），而非 run_once_：Node runtime 一旦被換掉
# （scoop→nvm 遷移、或 nvm 版本升級換成空的 global node_modules），舊 Node 底下
# 的 npm 全域套件就全部失效。每次 apply 重新檢查、缺什麼補什麼，即可自動補回。
# 下方每個安裝都有 Get-Command idempotent 守衛，已安裝者直接略過，重跑成本極低。

$ErrorActionPreference = "Stop"

{{ template "scripts/log.ps1" }}
{{ template "scripts/npm-install.ps1" }}

Log-Begin "npm global tools"
try {
    Log-Section "check npm is available — every install below needs it"
    if (-not (Get-Command "npm" -ErrorAction SilentlyContinue)) {
        Log-Warn "[npm-tools] npm not found; skipping all npm installs"
        return
    }

    Log-Section "install Claude Code CLI"
    Install-NpmPackage -Command "claude" -Package "@anthropic-ai/claude-code"

    Log-Section "install Codex CLI"
    Install-NpmPackage -Command "codex" -Package "@openai/codex"

    Log-Section "install codegraph — semantic code graph MCP server"
    Install-NpmPackage -Command "codegraph" -Package "@colbymchenry/codegraph"

    # The two browser MCP servers are INSTALLED here but deliberately NOT
    # registered by install-03: user scope would spawn them in every session,
    # including the many that never touch a browser. A repo that needs one
    # opts in with `claude mcp add --scope project`. Installing globally
    # rather than leaving it to `npx -y <pkg>@latest` still matters -- npx
    # adds an `npm exec` wrapper plus a `sh -c` layer, 3 processes where a
    # binary costs 1.
    Log-Section "install chrome-devtools-mcp — available for repos that opt in, not registered globally"
    Install-NpmPackage -Command "chrome-devtools-mcp" -Package "chrome-devtools-mcp"

    Log-Section "install agent-browser-mcp — same deal as chrome-devtools-mcp"
    Install-NpmPackage -Command "agent-browser-mcp" -Package "agent-browser-mcp"

    Log-Section "install OpenSpec CLI — spec/change tracking used by dev-workflow"
    if (Get-Command "openspec" -ErrorAction SilentlyContinue) {
        Log-Skip "[openspec] already installed"
    } else {
        Log-Step "[openspec] installing @fission-ai/openspec"
        npm install -g @fission-ai/openspec
        Log-Step "[openspec] setting delivery=skills (no slash commands)"
        openspec config set delivery skills
    }
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
