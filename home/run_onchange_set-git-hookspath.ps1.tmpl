{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_onchange_ — point git at the global hooks dispatcher (Windows).
# git hooks run under git-bash, so the POSIX dispatcher in ~/.config/git/hooks
# works here too. Idempotent; never clobbers an existing non-target value.
$target = "$env:USERPROFILE/.config/git/hooks"
$current = (git config --global --get core.hooksPath 2>$null)

if ($current -eq $target) {
    exit 0
} elseif ($current) {
    Write-Warning "core.hooksPath already set to '$current' (not '$target'); leaving as-is."
    Write-Host "To enable global local-files restore, set it to '$target' manually."
    exit 0
}

git config --global core.hooksPath "$target"
Write-Host "Set global core.hooksPath -> $target"
{{ end -}}
