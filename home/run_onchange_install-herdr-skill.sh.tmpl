{{- if lookPath "herdr" -}}
{{- $ver := output "herdr" "--version" | trim | replace "herdr " "" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_ script — 把 herdr 官方 skill 同步成本機 herdr 的對應版本
#
# skill 直接從 binary 取（`herdr --skill`，v0.8.0 新增），不再從 GitHub 抓。理由是
# 「版本一致」這件事本來就是這支腳本的目的：skill 是 CLI 語法教學，跟 binary 對不上
# 就會教 agent 用不存在的指令，而且不會報錯。從 binary 自己吐，一致性是結構保證，
# 不是靠版本號推導 URL 去逼近。順帶消掉三個真實踩過的坑：
#   * semverCompare 預設排除 prerelease，preview 版（0.8.0-preview.<date>-<sha>）
#     會讓 `>=0.8.0` 回 false，選到搬走前的舊 SKILL.md 路徑。
#   * preview 的 git tag 是 preview-<date>-<sha>，`v<version>` 組不出來，一律 404。
#   * 上游 org 從 ogulcancelik 改名 herdrdev（目前靠 GitHub redirect 續命）。
# 代價：herdr < 0.8.0 沒有 --skill，會走下面的軟著陸保留現有檔案。
#
# 為什麼不是 .chezmoiexternal.toml：external 抓不到檔案時 chezmoi 整個指令 exit 1
# 中止，字典序排在後面的 target 會全部靜默落空（見 README Troubleshooting）。腳本
# 能失敗軟著陸——取不到就保留現有檔案、印警告、正常結束，apply 照常走完。
#
# run_onchange_ 的 key 是下面渲染出來的版本號，因此只有本機 herdr 換版時才重跑。
# herdr 不在 PATH 時整支腳本渲染成空字串，不需要額外的 OS 條件——注意 Windows 上
# 這代表「裝了就會跑」，見 docs/herdr.md 的 chezmoi init 陷阱。
#
# herdr version: {{ $ver }}

set -euo pipefail

{{ template "scripts/log.sh" }}

log_begin "herdr skill"

VERSION="{{ $ver }}"

log_section "sync the agent skill to the installed herdr (v${VERSION})"

TMP="$(mktemp)"

# stdout 進檔案、stderr 收進變數：herdr 的錯誤訊息不能混進 skill 內容，但失敗時
# 要讀得出是哪一種失敗（舊版沒有 --skill vs. binary 壞掉）。
if ! SKILL_ERR="$(herdr --skill 2>&1 >"$TMP")"; then
    rm -f "$TMP"
    log_warn "herdr --skill failed (${SKILL_ERR:-no detail}) — keeping the skill already on disk"
    exit 0
fi

# Windows 的 herdr.exe 吐 CRLF。MSYS 的 text mode 會讓 grep/head 讀起來像沒事，
# 但落到磁碟上的 SKILL.md 仍帶 \r，Codex 較嚴格的 frontmatter parser 會踩到。
# Unix 端沒有 CR，這行是 no-op。
tr -d '\r' < "$TMP" > "$TMP.lf" && mv "$TMP.lf" "$TMP"

# 驗證再覆蓋：拿到半截檔案或錯誤輸出時，舊的可用版本比新的壞檔案有價值。
# description 必須帶引號——Codex 的 YAML frontmatter parser 比 Claude 嚴格。
if ! [ -s "$TMP" ] \
    || [ "$(head -n 1 "$TMP")" != "---" ] \
    || ! grep -q '^name: herdr$' "$TMP" \
    || ! grep -q '^description: "' "$TMP"; then
    rm -f "$TMP"
    log_warn "v${VERSION} skill failed validation — keeping the skill already on disk"
    exit 0
fi

for target in "$HOME/.claude/skills/herdr/SKILL.md" "$HOME/.codex/skills/herdr/SKILL.md"; do
    if [ -f "$target" ] && cmp -s "$TMP" "$target"; then
        log_skip "${target/#$HOME/\~} already at v${VERSION}"
        continue
    fi
    mkdir -p "$(dirname "$target")"
    cp "$TMP" "$target"
    log_step "wrote ${target/#$HOME/\~} ($(wc -l < "$TMP") lines)"
done

rm -f "$TMP"
{{- end }}
