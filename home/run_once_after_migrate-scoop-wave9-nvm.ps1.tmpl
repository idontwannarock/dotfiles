{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_after_ script -- Wave 9 Scoop -> chezmoi-external migration (nvm-windows)
#
# Runs after .chezmoiexternal.toml extracts nvm-noinstall.zip into ~/.local/opt/nvm/.
# All steps are idempotent (gated on desired-state).
#
# Kept separate from run_once_after_migrate-scoop-cleanup.ps1.tmpl: the uninstall
# here needs its own post-check (scoop lies about success -- see below), plus env,
# PATH, settings.txt and a Node bootstrap.
#
# Off-scoop rationale + SSH-symlink safety: the scoop breakage was the shim
# (CreateProcess fails under SSH ConPTY) plus the `current` JUNCTION (mklink /J)
# whose Test-Path returns False under the SSH restricted token. nvm's own
# NVM_SYMLINK is a directory SYMLINK (mklink /D), a different reparse type that
# was verified to traverse fine under a real SSH session. Migrating removes the
# shim entirely and the remaining symlink is SSH-safe.

$ErrorActionPreference = "Continue"

{{ template "scripts/log.ps1" }}

$nvmHome    = Join-Path $env:USERPROFILE ".local\opt\nvm"
$nvmRoot    = Join-Path $nvmHome "nodejs"
$nvmSymlink = Join-Path $nvmRoot "nodejs"
$nvmExe     = Join-Path $nvmHome "nvm.exe"

Log-Begin "Wave 9: scoop -> chezmoi-external (nvm)"
try {
    Log-Section "guard on the external having landed — everything below drives nvm.exe"
    if (-not (Test-Path $nvmExe)) {
        Log-Warn "[nvm] $nvmExe not found -- .chezmoiexternal.toml has not extracted nvm-noinstall.zip yet"
        Log-Warn "[nvm] skipping; rerun 'chezmoi apply'"
        return
    }

    Log-Section "uninstall scoop nvm — this also strips scoop's NVM_HOME/NVM_SYMLINK env and PATH entries"
    if (Get-Command "scoop" -ErrorAction SilentlyContinue) {
        $installed = $false
        try {
            $listOutput = scoop list nvm 2>$null | Out-String
            if ($listOutput -match "(?im)^\s*nvm\b") { $installed = $true }
        } catch {}
        if ($installed) {
            Log-Step "[nvm] uninstalling from scoop"
            scoop uninstall nvm 2>&1 | Out-Null
            # scoop returns exit 0 EVEN when it refuses to uninstall because a node.exe
            # is still running ("instances of nvm are still running"). Trusting
            # $LASTEXITCODE silently leaves scoop's nvm + its PATH/env entries behind,
            # and this run_once never retries -- so verify the app dir is actually gone.
            $scoopNvmDir = Join-Path $env:USERPROFILE "scoop\apps\nvm"
            if (Test-Path $scoopNvmDir) {
                Log-Warn "[nvm] scoop uninstall did NOT remove $scoopNvmDir (a running node.exe usually blocks it)"
                Log-Warn "[nvm] close every node process, run 'scoop uninstall nvm' manually, then strip leftover scoop\apps\nvm entries from User PATH"
            } else {
                Log-Step "[nvm] scoop nvm removed"
            }
        } else {
            Log-Skip "[nvm] not installed via scoop"
        }
    } else {
        Log-Skip "scoop not found; skipping uninstall"
    }

    Log-Section "point User NVM_HOME / NVM_SYMLINK at the new ~/.local/opt/nvm location"
    foreach ($pair in @(@("NVM_HOME", $nvmHome), @("NVM_SYMLINK", $nvmSymlink))) {
        $name = $pair[0]
        $want = $pair[1]
        $cur  = [Environment]::GetEnvironmentVariable($name, "User")
        if ($cur -ieq $want) {
            Log-Skip "[$name] already set"
        } else {
            [Environment]::SetEnvironmentVariable($name, $want, "User")
            Log-Step "[$name] set -> $want"
        }
        # Also set in THIS process so the bootstrap below can invoke nvm.
        Set-Item "env:$name" $want
    }

    Log-Section "prepend NVM_HOME (nvm.exe) and NVM_SYMLINK (node/npm) to User PATH"
    $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
    $entries  = if ($userPath) { @($userPath.Split(';') | Where-Object { $_ -ne '' }) } else { @() }
    $expanded = @($entries | ForEach-Object { [Environment]::ExpandEnvironmentVariables($_).TrimEnd('\') })

    $pathChanged = $false
    foreach ($p in @($nvmHome, $nvmSymlink)) {
        $pNorm = $p.TrimEnd('\')
        if ($expanded -inotcontains $pNorm) {
            $entries  = @($p) + $entries
            $expanded = @($pNorm) + $expanded
            $pathChanged = $true
            Log-Step "[PATH] prepended $p"
        }
    }
    if ($pathChanged) {
        [Environment]::SetEnvironmentVariable("Path", ($entries -join ';'), "User")
        Log-Warn "[PATH] User PATH updated -- restart your terminal/SSH session to pick it up"
    } else {
        Log-Skip "[PATH] NVM_HOME + NVM_SYMLINK already present"
    }
    # In-process PATH for the bootstrap below.
    $env:PATH = "$nvmHome;$nvmSymlink;$env:PATH"

    Log-Section "write settings.txt — nvm-windows reads it to decide where Node versions install"
    # ASCII encoding mirrors the scoop manifest's pre_install writer.
    $settings = Join-Path $nvmHome "settings.txt"
    if (-not (Test-Path $settings)) {
        $content = "root: $nvmRoot`r`narch: 64`r`nproxy: none`r`n"
        [System.IO.File]::WriteAllText($settings, $content, [System.Text.Encoding]::ASCII)
        Log-Step "[settings.txt] written (root: $nvmRoot)"
    } else {
        Log-Skip "[settings.txt] already present"
    }

    Log-Section "create the nvm root dir — the NSIS installer normally does it, but we deploy by zip extract"
    # Without it `nvm install` aborts with "<root> could not be found or does not exist".
    if (-not (Test-Path $nvmRoot)) {
        New-Item -ItemType Directory -Force -Path $nvmRoot | Out-Null
        Log-Step "[root] created $nvmRoot"
    } else {
        Log-Skip "[root] already present"
    }

    Log-Section "bootstrap latest LTS Node — 'nvm use' needs a UAC prompt, so a non-interactive apply may stop half-way"
    # `nvm use` creates the active-version symlink via mklink, which triggers a UAC/
    # elevate prompt -- expected and interactive. Skipped entirely if a Node is active.
    #
    # CAVEAT: a NON-interactive `chezmoi apply` cannot answer that UAC prompt, so
    # `nvm use` may fail/hang and leave Node installed-but-not-activated (no symlink
    # -> node not on PATH). If so, finish in an interactive shell: `nvm use <version>`
    # and approve the UAC dialog. `nvm install` itself needs no elevation.
    if (Test-Path (Join-Path $nvmSymlink "node.exe")) {
        Log-Skip "[node] already active"
    } else {
        Log-Step "[node] installing latest LTS via nvm (will prompt for elevation on 'use')"
        & $nvmExe install lts
        & $nvmExe use lts
    }
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
