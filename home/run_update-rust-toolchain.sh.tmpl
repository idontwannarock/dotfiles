{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_ script — keep the Rust stable toolchain up to date
# 每次 chezmoi apply / update 都會跑（純 run_，非 run_once_/run_onchange_）。
# 安裝由 install-01-runtimes（官方 rustup installer）負責；本支只負責保持最新。

set -euo pipefail

{{ template "scripts/log.sh" }}

log_begin "Rust toolchain update"

log_section "load rustup into this session — PATH may not be wired yet"
[ -s "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

if ! command -v rustup &>/dev/null; then
    log_warn "[rust] rustup not found; skipping toolchain update"
    exit 0
fi

log_section "update the stable toolchain — best effort, an offline machine must not fail the whole apply"
if rustup update stable; then
    log_step "[rust] stable is up to date"
else
    log_warn "[rust] 'rustup update stable' failed (offline?); continuing"
fi
{{ end -}}
