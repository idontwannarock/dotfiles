{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_ script — keep the Rust stable toolchain up to date
# 每次 chezmoi apply / update 都會跑（純 run_，非 run_once_/run_onchange_）。
# 安裝由 wave10 migrate（官方 rustup-init）負責；本支只負責保持最新。

$ErrorActionPreference = "Continue"

{{ template "scripts/log.ps1" }}

Log-Begin "Rust toolchain update"
try {
    Log-Section "put ~/.cargo/bin on PATH for this session -- rustup-init ran with --no-modify-path"
    $cargoBin = Join-Path $env:USERPROFILE ".cargo\bin"
    if (Test-Path $cargoBin) { $env:PATH = "$cargoBin;$env:PATH" }

    if (-not (Get-Command rustup -ErrorAction SilentlyContinue)) {
        Log-Warn "[rust] rustup not found; skipping toolchain update"
        return
    }

    Log-Section "update the stable toolchain -- best effort, an offline machine must not fail the whole apply"
    # Captured, not streamed. rustup prints three lines on every run, and
    # "unchanged" is the normal case, so those three lines were pure noise on a
    # machine that had nothing to do. They are worth reading in exactly two
    # situations: the update failed, where they are the only diagnostic, and the
    # caller asked for detail with -v.
    $rustOut = & rustup update stable 2>&1
    if ($LASTEXITCODE -eq 0) {
        if (Test-LogVerbose) { $rustOut | ForEach-Object { "        $_" } }
        Log-Skip "[rust] stable is up to date"
    } else {
        $rustOut | ForEach-Object { "        $_" }
        Log-Warn "[rust] 'rustup update stable' failed (offline?); continuing"
    }
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
