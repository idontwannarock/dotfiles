{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — CLI 工具安裝（Unix/macOS/WSL）
# macOS: brew, Linux/WSL: apt
#
# pkg_install 的 apt/brew 分派在 render 期決定（見 scripts/pkg-install.sh），
# 所以部署下來的腳本只含本機真正會走的那一支。

set -euo pipefail

{{ template "scripts/log.sh" }}
{{ template "scripts/pkg-install.sh" . }}

log_begin "CLI tools"

{{- if eq .chezmoi.os "darwin" }}

log_section "check Homebrew is available -- every install below goes through it"
if ! command -v brew &>/dev/null; then
    log_warn "[cli-tools] Homebrew not found; skipping"
    exit 0
fi

log_section "install general-purpose CLI tools via brew"
pkg_install 7z p7zip
pkg_install curl
pkg_install wget
pkg_install tree
pkg_install ffmpeg
pkg_install hugo
pkg_install nexttrace
pkg_install yt-dlp
pkg_install golangci-lint

log_section "install the PostgreSQL client -- libpq is keg-only, so force-link to expose psql"
if command -v psql &>/dev/null; then
    log_skip "[psql] already installed"
else
    log_step "[libpq] installing PostgreSQL client via brew"
    brew install libpq
    brew link --force libpq
fi

{{- else }}

log_section "install general-purpose CLI tools via apt"
pkg_install 7z p7zip-full
pkg_install curl
pkg_install wget
pkg_install tree
pkg_install ffmpeg
pkg_install psql postgresql-client

log_section "install golangci-lint -- not in apt, so use the official installer into ~/.local/bin"
if command -v golangci-lint &>/dev/null; then
    log_skip "[golangci-lint] already installed"
else
    log_step "[golangci-lint] installing via official installer"
    mkdir -p "$HOME/.local/bin"
    curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh \
        | sh -s -- -b "$HOME/.local/bin" \
        || log_warn "[golangci-lint] install failed. See https://golangci-lint.run/welcome/install/"
fi

log_section "install hugo -- apt coverage varies by release, so fall back to a manual pointer"
if command -v hugo &>/dev/null; then
    log_skip "[hugo] already installed"
else
    log_step "[hugo] installing via apt"
    sudo apt-get install -y hugo 2>/dev/null || log_warn "[hugo] not available in apt. Install from https://gohugo.io/installation/"
fi

log_section "install nexttrace -- not packaged in apt, use the upstream script"
if command -v nexttrace &>/dev/null; then
    log_skip "[nexttrace] already installed"
else
    log_step "[nexttrace] installing via official script"
    curl -fsSL nxtrace.org/nt | bash 2>/dev/null || log_warn "[nexttrace] install manually: https://github.com/nxtrace/NTrace-core"
fi

log_section "install yt-dlp -- apt coverage varies, fall back to a pip pointer"
if command -v yt-dlp &>/dev/null; then
    log_skip "[yt-dlp] already installed"
else
    log_step "[yt-dlp] installing via apt"
    sudo apt-get install -y yt-dlp 2>/dev/null || log_warn "[yt-dlp] not in apt. Install via pip: pip install yt-dlp"
fi

{{- end }}

log_section "install twg (Atlassian Teamwork Graph CLI) -- replaces the Atlassian MCP; login stays manual"
# --skip-skills: the agent reads twg's bundled skills on demand via
#   `twg help discover-skills`, and 10 of the 13 installed skills route to
#   credit-consuming commands. -y records the terms consent unattended.
# Credit-consuming commands are removed by TWG_COMMAND_SURFACE_RESTRICTION
#   (shell-common/base), not here.
if [ -x "$HOME/.local/bin/twg" ]; then
    log_skip "[twg] already installed"
else
    log_step "[twg] installing via official installer"
    curl -fsSL --retry 2 https://teamwork-graph.atlassian.com/cli/install \
        | bash -s -- --skip-skills --skip-login -y \
        || log_warn "[twg] install failed. See https://developer.atlassian.com/cloud/twg-cli/"
    if [ -x "$HOME/.local/bin/twg" ]; then
        log_step "[twg] run 'twg login' once in a terminal to authenticate"
    fi
fi
{{ end -}}
