{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_ script — refresh Claude Code marketplaces + update enabled plugins
# 每次 chezmoi apply / update 都會跑（與 install-03 不同，那支只在內容變更時跑），
# 但開頭的探針會在沒有任何 marketplace 移動時直接結束。
# 依賴 install-03 已加好 marketplace 與安裝好 plugin

$ErrorActionPreference = "Continue"

{{ template "scripts/log.ps1" }}

Log-Begin "Claude Code plugin update"
$originalLocation = $null
try {
    # Workaround for anthropics/claude-code#50320 / #42135:
    # Node.js child_process.spawn rejects git.exe as "unsafe location" when cwd
    # is an ancestor of the git installation path. Switching to a drive root
    # avoids the heuristic. Restored in the finally block -- which is also why every
    # early exit below uses `return`, not `exit`: `exit` would skip the restore.
    # Kept inside the try so a failure here still reaches Log-End.
    $originalLocation = Get-Location
    Set-Location $env:SystemDrive\

    Log-Section "check claude CLI is available"
    if (-not (Get-Command "claude" -ErrorAction SilentlyContinue)) {
        Log-Warn "[claude-plugins] claude CLI not found; skipping update"
        return
    }

    # Cheap probe before the expensive part. `claude plugin marketplace update`
    # re-downloads every marketplace whether or not it moved — 28s here, and the
    # per-plugin loop that follows adds another 11s to report "already at the
    # latest version". One `git ls-remote` per marketplace answers the same
    # question in under a second, and names which marketplace moved so the work
    # below can be narrowed to it.
    #
    # The comparison baseline is our own state file, not the .gcs-sha marker
    # inside each marketplace: claude writes that marker as soon as the
    # marketplace itself lands, so a run that died in the per-plugin loop
    # afterwards would leave a marker claiming everything is current. The state
    # file is written only after this script completes, so an interrupted run
    # repeats next time.
    $stateFile = Join-Path $env:USERPROFILE ".cache\dotfiles\claude-marketplace-shas"
    $known = Join-Path $env:USERPROFILE ".claude\plugins\known_marketplaces.json"
    $probeOk = $true
    $remoteShas = @()
    $moved = @()

    function Save-ProbeState {
        if (-not $probeOk) { return }
        $dir = Split-Path $stateFile -Parent
        if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
        # WriteAllText, not Set-Content: PowerShell 5.1 would prepend a UTF-8 BOM
        # and the next run's string compare would never match.
        [System.IO.File]::WriteAllText($stateFile, ($remoteShas -join "`n"))
    }

    Log-Section "ask each marketplace remote for its head — skip the whole refresh when none moved"
    if ((-not (Test-Path $known)) -or (-not (Get-Command git -ErrorAction SilentlyContinue))) {
        Log-Warn "[probe] git or known_marketplaces.json missing; doing the full refresh"
        $probeOk = $false
    }

    $prevShas = @{}
    if (Test-Path $stateFile) {
        foreach ($line in (Get-Content $stateFile)) {
            $parts = $line -split ' ', 2
            if ($parts.Count -eq 2) { $prevShas[$parts[0]] = $parts[1] }
        }
    }

    if ($probeOk) {
        $entries = (Get-Content $known -Raw | ConvertFrom-Json).PSObject.Properties | Sort-Object Name
        foreach ($entry in $entries) {
            $name = $entry.Name
            $kind = $entry.Value.source.source
            if ($kind -ne 'github') {
                Log-Step "[$name] source type '$kind' has no cheap probe; doing the full refresh"
                $probeOk = $false
                break
            }
            $line = git ls-remote "https://github.com/$($entry.Value.source.repo)" HEAD 2>$null | Select-Object -First 1
            $sha = if ($line) { ($line -split "`t")[0] } else { "" }
            if (-not $sha) {
                Log-Warn "[$name] remote unreachable; leaving every plugin as it is"
                return
            }
            $remoteShas += "$name $sha"
            if ($prevShas[$name] -eq $sha) {
                Log-Skip "[$name] still at $sha"
            } else {
                Log-Step "[$name] moved to $sha"
                $moved += $name
            }
        }
    }

    if ($probeOk -and $moved.Count -eq 0) {
        Log-Skip "[probe] every marketplace already matches its remote; nothing to update"
        return
    }

    # Refresh and update only what moved. `claude plugin marketplace update`
    # takes an optional name, and every plugin is named plugin@marketplace, so
    # both halves can be narrowed to the marketplaces the probe flagged. A failed
    # probe cannot name anything, so it falls back to refreshing all of them.
    Log-Section "refresh the marketplaces that moved so their plugin version data is current"
    if ($probeOk) {
        foreach ($name in $moved) {
            Log-Step "[$name] refreshing"
            claude plugin marketplace update $name 2>&1 | ForEach-Object { "        $_" }
        }
    } else {
        Log-Step "[marketplaces] refreshing all — the probe could not tell which moved"
        claude plugin marketplace update 2>&1 | ForEach-Object { "        $_" }
    }

    Log-Section "read the enabled plugin list out of settings.json"
    $settings = Join-Path $env:USERPROFILE ".claude\settings.json"
    if (-not (Test-Path $settings)) {
        Log-Warn "[plugins] settings.json missing; skipping per-plugin update"
        Save-ProbeState
        return
    }

    try {
        $config = Get-Content $settings -Raw | ConvertFrom-Json
    } catch {
        Log-Warn "[plugins] failed to parse settings.json; skipping"
        Save-ProbeState
        return
    }

    $enabled = @()
    if ($config.PSObject.Properties.Name -contains 'enabledPlugins') {
        $enabled = $config.enabledPlugins.PSObject.Properties |
            Where-Object { $_.Value -eq $true } |
            ForEach-Object { $_.Name }
    }

    if ($enabled.Count -eq 0) {
        Log-Skip "[plugins] no enabled plugins found"
        Save-ProbeState
        return
    }

    Log-Section "update the plugins that belong to a refreshed marketplace — restart Claude Code afterwards to pick up new versions"
    foreach ($plugin in $enabled) {
        if ($probeOk -and ($moved -notcontains ($plugin -split '@')[-1])) {
            Log-Skip "[plugins] $plugin — its marketplace did not move"
            continue
        }
        Log-Step "[plugins] updating $plugin"
        claude plugin update $plugin 2>&1 | ForEach-Object { "        $_" }
    }

    Save-ProbeState
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    if ($originalLocation) { Set-Location $originalLocation }
    Log-End
}
{{ end -}}
