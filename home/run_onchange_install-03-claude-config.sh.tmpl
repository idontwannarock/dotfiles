{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_ script — Claude Code plugins + MCP 設定（Unix/macOS/WSL）
# 需要 claude CLI，由 install-02-npm-tools 安裝
# 腳本內容改變時自動重新執行

set -euo pipefail

{{ template "scripts/log.sh" }}
{{ template "scripts/load-nvm" }}

log_begin "Claude Code config"

log_section "check claude CLI is available — every step below drives it"
if ! command -v claude &>/dev/null; then
    log_warn "claude command not found; skipping Claude config setup"
    exit 0
fi

log_section "register the superpowers plugin marketplace"
log_step "[plugins] adding obra/superpowers-marketplace"
claude plugin marketplace add obra/superpowers-marketplace 2>&1 || true

log_section "install Claude Code plugins"
log_step "[plugins] installing slack"
claude plugin install slack 2>&1 || true

log_step "[plugins] installing episodic-memory"
claude plugin install episodic-memory@superpowers-marketplace 2>&1 || true

log_step "[plugins] installing elements-of-style"
claude plugin install elements-of-style@superpowers-marketplace 2>&1 || true

log_section "swap output style to explanatory — learning demands scaffolding, explanatory only adds insight notes"
INSTALLED_PLUGINS="$(claude plugin list 2>/dev/null || true)"
if ! echo "$INSTALLED_PLUGINS" | grep -q "explanatory-output-style@claude-plugins-official"; then
    log_step "[plugins] installing explanatory-output-style"
    claude plugin install explanatory-output-style@claude-plugins-official 2>&1 || true
else
    log_skip "[plugins] explanatory-output-style already installed"
fi
if echo "$INSTALLED_PLUGINS" | grep -q "learning-output-style@claude-plugins-official"; then
    log_step "[plugins] removing learning-output-style (superseded by explanatory)"
    claude plugin uninstall learning-output-style@claude-plugins-official 2>&1 || true
fi

# Retired plugins. Dropping the install line is NOT enough: machines that already
# applied it keep the plugin, and run_update-claude-plugins iterates enabledPlugins
# and keeps updating it every apply. Uninstall here so removal converges everywhere,
# not just on the machine where the decision was made.
#
# Adding a retirement = adding a row here. Reason text is user-facing.
# Keep this list identical to the PowerShell twin in the .ps1.tmpl.
RETIRED_PLUGINS="
superpowers@claude-plugins-official|workflow skills replaced by the in-house discipline skills in ~/.claude/skills/
claude-md-management@claude-plugins-official|unused
context7@claude-plugins-official|unused
code-simplifier@claude-plugins-official|unused; the same-named agent comes from exact_agents/code-review/, not this plugin
playwright@claude-plugins-official|unused
commit-commands@claude-plugins-official|unused
security-guidance@claude-plugins-official|unused
pr-review-toolkit@claude-plugins-official|unused; code-reviewer and friends come from exact_agents/
pyright-lsp@claude-plugins-official|unused
jdtls-lsp@claude-plugins-official|unused
claude-code-setup@claude-plugins-official|unused
"

log_section "uninstall retired plugins so their removal converges on every machine"
echo "$RETIRED_PLUGINS" | while IFS='|' read -r id reason; do
    [ -n "$id" ] || continue
    # Check first: uninstalling something absent writes to stderr, and 11 of those
    # every apply would bury the real output.
    if echo "$INSTALLED_PLUGINS" | grep -qF "$id"; then
        log_step "[plugins] removing ${id} — ${reason}"
        claude plugin uninstall "$id" 2>&1 || true
    else
        log_skip "[plugins] ${id} not installed"
    fi
done

log_section "install jdtls — the Java LSP; pinned tarball here, scoop rolling release on Windows"
JDTLS_DIR="$HOME/.local/share/jdtls"
if ! command -v jdtls &>/dev/null && [ ! -f "$JDTLS_DIR/bin/jdtls" ]; then
    JDTLS_VERSION="1.58.0-202602271700"
    JDTLS_URL="https://download.eclipse.org/jdtls/snapshots/jdt-language-server-${JDTLS_VERSION}.tar.gz"
    log_step "[jdtls] downloading ${JDTLS_VERSION}"
    mkdir -p "$JDTLS_DIR"
    if command -v curl &>/dev/null; then
        curl -fsSL "$JDTLS_URL" | tar xz -C "$JDTLS_DIR"
    elif command -v wget &>/dev/null; then
        wget -qO- "$JDTLS_URL" | tar xz -C "$JDTLS_DIR"
    else
        log_warn "[jdtls] neither curl nor wget found; cannot download"
    fi
else
    log_skip "[jdtls] already installed"
fi

log_section "drop the stale caches the retired plugins leave behind"
PLUGIN_CACHE="$HOME/.claude/plugins/cache"
# Unconditional, NOT gated on "did we just uninstall": uninstall clears
# installed_plugins.json + enabledPlugins but leaves the cache dir. A machine where
# the plugin was removed by hand still has the cache to clean.
#
# rm -rf exits 0 on a missing path, so guard on existence -- otherwise the
# message prints on every apply and the output stops meaning anything.
echo "$RETIRED_PLUGINS" | while IFS='|' read -r id _reason; do
    [ -n "$id" ] || continue
    plugin_id="${id%@*}"
    marketplace="${id#*@}"
    if [ -d "$PLUGIN_CACHE/$marketplace/$plugin_id" ]; then
        rm -rf "$PLUGIN_CACHE/$marketplace/$plugin_id"
        log_step "[cleanup] removed ${marketplace}/${plugin_id} cache"
    fi
done
# Defensive, and not derivable from the table above: superpowers once shipped from
# superpowers-marketplace, so its cache can sit under that marketplace too.
if [ -d "$PLUGIN_CACHE/superpowers-marketplace/superpowers" ]; then
    rm -rf "$PLUGIN_CACHE/superpowers-marketplace/superpowers"
    log_step "[cleanup] removed marketplace superpowers cache"
fi

log_section "repair episodic-memory deps — its lockfile hides onnxruntime-common from a bare import"
# The published episodic-memory lockfile nests onnxruntime-common only under
# onnxruntime-node/-web, but @huggingface/transformers does a bare
# `import 'onnxruntime-common'` that needs it at the package root -> its
# SessionStart sync hook dies with ERR_MODULE_NOT_FOUND. Reinstalling reproduces
# the broken layout (it's baked into the lockfile), so surface a top-level copy
# from the already-present, version-matched nested one. Offline + idempotent;
# loops version dirs so it self-heals across plugin upgrades.
em_base="$PLUGIN_CACHE/superpowers-marketplace/episodic-memory"
if [ -d "$em_base" ]; then
    for ver_dir in "$em_base"/*/; do
        [ -d "$ver_dir" ] || continue
        nm="${ver_dir%/}/node_modules"
        top="$nm/onnxruntime-common"
        [ -e "$top" ] && continue
        for nested in \
            "$nm/onnxruntime-node/node_modules/onnxruntime-common" \
            "$nm/onnxruntime-web/node_modules/onnxruntime-common"; do
            if [ -d "$nested" ]; then
                cp -R "$nested" "$top"
                log_step "[deps] repaired onnxruntime-common for $(basename "${ver_dir%/}")"
                break
            fi
        done
    done
else
    log_skip "[deps] episodic-memory not present; nothing to repair"
fi

log_section "register user-scope MCP servers"
mcp_add_if_missing() {
    local name="$1"; shift
    if claude mcp list 2>/dev/null | grep -q "^${name}:"; then
        log_skip "[mcp] ${name} already registered"
    else
        claude mcp add --scope user "$name" -- "$@" && log_step "[mcp] ${name} registered"
    fi
}

if command -v codegraph &>/dev/null; then
    mcp_add_if_missing "codegraph" codegraph "serve" "--mcp"
else
    log_skip "[mcp] codegraph binary not found"
fi

log_section "set user preferences in ~/.claude.json"
CLAUDE_JSON="$HOME/.claude.json"
if [ -f "$CLAUDE_JSON" ] && command -v jq &>/dev/null; then
    if [ "$(jq -r '.copyOnSelect // "unset"' "$CLAUDE_JSON")" != "false" ]; then
        tmp=$(mktemp)
        jq '.copyOnSelect = false' "$CLAUDE_JSON" > "$tmp" && mv "$tmp" "$CLAUDE_JSON"
        log_step "[config] set copyOnSelect=false"
    else
        log_skip "[config] copyOnSelect already false"
    fi
else
    log_skip "[config] ~/.claude.json or jq missing"
fi

log_step "restart Claude Code to activate the changes above"
{{ end -}}
