{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_ script — Claude Code plugins + MCP 設定（Unix/macOS/WSL）
# 需要 claude CLI，由 install-02-npm-tools 安裝
# 腳本內容改變時自動重新執行

set -euo pipefail

{{ template "scripts/load-nvm" }}

echo "=== Claude Code Config Setup ==="

if ! command -v claude &>/dev/null; then
    echo "WARNING: claude command not found. Skipping Claude config setup." >&2
    exit 0
fi

# ── Plugins ──────────────────────────────────────────────────────────────

echo "[plugins] Adding superpowers marketplace..."
claude plugin marketplace add obra/superpowers-marketplace 2>&1 || true

echo "[plugins] Installing slack..."
claude plugin install slack 2>&1 || true

echo "[plugins] Installing episodic-memory..."
claude plugin install episodic-memory@superpowers-marketplace 2>&1 || true

echo "[plugins] Installing elements-of-style..."
claude plugin install elements-of-style@superpowers-marketplace 2>&1 || true

# ── Output style plugin: explanatory (insight-only, replaces learning) ──
# Learning 會要求 scaffold + 留 5-10 行給使用者寫；explanatory 只留 ★ Insight 解說。
INSTALLED_PLUGINS="$(claude plugin list 2>/dev/null || true)"
if ! echo "$INSTALLED_PLUGINS" | grep -q "explanatory-output-style@claude-plugins-official"; then
    echo "[plugins] Installing explanatory-output-style..."
    claude plugin install explanatory-output-style@claude-plugins-official 2>&1 || true
fi
if echo "$INSTALLED_PLUGINS" | grep -q "learning-output-style@claude-plugins-official"; then
    echo "[plugins] Removing learning-output-style (superseded by explanatory)..."
    claude plugin uninstall learning-output-style@claude-plugins-official 2>&1 || true
fi

# ── Retired plugin: superpowers ─────────────────────────────────────────
# Workflow skills replaced by the in-house discipline skills in ~/.claude/skills/.
# remove-superpowers-plugin only dropped the install line, so machines that had
# already applied it kept the plugin -- and run_update-claude-plugins, which
# iterates enabledPlugins, kept updating it on every apply. Uninstall here so
# the removal converges on every machine, not just the one where it was run
# by hand.
if echo "$INSTALLED_PLUGINS" | grep -q "superpowers@claude-plugins-official"; then
    echo "[plugins] Removing superpowers (retired, replaced by in-house discipline skills)..."
    claude plugin uninstall superpowers@claude-plugins-official 2>&1 || true
fi

# ── jdtls（Java LSP 依賴）───────────────────────────────────────────────
# ⚠ 版本同步：Windows 版用 scoop rolling release，這裡用 pinned tarball
echo "[jdtls] Checking..."
JDTLS_DIR="$HOME/.local/share/jdtls"
if ! command -v jdtls &>/dev/null && [ ! -f "$JDTLS_DIR/bin/jdtls" ]; then
    JDTLS_VERSION="1.58.0-202602271700"
    JDTLS_URL="https://download.eclipse.org/jdtls/snapshots/jdt-language-server-${JDTLS_VERSION}.tar.gz"
    echo "[jdtls] Downloading ${JDTLS_VERSION}..."
    mkdir -p "$JDTLS_DIR"
    if command -v curl &>/dev/null; then
        curl -fsSL "$JDTLS_URL" | tar xz -C "$JDTLS_DIR"
    elif command -v wget &>/dev/null; then
        wget -qO- "$JDTLS_URL" | tar xz -C "$JDTLS_DIR"
    else
        echo "[jdtls] WARNING: curl/wget not found." >&2
    fi
else
    echo "[jdtls] already installed, skipping."
fi

# ── Plugin cache cleanup ─────────────────────────────────────────────────
echo "[cleanup] Removing stale plugin caches..."
PLUGIN_CACHE="$HOME/.claude/plugins/cache"
rm -rf "$PLUGIN_CACHE/superpowers-marketplace/superpowers" 2>/dev/null && echo "  Removed marketplace superpowers" || true
# uninstall clears installed_plugins.json + enabledPlugins but leaves the cache behind
if [ -d "$PLUGIN_CACHE/claude-plugins-official/superpowers" ]; then
    rm -rf "$PLUGIN_CACHE/claude-plugins-official/superpowers"
    echo "  Removed official superpowers cache"
fi

# ── episodic-memory dep repair (onnxruntime-common hoist) ────────────────
# The published episodic-memory lockfile nests onnxruntime-common only under
# onnxruntime-node/-web, but @huggingface/transformers does a bare
# `import 'onnxruntime-common'` that needs it at the package root -> its
# SessionStart sync hook dies with ERR_MODULE_NOT_FOUND. Reinstalling reproduces
# the broken layout (it's baked into the lockfile), so surface a top-level copy
# from the already-present, version-matched nested one. Offline + idempotent;
# loops version dirs so it self-heals across plugin upgrades.
em_base="$PLUGIN_CACHE/superpowers-marketplace/episodic-memory"
if [ -d "$em_base" ]; then
    for ver_dir in "$em_base"/*/; do
        [ -d "$ver_dir" ] || continue
        nm="${ver_dir%/}/node_modules"
        top="$nm/onnxruntime-common"
        [ -e "$top" ] && continue
        for nested in \
            "$nm/onnxruntime-node/node_modules/onnxruntime-common" \
            "$nm/onnxruntime-web/node_modules/onnxruntime-common"; do
            if [ -d "$nested" ]; then
                cp -R "$nested" "$top"
                echo "  Repaired episodic-memory deps (onnxruntime-common): $(basename "${ver_dir%/}")"
                break
            fi
        done
    done
fi

# ── MCP Servers ──────────────────────────────────────────────────────────
echo "[mcp] Setting up MCP servers..."

mcp_add_if_missing() {
    local name="$1"; shift
    if claude mcp list 2>/dev/null | grep -q "^${name}:"; then
        echo "[mcp] ${name} already registered, skipping."
    else
        claude mcp add --scope user "$name" -- "$@" && echo "[mcp] ${name} registered."
    fi
}

if command -v codegraph &>/dev/null; then
    mcp_add_if_missing "codegraph" codegraph "serve" "--mcp"
else
    echo "[mcp] codegraph not found, skipping."
fi

# ── User-level preferences in ~/.claude.json ────────────────────────────
CLAUDE_JSON="$HOME/.claude.json"
if [ -f "$CLAUDE_JSON" ] && command -v jq &>/dev/null; then
    if [ "$(jq -r '.copyOnSelect // "unset"' "$CLAUDE_JSON")" != "false" ]; then
        tmp=$(mktemp)
        jq '.copyOnSelect = false' "$CLAUDE_JSON" > "$tmp" && mv "$tmp" "$CLAUDE_JSON"
        echo "[config] Set copyOnSelect=false in ~/.claude.json"
    fi
fi

echo "=== Claude config setup complete. Restart Claude Code to activate. ==="
{{ end -}}
