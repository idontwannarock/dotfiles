{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_ script — Claude Code plugins + MCP 設定（Unix/macOS/WSL）
# 需要 claude CLI，由 install-02-npm-tools 安裝
# 腳本內容改變時自動重新執行

set -euo pipefail

{{ template "scripts/log.sh" }}
{{ template "scripts/load-nvm" }}

log_begin "Claude Code config"

log_section "check claude CLI is available — every step below drives it"
if ! command -v claude &>/dev/null; then
    log_warn "claude command not found; skipping Claude config setup"
    exit 0
fi

log_section "install Claude Code plugins"
log_step "[plugins] installing slack"
claude plugin install slack 2>&1 || true

INSTALLED_PLUGINS="$(claude plugin list 2>/dev/null || true)"

# Retired plugins. Dropping the install line is NOT enough: machines that already
# applied it keep the plugin, and run_update-claude-plugins iterates enabledPlugins
# and keeps updating it every apply. Uninstall here so removal converges everywhere,
# not just on the machine where the decision was made.
#
# Adding a retirement = adding a row here. Reason text is user-facing.
# Keep this list identical to the PowerShell twin in the .ps1.tmpl.
#
# Quoted heredoc, not a double-quoted string: a reason that quotes something --
# explanatory-output-style quotes the text its hook injects -- closed the string
# early and the rest of the row ran as commands. The script died there with
# rc=127, so every step below it (uninstall, cache cleanup, MCP registration)
# silently stopped running. <<'EOF' disables expansion outright.
RETIRED_PLUGINS="$(cat <<'RETIRED_EOF'
superpowers@claude-plugins-official|workflow skills replaced by the in-house discipline skills in ~/.claude/skills/
claude-md-management@claude-plugins-official|unused
context7@claude-plugins-official|unused
code-simplifier@claude-plugins-official|unused; a same-named agent once lived in exact_agents/, retired with the review lenses -- unrelated to this plugin either way
playwright@claude-plugins-official|unused
commit-commands@claude-plugins-official|unused
security-guidance@claude-plugins-official|unused
pr-review-toolkit@claude-plugins-official|unused; review lives in the repo's own code:review-* commands
pyright-lsp@claude-plugins-official|unused
jdtls-lsp@claude-plugins-official|unused
claude-code-setup@claude-plugins-official|unused
learning-output-style@claude-plugins-official|output styles are served by ~/.claude/output-styles/ELI5.md; the plugin variants only fight it
explanatory-output-style@claude-plugins-official|its SessionStart hook injects 'you may exceed typical length constraints', which contradicts the ELI5 output style
code-review@claude-plugins-official|its only surface is /code-review, duplicated by the repo's own code:review-* commands
elements-of-style@superpowers-marketplace|its rules are rhetorical (Strunk) and aimed at prose someone reads for pleasure; commit messages, MR descriptions, docs and work chat are read for instruction, so CLAUDE.md/AGENTS.md section 5 now names the ASD-STE100 principles instead
episodic-memory@superpowers-marketplace|27 recorded calls in 508 transcripts (20 search, 7 read, 1 subagent) against 2.3 GB on disk (1.1 GB plugin cache plus 1.2 GB of archive and index under ~/.config/superpowers) and a bespoke onnxruntime patch; keyword search over the raw jsonl in ~/.claude/projects/ covers what remains
RETIRED_EOF
)"

log_section "uninstall retired plugins so their removal converges on every machine"
echo "$RETIRED_PLUGINS" | while IFS='|' read -r id reason; do
    [ -n "$id" ] || continue
    # Check first: uninstalling something absent writes to stderr, and 11 of those
    # every apply would bury the real output.
    if echo "$INSTALLED_PLUGINS" | grep -qF "$id"; then
        log_step "[plugins] removing ${id} — ${reason}"
        claude plugin uninstall "$id" 2>&1 || true
    else
        log_skip "[plugins] ${id} not installed"
    fi
done

log_section "install jdtls — the Java LSP; pinned tarball here, scoop rolling release on Windows"
JDTLS_DIR="$HOME/.local/share/jdtls"
if ! command -v jdtls &>/dev/null && [ ! -f "$JDTLS_DIR/bin/jdtls" ]; then
    JDTLS_VERSION="1.58.0-202602271700"
    JDTLS_URL="https://download.eclipse.org/jdtls/snapshots/jdt-language-server-${JDTLS_VERSION}.tar.gz"
    log_step "[jdtls] downloading ${JDTLS_VERSION}"
    mkdir -p "$JDTLS_DIR"
    if command -v curl &>/dev/null; then
        curl -fsSL "$JDTLS_URL" | tar xz -C "$JDTLS_DIR"
    elif command -v wget &>/dev/null; then
        wget -qO- "$JDTLS_URL" | tar xz -C "$JDTLS_DIR"
    else
        log_warn "[jdtls] neither curl nor wget found; cannot download"
    fi
else
    log_skip "[jdtls] already installed"
fi

log_section "drop the stale caches the retired plugins leave behind"
PLUGIN_CACHE="$HOME/.claude/plugins/cache"
# Unconditional, NOT gated on "did we just uninstall": uninstall clears
# installed_plugins.json + enabledPlugins but leaves the cache dir. A machine where
# the plugin was removed by hand still has the cache to clean.
#
# rm -rf exits 0 on a missing path, so guard on existence -- otherwise the
# message prints on every apply and the output stops meaning anything.
echo "$RETIRED_PLUGINS" | while IFS='|' read -r id _reason; do
    [ -n "$id" ] || continue
    plugin_id="${id%@*}"
    marketplace="${id#*@}"
    if [ -d "$PLUGIN_CACHE/$marketplace/$plugin_id" ]; then
        rm -rf "$PLUGIN_CACHE/$marketplace/$plugin_id"
        log_step "[cleanup] removed ${marketplace}/${plugin_id} cache"
    fi
done
# superpowers-marketplace has no consumers left: superpowers, episodic-memory and
# elements-of-style are all retired. Drop the whole marketplace, not just the
# three plugin dirs -- a registered marketplace with nothing installed still
# gets refreshed on every plugin operation. Remove the cache first: the
# marketplace command does not prune it.
if [ -d "$PLUGIN_CACHE/superpowers-marketplace" ]; then
    rm -rf "$PLUGIN_CACHE/superpowers-marketplace"
    log_step "[cleanup] removed superpowers-marketplace cache"
fi
if claude plugin marketplace list 2>/dev/null | grep -q "superpowers-marketplace"; then
    log_step "[plugins] removing marketplace superpowers-marketplace — no plugin uses it"
    claude plugin marketplace remove superpowers-marketplace 2>&1 || true
else
    log_skip "[plugins] superpowers-marketplace not registered"
fi

log_section "register user-scope MCP servers — a stdio server costs one process per session"
# The cost of user scope is per session, not per machine, so a stdio server
# earns the scope only if every session genuinely uses it. An http server
# spawns nothing locally and is close to free. Everything still out of scope
# (chrome-devtools, agent-browser, codex) is installed by install-02 but left
# unregistered: each repo opts in with `claude mcp add --scope project`.
# See docs/claude-code.md.
#
# $1 is the server name; everything after is handed to `claude mcp add`
# verbatim, so a row can carry `--transport http` ahead of a url or `--` ahead
# of a command.
mcp_add_if_missing() {
    local name="$1"; shift
    if claude mcp list 2>/dev/null | grep -q "^${name}:"; then
        log_skip "[mcp] ${name} already registered"
    else
        claude mcp add --scope user "$name" "$@" && log_step "[mcp] ${name} registered"
    fi
}

# Retired MCP servers. Same convergence rule as the retired plugins above:
# dropping the add line leaves the entry in ~/.claude.json on every machine that
# already applied, and a stdio server keeps costing a process per session there.
#
# Adding a retirement = adding a row here.
# Keep this list identical to the PowerShell twin in the .ps1.tmpl.
RETIRED_MCP="
codegraph|2 calls across the whole transcript history, one of them a status probe; its 9 tool schemas loaded every session regardless
"
echo "$RETIRED_MCP" | while IFS='|' read -r name reason; do
    [ -n "$name" ] || continue
    if claude mcp list 2>/dev/null | grep -q "^${name}:"; then
        log_step "[mcp] unregistering ${name} — ${reason}"
        claude mcp remove --scope user "$name" >/dev/null 2>&1 || true
    else
        log_skip "[mcp] ${name} not registered"
    fi
done

# http transport: no binary to guard on, and no per-session process. The script
# registers it but cannot log in — run /mcp and pick atlassian to finish the
# OAuth flow on a new machine.
#
# /v2/mcp replaces /v1/mcp/authv2. It swaps 40 flat tools for ~10 plus a
# discover/execute layer over 243 operations, and reaches Bitbucket, Loom,
# Talent, Goals and Projects. It drops Compass. The guard above matches on
# name only, so a machine already holding the old url keeps it — see
# docs/claude-code.md for the one-line migration.
mcp_add_if_missing "atlassian" --transport http "https://mcp.atlassian.com/v2/mcp"

log_section "set user preferences in ~/.claude.json"
CLAUDE_JSON="$HOME/.claude.json"
if [ -f "$CLAUDE_JSON" ] && command -v jq &>/dev/null; then
    if [ "$(jq -r '.copyOnSelect // "unset"' "$CLAUDE_JSON")" != "false" ]; then
        tmp=$(mktemp)
        jq '.copyOnSelect = false' "$CLAUDE_JSON" > "$tmp" && mv "$tmp" "$CLAUDE_JSON"
        log_step "[config] set copyOnSelect=false"
    else
        log_skip "[config] copyOnSelect already false"
    fi
else
    log_skip "[config] ~/.claude.json or jq missing"
fi

log_step "restart Claude Code to activate the changes above"
{{ end -}}
