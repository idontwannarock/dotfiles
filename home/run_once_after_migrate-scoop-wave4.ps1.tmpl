{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_after_ script -- Wave 4 Scoop cleanup
#
# Uninstall scoop packages that dotfiles no longer manages on Windows:
#   - clink   : never wired into dotfiles; starship covers prompt enhancement
#   - winget  : redundant with OS-bundled %LOCALAPPDATA%\Microsoft\WindowsApps
#   - winget-ps (Microsoft.WinGet.Client module): not imported by any dotfiles
#               script; 99-command-not-found.ps1 uses the separate PowerToys
#               Microsoft.WinGet.CommandNotFound module.
#
# Soft-unmanaged tools (intentionally NOT uninstalled here):
#   - dark, vimtutor : dotfiles stops installing them on fresh machines, but
#     any existing scoop install is preserved.
#
# Wave 1 already handled User PATH ordering (`~/.local/bin` before
# `~/scoop/shims`), so this script does NOT touch PATH.
#
# Idempotent: skips uninstall if scoop is unaware of the package.

$ErrorActionPreference = "Continue"
$pkgs = @("clink", "winget", "winget-ps")

Write-Host "=== Wave 4: Scoop cleanup ===" -ForegroundColor Cyan

if (-not (Get-Command "scoop" -ErrorAction SilentlyContinue)) {
    Write-Host "scoop not found, skipping uninstall phase." -ForegroundColor Gray
    Write-Host "=== Migration complete. ===" -ForegroundColor Cyan
    return
}

foreach ($pkg in $pkgs) {
    $installed = $false
    try {
        $listOutput = scoop list $pkg 2>$null | Out-String
        $pattern = "(?im)^\s*$([regex]::Escape($pkg))\b"
        if ($listOutput -match $pattern) { $installed = $true }
    } catch {}
    if ($installed) {
        Write-Host "[$pkg] uninstalling from scoop..." -ForegroundColor Yellow
        scoop uninstall $pkg 2>&1 | Out-Null
        if ($LASTEXITCODE -ne 0) {
            Write-Warning "[$pkg] scoop uninstall returned non-zero exit; continuing."
        }
    } else {
        Write-Host "[$pkg] not installed via scoop, skipping." -ForegroundColor Gray
    }
}

Write-Host "=== Migration complete. ===" -ForegroundColor Cyan
{{ end -}}
