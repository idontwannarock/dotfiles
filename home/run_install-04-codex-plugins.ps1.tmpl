{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_ script — install Codex plugins (Windows 對應 install-04-codex-plugins.sh)
# Codex 內建 `openai-curated` marketplace；superpowers 發佈在該 marketplace。
#
# 用 run_（每次 apply 重跑）而非 run_onchange_：守衛 idempotent，已裝則跳過、成本極低。
# 若某次 apply 時 codex 還沒上 PATH 而走了 no-op，run_onchange_ 會記下內容 hash、之後
# 即使環境修好也不再重試（會卡住）；run_ 每次重新檢查、缺則補（與 install-02-npm-tools 同理）。

$ErrorActionPreference = "Continue"

if (-not (Get-Command "codex" -ErrorAction SilentlyContinue)) {
    Write-Host "[codex-plugins] codex CLI not found, skipping." -ForegroundColor Yellow
    exit 0
}

# Codex dropped the `plugin` subcommand in newer releases (0.116+ only ships
# exec/review/mcp/apply/...), so `codex plugin add` errors "unrecognized subcommand"
# on every apply. Detect support by whether `codex --help` lists `plugin` as a
# command (--help always exits 0, and a bare `codex plugin` falls through to the
# interactive prompt, so neither exit code is a usable signal). Skip cleanly when
# absent; kept (not deleted) so it self-heals if Codex reintroduces plugin support.
if (((& codex --help 2>&1) -join "`n") -notmatch '(?m)^\s+plugin\b') {
    Write-Host "[codex-plugins] codex build has no 'plugin' subcommand, skipping." -ForegroundColor Yellow
    exit 0
}

Write-Host "=== Codex Plugins Setup ===" -ForegroundColor Cyan

# superpowers: planning / TDD / debugging / review skills — 跨工具的 dev-workflow skill
# 以名稱引用這些（brainstorming, writing-plans, verification-before-completion,
# finishing-a-development-branch, using-git-worktrees）。
#
# 守衛刻意用 '\s+installed'（plugin 名稱後緊接 installed），而非 sh 版的
# '.*installed'：Windows 的 `codex plugin list` 在未安裝時顯示「not installed」，
# 用 .* 會把「not installed」也比中而誤判成已安裝、永遠跳過安裝。
$installed = codex plugin list 2>$null |
    Select-String -Pattern '^\s*superpowers@openai-curated\s+installed\b'
if ($installed) {
    Write-Host "[plugins] superpowers already installed." -ForegroundColor Gray
} else {
    Write-Host "[plugins] Installing superpowers..." -ForegroundColor Yellow
    codex plugin add superpowers@openai-curated 2>&1 | ForEach-Object { "  $_" }
}

Write-Host "=== Codex plugins setup complete. Restart Codex to activate. ===" -ForegroundColor Cyan
{{ end -}}
