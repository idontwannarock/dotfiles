{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_ script — 字型安裝（Windows）

Write-Host "=== Font Setup ===" -ForegroundColor Cyan

# This script no longer installs anything -- both fonts moved off scoop in Wave 12b.
# Kept as a historical record.

# ── Nerd Fonts (CaskaydiaCove Mono + JetBrains Mono) ────────────────────────
# cascadiacode-nf-mono and jetbrains-mono moved to .chezmoiexternal.toml in Wave
# 12b (2026-06-18): the externals fetch the upstream zips and
# run_once_register-fonts.ps1.tmpl replicates scoop's per-user install (copy .ttf
# to %LOCALAPPDATA%\Microsoft\Windows\Fonts + AppContainer ACL + HKCU register).
# Soft unmanage -- existing scoop installs are left untouched (no scoop uninstall):
# scoop's font install COPIES the .ttf, so its uninstaller would delete the real
# installed fonts. Matches the clink/dark/vimtutor precedent.

Write-Host "=== Font setup complete (nothing to install). ===" -ForegroundColor Cyan
{{ end -}}
