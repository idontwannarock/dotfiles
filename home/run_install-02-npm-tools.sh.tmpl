{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_ script — npm 全域工具安裝（Unix/macOS/WSL）
# 需要 nvm/npm，由 install-01-runtimes 安裝
#
# 用 run_（每次 apply 都重跑），而非 run_once_：Node runtime 一旦被換掉（nvm 換版
# 等）會換成空的 global node_modules，舊 Node 底下的 npm 全域套件就全部失效。每次
# apply 重新檢查、缺什麼補什麼即可自動補回；每個安裝都有 command -v idempotent
# 守衛，已安裝者直接略過，重跑成本極低。

set -euo pipefail

{{ template "scripts/log.sh" }}
{{ template "scripts/npm-install.sh" }}
{{ template "scripts/load-nvm" }}

log_begin "npm global tools"

log_section "check npm is available -- every install below needs it"
if ! command -v npm &>/dev/null; then
    log_warn "[npm-tools] npm not found; skipping all npm installs"
    exit 0
fi

# Retired npm tools. Dropping the install line is NOT enough: machines that
# already applied keep the package forever. Uninstall here so removal converges
# everywhere, not just on the machine where the decision was made.
#
# Guard on `npm ls`, not `command -v`: under WSL the Windows-side npm prefix is
# on PATH, so `command -v` finds the Windows copy and would skip the Linux one.
log_section "uninstall retired npm tools so removal converges on every machine"
if npm ls -g --depth=0 @colbymchenry/codegraph &>/dev/null; then
    log_step "[npm-tools] removing codegraph -- 2 calls across the whole transcript history, one of them a status probe; its 9 tool schemas loaded every session regardless"
    npm uninstall -g @colbymchenry/codegraph 2>&1 || true
else
    log_skip "[npm-tools] codegraph not installed"
fi

log_section "install Claude Code CLI"
npm_install claude @anthropic-ai/claude-code

log_section "install Codex CLI"
npm_install codex @openai/codex

# The app-server daemon keeps its own copy of Codex and, by default, updates it
# hourly. npm never updates the CLI on its own, so the CLI falls behind and the
# daemon refuses it ("Background server has incompatible feature settings").
# Fix: chezmoi owns the version. Upgrade the CLI here, turn the daemon updater
# off, and pin the daemon to the CLI package. rc and the mobile app need the
# daemon, so turning the daemon itself off is not an option.
log_section "upgrade Codex CLI -- the daemon gets pinned to this package below"
codex_current=$(codex --version 2>/dev/null | awk '{print $2}')
codex_latest=$(npm view @openai/codex version 2>/dev/null || true)
if [[ -z "$codex_latest" ]]; then
    log_warn "[codex] npm registry unreachable; keeping $codex_current"
elif [[ "$codex_current" == "$codex_latest" ]]; then
    log_skip "[codex] already at $codex_latest"
else
    log_step "[codex] upgrading $codex_current -> $codex_latest"
    npm install -g "@openai/codex@$codex_latest"
fi

log_section "turn off the daemon updater -- otherwise the daemon moves ahead of the CLI within an hour"
codex_home="${CODEX_HOME:-$HOME/.codex}"
daemon_settings="$codex_home/app-server-daemon/settings.json"
daemon_settings_changed=false
if [[ "$(jq -r '.updater.autoUpdateEnabled' "$daemon_settings" 2>/dev/null)" == "false" ]]; then
    log_skip "[codex] daemon updater already off"
else
    log_step "[codex] setting updater.autoUpdateEnabled=false in $daemon_settings"
    mkdir -p "$(dirname "$daemon_settings")"
    { cat "$daemon_settings" 2>/dev/null || echo '{}'; } \
        | jq '.updater.autoUpdateEnabled = false' > "$daemon_settings.tmp"
    mv "$daemon_settings.tmp" "$daemon_settings"
    daemon_settings_changed=true
fi

# Also pin when the settings just changed: a running updater only reads the
# new setting after a daemon restart, and the pin restarts the daemon.
log_section "pin the daemon to the CLI package -- a running daemon restarts"
daemon_codex="$codex_home/packages/app-server-daemon/current/bin/codex"
codex_current=$(codex --version 2>/dev/null | awk '{print $2}')
if [[ ! -x "$daemon_codex" ]]; then
    log_skip "[codex] no daemon package yet; the first daemon start copies the CLI package"
else
    daemon_version=$("$daemon_codex" --version 2>/dev/null | awk '{print $2}')
    if [[ "$daemon_version" == "$codex_current" && "$daemon_settings_changed" == false ]]; then
        log_skip "[codex] daemon already at $codex_current"
    else
        log_step "[codex] pinning daemon ${daemon_version:-unknown} -> CLI $codex_current"
        if ! pin_out=$(codex app-server daemon update --from-cli --yes 2>&1); then
            log_warn "[codex] daemon pin failed: $pin_out"
        fi
    fi
fi

# The two browser MCP servers are INSTALLED here but deliberately NOT
# registered by install-03: user scope would spawn them in every session,
# including the many that never touch a browser. A repo that needs one opts
# in with `claude mcp add --scope project`. Installing globally rather than
# leaving it to `npx -y <pkg>@latest` still matters -- npx adds an `npm exec`
# wrapper plus a `sh -c` layer, 3 processes where a binary costs 1.
log_section "install chrome-devtools-mcp -- available for repos that opt in, not registered globally"
npm_install chrome-devtools-mcp chrome-devtools-mcp

log_section "install agent-browser-mcp -- same deal as chrome-devtools-mcp"
npm_install agent-browser-mcp agent-browser-mcp

log_section "install OpenSpec CLI -- spec/change tracking used by dev-workflow"
if command -v openspec &>/dev/null; then
    log_skip "[openspec] already installed"
else
    log_step "[openspec] installing @fission-ai/openspec"
    npm install -g @fission-ai/openspec
    # 只產生 SKILL.md，不產生 slash commands（透過 skill description 自動觸發，
    # 省 session-start context，並與全域 dev-workflow skill 整合）
    log_step "[openspec] setting delivery=skills (no slash commands)"
    openspec config set delivery skills
fi
{{ end -}}
