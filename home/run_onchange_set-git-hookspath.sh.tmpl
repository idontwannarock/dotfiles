{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_ — point git at the global hooks dispatcher so local-files
# restore (and repo-local hook chaining) applies to every repo. Idempotent;
# never clobbers an existing non-target value.
set -eu

{{ template "scripts/log.sh" }}

log_begin "global git hooksPath"

log_section "point core.hooksPath at the dispatcher so local-files restore covers every repo"
target="{{ .chezmoi.homeDir }}/.config/git/hooks"
current=$(git config --global --get core.hooksPath || true)

if [ "$current" = "$target" ]; then
    log_skip "[git] core.hooksPath already points at the dispatcher"
    exit 0
elif [ -n "$current" ]; then
    log_warn "[git] core.hooksPath is '$current', not '$target'; leaving as-is"
    log_warn "[git] to enable global local-files restore, set it to '$target' manually"
    exit 0
fi

log_step "[git] setting global core.hooksPath -> $target"
git config --global core.hooksPath "$target"
{{ end -}}
