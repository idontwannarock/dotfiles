{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_after_ script -- Codex MCP servers (Windows)
# Runs after run_after_modify-codex-config and requires codex from install-02-npm-tools.

$ErrorActionPreference = "Stop"

Write-Host "=== Codex MCP Setup ===" -ForegroundColor Cyan

if (-not (Get-Command "codex" -ErrorAction SilentlyContinue)) {
    Write-Host "[codex-mcp] codex not found, skipping." -ForegroundColor Yellow
    exit 0
}

codex mcp get slack *> $null
if ($LASTEXITCODE -eq 0) {
    Write-Host "[codex-mcp] slack already registered, skipping." -ForegroundColor Gray
} else {
    Write-Host "[codex-mcp] Registering slack MCP server..." -ForegroundColor Yellow
    # `codex mcp add` writes the entry, then auto-starts an OAuth flow that
    # cannot complete non-interactively, so it exits non-zero even though the
    # registration succeeded. Verify the entry landed instead of the exit code.
    codex mcp add slack --url https://mcp.slack.com/mcp *> $null
    codex mcp get slack *> $null
    if ($LASTEXITCODE -ne 0) {
        throw "codex mcp add slack failed to register"
    }
    Write-Host "[codex-mcp] slack registered. Log in from the Codex CLI to authenticate (per-machine)." -ForegroundColor Green
}

Write-Host "=== Codex MCP setup complete. ===" -ForegroundColor Cyan
{{ end -}}
