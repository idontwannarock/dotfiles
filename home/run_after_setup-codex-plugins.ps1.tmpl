{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_after_ script -- Codex plugins (Windows)
# Runs after run_after_modify-codex-config and requires codex from install-02-npm-tools.

$ErrorActionPreference = "Stop"

Write-Host "=== Codex Plugin Setup ===" -ForegroundColor Cyan

if (-not (Get-Command "codex" -ErrorAction SilentlyContinue)) {
    Write-Host "[codex-plugins] codex not found, skipping." -ForegroundColor Yellow
    exit 0
}

$plugins = codex plugin list --json | ConvertFrom-Json
if ($LASTEXITCODE -ne 0) {
    throw "codex plugin list failed (exit $LASTEXITCODE)"
}

$slackEnabled = $plugins.installed | Where-Object {
    $_.pluginId -eq "slack@openai-curated" -and $_.installed -and $_.enabled
}

if ($slackEnabled) {
    Write-Host "[codex-plugins] slack@openai-curated already installed and enabled, skipping." -ForegroundColor Gray
} else {
    Write-Host "[codex-plugins] Installing slack@openai-curated..." -ForegroundColor Yellow
    codex plugin add slack@openai-curated --json | Out-Host
    if ($LASTEXITCODE -ne 0) {
        throw "codex plugin add failed (exit $LASTEXITCODE)"
    }
}

Write-Host "=== Codex plugin setup complete. ===" -ForegroundColor Cyan
{{ end -}}
