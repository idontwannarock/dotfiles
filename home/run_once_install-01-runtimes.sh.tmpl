{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 開發語言與 runtime 安裝（Unix/macOS/WSL）
#
# 安裝策略：
#   系統工具（vim, starship, go）：Linux apt / 官方 installer、macOS brew
#   Node.js  : nvm（兩平台）
#   Rust     : rustup 官方 installer（兩平台）
#   uv       : Linux 官方 installer、macOS brew
#   Python   : 完全由 uv 管理（`uv python install`）
#   Java/JDK : sdkman（兩平台，pinned Temurin identifier）
#   Maven    : sdkman（兩平台）
#
# sdkman 的 Temurin identifier 會隨上游更新漂移，下方 JDK_VERSIONS 是 pinned 值。
# ⚠ 每半年 review 一次最新 Temurin identifier：
#     sdk list java | grep tem
# 最後 review 日期：2026-04-20

set -euo pipefail

{{ template "scripts/log.sh" }}

# ── pinned JDK versions (sdkman) — REVIEW EVERY 6 MONTHS ────────────────
JDK_VERSIONS=(
    "8.0.442-tem"
    "11.0.26-tem"
    "17.0.14-tem"
    "21.0.6-tem"
    "25.0.1-tem"
)

log_begin "runtimes & languages"

log_section "install nvm — the Node version manager everything else on Node depends on"
if [ -s "$HOME/.nvm/nvm.sh" ]; then
    log_skip "[nvm] already installed"
else
    log_step "[nvm] installing v0.40.4 via official installer"
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash
fi

{{ template "scripts/load-nvm" }}

log_section "install Node.js LTS via nvm"
if command -v node &>/dev/null; then
    log_skip "[node] already installed ($(node -v))"
elif command -v nvm &>/dev/null || type nvm &>/dev/null; then
    log_step "[node] installing latest LTS via nvm"
    nvm install --lts
else
    log_warn "[node] nvm not available in this session; skipping node install"
fi

log_section "install vim — the editor, configured by dot_vimrc"
if command -v vim &>/dev/null; then
    log_skip "[vim] already installed"
else
{{- if eq .chezmoi.os "darwin" }}
    log_step "[vim] installing via brew"
    brew install vim
{{- else }}
    log_step "[vim] installing via apt"
    sudo apt-get install -y vim
{{- end }}
fi

log_section "install starship — the shell prompt wired up by dot_shell_common"
if command -v starship &>/dev/null; then
    log_skip "[starship] already installed"
else
{{- if eq .chezmoi.os "darwin" }}
    log_step "[starship] installing via brew"
    brew install starship
{{- else }}
    log_step "[starship] installing via official installer"
    curl -sS https://starship.rs/install.sh | sh -s -- --yes
{{- end }}
fi

# Go 官方沒提供像 rustup / sdkman 的 version manager；Go 1.21+ 內建
# GOTOOLCHAIN 可自動下載 go.mod 需求版本，所以 base 裝一份夠新的即可。
# 守門：base 版本必須 ≥ GO_MIN_VERSION，否則 GOTOOLCHAIN 不可用。
GO_MIN_VERSION="{{ .goMinVersion }}"
{{- if ne .chezmoi.os "darwin" }}
GO_LINUX_TARBALL_VERSION="{{ .goLinuxTarballVersion }}"
{{- end }}

go_version_below_min() {
    # $1 = current (e.g. 1.18.1)  $2 = minimum (e.g. 1.24)
    local cur="$1" min="$2"
    local cur_major cur_minor min_major min_minor
    cur_major="$(echo "$cur" | cut -d. -f1)"
    cur_minor="$(echo "$cur" | cut -d. -f2)"
    min_major="$(echo "$min" | cut -d. -f1)"
    min_minor="$(echo "$min" | cut -d. -f2)"
    [ "$cur_major" -lt "$min_major" ] && return 0
    [ "$cur_major" -eq "$min_major" ] && [ "$cur_minor" -lt "$min_minor" ] && return 0
    return 1
}
{{ if ne .chezmoi.os "darwin" }}
install_go_linux_tarball() {
    local version="$1"
    local arch
    case "$(uname -m)" in
        x86_64)  arch="amd64" ;;
        aarch64) arch="arm64" ;;
        *) log_warn "[go] unsupported arch: $(uname -m)"; return 1 ;;
    esac
    local tarball="go${version}.linux-${arch}.tar.gz"
    local url="https://go.dev/dl/${tarball}"
    local tmp="/tmp/${tarball}"

    log_step "[go] downloading ${url}"
    curl -fsSL "$url" -o "$tmp"

    # apt-managed golang-go would shadow our install at /usr/bin/go; remove first.
    if dpkg -s golang-go >/dev/null 2>&1; then
        log_step "[go] removing apt-managed golang-go so it cannot shadow /usr/bin/go"
        sudo apt-get remove -y golang-go
    fi

    log_step "[go] extracting tarball to \$HOME/.local/go"
    rm -rf "$HOME/.local/go"
    mkdir -p "$HOME/.local"
    tar -C "$HOME/.local" -xzf "$tmp"
    rm -f "$tmp"

    export PATH="$HOME/.local/go/bin:$PATH"
    log_step "[go] installed: $(go version)"
}
{{ end }}
log_section "install Go ≥ ${GO_MIN_VERSION} — the base toolchain GOTOOLCHAIN bootstraps from"
go_needs_install=true
if command -v go >/dev/null 2>&1; then
    go_current_version="$(go version | awk '{print $3}' | sed 's/^go//')"
    if go_version_below_min "$go_current_version" "$GO_MIN_VERSION"; then
        log_step "[go] existing ${go_current_version} < ${GO_MIN_VERSION}; replacing"
    else
        log_skip "[go] already installed (${go_current_version} ≥ ${GO_MIN_VERSION})"
        go_needs_install=false
    fi
fi

if [ "$go_needs_install" = true ]; then
{{- if eq .chezmoi.os "darwin" }}
    if command -v go >/dev/null 2>&1; then
        log_step "[go] upgrading via brew"
        brew upgrade go
    else
        log_step "[go] installing via brew"
        brew install go
    fi
{{- else }}
    install_go_linux_tarball "$GO_LINUX_TARBALL_VERSION"
{{- end }}
fi

log_section "install rustup — Rust toolchain manager (run_update-rust-toolchain keeps it current)"
if command -v rustup &>/dev/null; then
    log_skip "[rustup] already installed"
else
    log_step "[rustup] installing via official installer"
    # --no-modify-path: 由我們自己在 shell rc 管 PATH（~/.cargo/bin 已在 $HOME/.local/bin 之後）
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --no-modify-path
fi

# Make cargo bin available in this session
[ -s "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

log_section "install uv — Python package + version manager (Python is managed entirely through it)"
if command -v uv &>/dev/null; then
    log_skip "[uv] already installed"
else
{{- if eq .chezmoi.os "darwin" }}
    log_step "[uv] installing via brew"
    brew install uv
{{- else }}
    log_step "[uv] installing via official installer"
    curl -LsSf https://astral.sh/uv/install.sh | sh
{{- end }}
fi

# uv 官方 installer 裝到 ~/.local/bin；確保本次 session 能找到
export PATH="$HOME/.local/bin:$PATH"

log_section "install Python 3.13 via uv"
# uv python install 本身是冪等的：已安裝會 reuse。
if command -v uv &>/dev/null; then
    log_step "[python] ensuring 3.13 is installed via uv"
    uv python install 3.13
else
    log_warn "[python] uv not available in this session; skipping python install"
fi

log_section "install sdkman — the JVM toolchain manager JDKs and Maven come from"
if [ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]; then
    log_skip "[sdkman] already installed"
else
    log_step "[sdkman] installing via official installer (rcupdate=false)"
    # rcupdate=false: 避免 sdkman 自動改 .bashrc / .zshrc（chezmoi 管理中，改動會被覆蓋）
    curl -s "https://get.sdkman.io?rcupdate=false" | bash
fi

{{ template "scripts/load-sdkman" }}

if command -v sdk &>/dev/null; then
    # 非互動模式：避免 `sdk install` 詢問 "set as default?"
    SDKMAN_CONFIG="$HOME/.sdkman/etc/config"
    if [ -f "$SDKMAN_CONFIG" ]; then
        if grep -q '^sdkman_auto_answer=' "$SDKMAN_CONFIG"; then
            sed -i.bak 's/^sdkman_auto_answer=.*/sdkman_auto_answer=true/' "$SDKMAN_CONFIG"
            rm -f "${SDKMAN_CONFIG}.bak"
        else
            echo "sdkman_auto_answer=true" >> "$SDKMAN_CONFIG"
        fi
    fi

    # sdkman 的內部 script（如 __sdk_install）會直接讀 $3 無 default，
    # 和 nounset 不相容，所以在呼叫 sdk 前關掉 -u。
    set +u

    log_section "install pinned Temurin JDKs via sdkman — identifiers drift upstream, review every 6 months"
    for ver in "${JDK_VERSIONS[@]}"; do
        if [ -d "$HOME/.sdkman/candidates/java/${ver}" ]; then
            log_skip "[jdk ${ver}] already installed"
        else
            log_step "[jdk ${ver}] installing via sdkman"
            if ! sdk install java "$ver"; then
                log_warn "[jdk ${ver}] install failed — identifier may be stale; refresh with: sdk list java | grep tem"
            fi
        fi
    done

    log_section "install Maven via sdkman"
    if [ -d "$HOME/.sdkman/candidates/maven/current" ]; then
        log_skip "[maven] already installed"
    else
        log_step "[maven] installing via sdkman"
        sdk install maven || log_warn "[maven] install failed"
    fi

    set -u
else
    log_warn "[sdkman] sdk command not available in this session — JDK/Maven skipped"
fi
{{ end -}}
