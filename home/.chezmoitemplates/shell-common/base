# shell_common — 由 ~/.bashrc (WSL/Git Bash) 與 ~/.zshrc (macOS) 共同 source
# 使用 POSIX sh 相容語法

# ── PATH ───────────────────────────────────────────────────────────────────
# ~/.local/bin（自訂 wrapper scripts，需優先於 scoop shims 等）
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# bun global bin（ccusage 等全域套件）
case ":$PATH:" in
    *":$HOME/.bun/bin:"*) ;;
    *) export PATH="$HOME/.bun/bin:$PATH" ;;
esac

# Go tarball install (~/.local/go on Linux) — no-op if dir missing
if [ -d "$HOME/.local/go/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.local/go/bin:"*) ;;
        *) export PATH="$HOME/.local/go/bin:$PATH" ;;
    esac
fi

# ── Starship prompt ──────────────────────────────────────────────────────────
# 由各 rc 檔依 shell 類型初始化（eval "$(starship init bash/zsh)"）

# ── Worklog workflow trigger ─────────────────────────────────────────────────
# createnewlog 觸發遠端 create-daily.yml GitHub Actions workflow 並等待 run 完成。
# 不讀 WORKLOGS_PATH、不依賴 CWD、不做本地 git 操作。
# repo hardcoded: idontwannarock/worklogs（與 CLAUDE.md 的 skills 設定一致）
createnewlog() {
    local repo='idontwannarock/worklogs'
    local workflow='create-daily.yml'

    # Capture the previously most-recent run ID before triggering, so the
    # poll can distinguish the new run from existing history.
    # NOTE: declare and capture on separate lines — `local var="$(cmd)"`
    # makes $? always 0 (the local builtin's exit code), silently swallowing
    # the command substitution's failure.
    local prev_run_id=""
    prev_run_id="$(gh -R "$repo" run list --workflow="$workflow" --limit=1 --json databaseId --jq '.[0].databaseId')"
    if [ $? -ne 0 ]; then
        printf >&2 'error: 查詢既有 run 列表失敗 (gh run list)\n'
        return 1
    fi

    printf '==> 觸發 Create Daily Worklog workflow...\n'
    gh -R "$repo" workflow run "$workflow"
    if [ $? -ne 0 ]; then
        printf >&2 'error: 觸發 workflow 失敗 (gh workflow run)\n'
        return 1
    fi

    # Poll until a NEW run ID appears（最多 10 秒，每秒一次）。
    # 比較 candidate != prev_run_id 避免撞到舊 run（重要：若只檢查
    # 「非空」，prev_id 存在時第一次 poll 會立刻撈到舊 run，把它的歷史
    # 結果當成新 run 的結果回報，造成假成功/假失敗）。
    local run_id=""
    local candidate=""
    local i=0
    while [ "$i" -lt 10 ]; do
        sleep 1
        candidate="$(gh -R "$repo" run list --workflow="$workflow" --limit=1 --json databaseId --jq '.[0].databaseId')"
        if [ $? -ne 0 ]; then
            printf >&2 'error: 查詢 run ID 失敗 (gh run list)\n'
            return 1
        fi
        if [ -n "$candidate" ] && [ "$candidate" != "$prev_run_id" ]; then
            run_id="$candidate"
            break
        fi
        i=$((i + 1))
    done

    if [ -z "$run_id" ]; then
        printf >&2 'error: 找不到 workflow run（輪詢 10 秒仍未出現新 run），請到 GitHub Actions 頁面確認\n'
        return 1
    fi

    printf '==> 等待 workflow run #%s 完成...\n' "$run_id"
    gh -R "$repo" run watch "$run_id" --exit-status
    local watch_status=$?
    if [ "$watch_status" -ne 0 ]; then
        printf >&2 'error: workflow run #%s 失敗或被取消 (exit=%d)\n' "$run_id" "$watch_status"
        return "$watch_status"
    fi

    printf '==> Workflow 完成。\n'
}

# ── claude-zai: route Claude Code to z.ai Anthropic-compatible endpoint ─────
# 從 pass vault 取 token；vault 不可用時 fallback 到 $ZAI_API_KEY env var。
# 每次呼叫可覆寫 model：ZAI_OPUS_MODEL=GLM-4.6 claude-zai
claude-zai() {
    local token=""
    if command -v pass >/dev/null 2>&1; then
        token="$(pass show z.ai/claude-code-token 2>/dev/null)"
    fi
    if [ -z "$token" ]; then
        token="$ZAI_API_KEY"
    fi
    if [ -z "$token" ]; then
        printf >&2 'claude-zai: no token (pass z.ai/claude-code-token unreadable and $ZAI_API_KEY unset)\n'
        return 1
    fi

    ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
    ANTHROPIC_AUTH_TOKEN="$token" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="${ZAI_OPUS_MODEL:-GLM-5.2}" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="${ZAI_SONNET_MODEL:-GLM-5.1}" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="${ZAI_HAIKU_MODEL:-GLM-5}" \
    API_TIMEOUT_MS="${ZAI_TIMEOUT_MS:-3000000}" \
    claude "$@"
}

# ── glab: corp GitLab CLI ───────────────────────────────────────────────────
# 與 claude-zai 同形：從 pass vault 惰性取 token（shell 啟動時不解密，故不跳
# pinentry），vault 不可用時 fallback 到 $GITLAB_TOKEN。
# 這個 function 以 glab 為名遮蔽 binary，轉呼叫用 `command glab` 避免遞迴。
# host 由機器本地狀態提供，刻意不在此 repo 裡（見 docs/gitlab-corp-access.md）。
glab() {
    # 未設 host 時 glab 預設連 gitlab.com，用 corp token 會拿到 401 —— 一個指向
    # token、真正成因卻是 host 的錯誤。先擋下來，直接說出成因。
    if [ -z "$GITLAB_HOST" ]; then
        printf >&2 'glab: GITLAB_HOST 未設定；不設會連向 gitlab.com 並回 401。見 docs/gitlab-corp-access.md\n'
        return 1
    fi

    local token=""
    if command -v pass >/dev/null 2>&1; then
        token="$(pass show gitlab/corp-token 2>/dev/null)"
    fi
    if [ -z "$token" ]; then
        token="$GITLAB_TOKEN"
    fi
    if [ -z "$token" ]; then
        printf >&2 'glab: no token (vault entry gitlab/corp-token unreadable and GITLAB_TOKEN unset)\n'
        return 1
    fi

    GITLAB_TOKEN="$token" command glab "$@"
}

# ── apply 中止可見化 ─────────────────────────────────────────────────────────
# chezmoi 依 target path 字典序處理且沒有 skip-on-error：任何一項失敗，字典序排在它
# 之後的 target 全部靜默落空，而 chezmoi 的輸出只有那一行錯誤。曾因此讓
# Documents/_shared-profile.d/26-glab.ps1 長期沒部署到 Windows，靠跨機比對才發現。
#
# 這個 function 以 chezmoi 為名遮蔽 binary，轉呼叫用 `command chezmoi` 避免遞迴。
# 待處理筆數只在失敗路徑上算 —— `chezmoi status` 要掃 external 底下數千個檔案，
# 該機實測 31 秒，不能放進 shell 啟動路徑。
# Mirror of Documents/_shared-profile.d/96-chezmoi-guard.ps1; the two warning
# strings are kept byte-identical on purpose.
chezmoi() {
    command chezmoi "$@"
    local rc=$?
    [ "$rc" -eq 0 ] && return 0

    local arg sub=""
    for arg in "$@"; do
        case "$arg" in
            apply|update) sub="$arg"; break ;;
        esac
    done
    [ -n "$sub" ] || return "$rc"
    # chezmoi 根本沒裝時 rc=127，那不是 apply 中止，別把警告貼上去。
    command -v chezmoi >/dev/null 2>&1 || return "$rc"

    printf >&2 '\n\033[33mchezmoi: %s 中止 (exit %s)。chezmoi 依字典序處理 target 且不跳過失敗項 —— 排在它之後的 target 全部未部署。\033[0m\n' "$sub" "$rc"
    local pending
    pending="$(command chezmoi status 2>/dev/null | grep -c '')"
    printf >&2 '\033[33mchezmoi: 目前 %s 筆待處理（chezmoi status）。\033[0m\n\n' "$pending"
    return "$rc"
}

# ── 自動 fetch dotfiles 並提示更新 ───────────────────────────────────────────
_dotfiles_check_update() {
    local flag_file="$HOME/.local/share/chezmoi-last-fetch"
    local today
    today="$(date +%Y%m%d 2>/dev/null)" || return

    # 每天最多 fetch 一次
    if [ -f "$flag_file" ] && [ "$(cat "$flag_file" 2>/dev/null)" = "$today" ]; then
        return
    fi

    # 確認 chezmoi 與 git 都可用
    command -v chezmoi >/dev/null 2>&1 || return
    command -v git >/dev/null 2>&1 || return

    mkdir -p "$(dirname "$flag_file")"
    echo "$today" > "$flag_file"

    # 靜默 fetch
    chezmoi git -- fetch -q 2>/dev/null || return

    # 計算落後的 commit 數
    local behind
    behind="$(chezmoi git -- rev-list HEAD..origin/main --count 2>/dev/null)" || return

    if [ "${behind:-0}" -gt 0 ]; then
        printf '\n\033[33mdotfiles: %s new commit(s). Run '\''chezmoi update'\'' to apply.\033[0m\n\n' "$behind"
    fi
}
_dotfiles_check_update
