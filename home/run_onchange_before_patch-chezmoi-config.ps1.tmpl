{{- if eq .chezmoi.os "windows" -}}
{{- $expectedPath := printf "%s;%s" (joinPath .chezmoi.homeDir ".local/bin") (output "powershell" "-NoProfile" "-Command" "[Environment]::GetEnvironmentVariable('Path','Machine')+';'+[Environment]::GetEnvironmentVariable('Path','User')" | trim) -}}
# chezmoi run_onchange_before_ script — self-heal ~/.config/chezmoi/chezmoi.toml
# on Windows: (1) [scriptEnv] PATH, so subprocesses see tools installed after the
# last init, and (2) [interpreters.sh], so modify_*.sh finds the correct sh.
#
# Background: `.chezmoi.toml.tmpl` is rendered into the local chezmoi config
# only on `chezmoi init`. `chezmoi update` / `chezmoi apply` do not re-render
# it. Environments initialized before the `[interpreters.sh]` block was added
# to the template will keep failing with:
#
#     fork/exec ...\*.settings.json.sh: %1 is not a valid Win32 application.
#
# until someone manually runs `chezmoi init` again. This script patches the
# local config in place so a plain `chezmoi update` can self-heal.
#
# The same staleness bites [scriptEnv] PATH, which the template builds from the
# registry (Machine + User) at render time and then freezes into the config. Any
# installer that prepends to the registry PATH — herdr's install.ps1 does exactly
# this — stays invisible to chezmoi until someone re-runs `chezmoi init`:
# `lookPath` misses the binary and the PATH handed to run_*/modify_* subprocesses
# lacks its directory. The expected PATH is rendered into this script below, so
# the run_onchange_ hash changes precisely when the registry PATH changes, and
# this script re-runs exactly then (a plain run_ would fire on every apply and
# add another permanently-dirty entry to `chezmoi status`).
#
# Must be .ps1 (not .sh) to avoid the chicken-and-egg of needing the sh
# interpreter before we've configured it. Uses run_onchange_before_ so it
# runs once (per template change) before any modify_*.sh entries.
#
# Caveat: chezmoi likely caches the config at startup, so on the very first
# apply that patches a stale config, the subsequent modify_*.sh in the SAME
# run may still fail. A second `chezmoi apply` will then pick up the patched
# interpreter and succeed. We print a clear hint when this happens.

$ErrorActionPreference = "Stop"

{{ template "scripts/log.ps1" }}

Log-Begin "chezmoi.toml self-heal"
try {
    $configPath = Join-Path $env:USERPROFILE ".config\chezmoi\chezmoi.toml"

    Log-Section "refresh [scriptEnv] PATH from the registry — the config froze it at init time"
    # Single-quoted here-string: the PATH is rendered verbatim from the same
    # expression .chezmoi.toml.tmpl uses, and must not be re-interpolated.
    $expectedPath = @'
{{ $expectedPath }}
'@
    if (-not (Test-Path $configPath)) {
        Log-Skip "[chezmoi.toml] no local config; chezmoi init renders scriptEnv correctly"
    } else {
        $content = Get-Content $configPath -Raw
        # `[^\[]*?` keeps the search inside the block — a section header would end it,
        # so a config without a scriptEnv PATH can never match some other section's.
        $pathMatch = [regex]::Match($content, '(?m)^\[scriptEnv\][^\[]*?^\s*PATH\s*=\s*"([^"]*)"')
        # Un-escape before comparing, else the block is rewritten on every run.
        $currentPath = if ($pathMatch.Success) { $pathMatch.Groups[1].Value.Replace('\\', '\') } else { $null }

        if ($currentPath -eq $expectedPath) {
            Log-Skip "[chezmoi.toml] scriptEnv PATH already matches the registry"
        } else {
            $escapedPath = $expectedPath.Replace('\', '\\')
            if ($pathMatch.Success) {
                # Swap the value in place by index. Strip-and-re-append would eat the
                # newline on both sides of the block and glue the next section header
                # onto the tail of a comment; splicing the quoted value touches nothing
                # else, and index math needs no escaping of `$` or `\` in the PATH.
                $g = $pathMatch.Groups[1]
                $newContent = $content.Remove($g.Index, $g.Length).Insert($g.Index, $escapedPath)
            } else {
                # Config predates the [scriptEnv] block entirely — append one.
                $newContent = $content.TrimEnd() + "`n`n[scriptEnv]`n    PATH = `"$escapedPath`"`n"
            }
            $utf8NoBom = New-Object System.Text.UTF8Encoding $false
            [System.IO.File]::WriteAllText($configPath, $newContent, $utf8NoBom)

            Log-Step "[chezmoi.toml] refreshed [scriptEnv] PATH from the registry"
            Log-Warn "chezmoi read the old PATH at startup — re-run 'chezmoi apply' once so"
            Log-Warn "lookPath and run_*/modify_* subprocesses see newly installed tools"
        }
    }

    Log-Section "locate git-bash by ordered candidate roots — a PATH lookup would pick WSL's System32 bash"
    # Detect git-bash: ordered candidate Git-for-Windows roots, first whose
    # bin\bash.exe exists wins. Non-scoop first (new installs win), scoop last
    # (back-compat). NEVER a PATH `where bash` -- that picks WSL System32 bash or the
    # wrong usr\bin variant. The official/winget installer registers its dir at
    # HKLM/HKCU\SOFTWARE\GitForWindows\InstallPath, so probe that too (catches a
    # non-default install dir; PortableGit + scoop don't write that key). This
    # mirrors the static list in .chezmoi.toml.tmpl, plus the registry probe that a
    # Go template can't do -- so this self-heal is what fixes a non-default install.
    $gitRoots = [System.Collections.Generic.List[string]]::new()
    $gitRoots.Add((Join-Path $env:USERPROFILE ".local\opt\git"))
    $gitRoots.Add("C:\Program Files\Git")
    foreach ($hive in @("HKLM:\SOFTWARE\GitForWindows", "HKCU:\SOFTWARE\GitForWindows")) {
        try {
            $ip = (Get-ItemProperty -Path $hive -Name InstallPath -ErrorAction Stop).InstallPath
            if ($ip -and -not $gitRoots.Contains($ip)) { $gitRoots.Add($ip) }
        } catch {}
    }
    $gitRoots.Add((Join-Path $env:USERPROFILE "scoop\apps\git\current"))  # scoop -- last, back-compat

    $expectedCommand = $null
    foreach ($root in $gitRoots) {
        $cand = Join-Path $root "bin\bash.exe"
        if (Test-Path $cand) { $expectedCommand = $cand; break }
    }

    if (-not (Test-Path $configPath)) {
        # No local config means chezmoi has never been init'd here. The script
        # that normally creates it (chezmoi init) renders the template with the
        # correct interpreter block already, so there's nothing for us to patch.
        Log-Skip "[chezmoi.toml] no local config; chezmoi init renders the block correctly"
        return
    }

    if (-not $expectedCommand) {
        Log-Warn "no Git Bash (bin\bash.exe) found under any known Git-for-Windows root"
        Log-Warn "install git via winget (winget install Git.Git) so chezmoi can exec .sh scripts"
        return
    }

    Log-Section "rewrite [interpreters.sh] only when it disagrees with the detected git-bash"
    $content = Get-Content $configPath -Raw

    # Detect an existing [interpreters.sh] block and its current command value.
    $blockRegex = '(?ms)^\[interpreters\.sh\][^\[]*?command\s*=\s*"([^"]*)"'
    $match      = [regex]::Match($content, $blockRegex)

    # The config stores the path TOML-escaped ("C:\\Users\\..."); un-escape the
    # captured value before comparing to the raw $expectedCommand, else the block is
    # rewritten on every run (and the write below would emit invalid single-backslash
    # TOML, where e.g. \b is a backspace escape).
    $currentCmd = if ($match.Success) { $match.Groups[1].Value.Replace('\\', '\') } else { $null }
    if ($currentCmd -eq $expectedCommand) {
        Log-Skip "[chezmoi.toml] interpreter already points at $expectedCommand"
        return
    }

    # Remove any existing [interpreters.sh] block (matches until next section or EOF),
    # then append a fresh block. This handles both "block missing" and "block present
    # but wrong" in one code path.
    $stripRegex = '(?ms)\r?\n?^\[interpreters\.sh\].*?(?=^\[|\z)'
    $cleaned    = [regex]::Replace($content, $stripRegex, '').TrimEnd()

    $escapedCommand = $expectedCommand.Replace('\', '\\')
    $freshBlock = @"
[interpreters.sh]
    command = "$escapedCommand"
"@

    $newContent = $cleaned + "`n`n" + $freshBlock + "`n"

    $utf8NoBom = New-Object System.Text.UTF8Encoding $false
    [System.IO.File]::WriteAllText($configPath, $newContent, $utf8NoBom)

    Log-Step "[chezmoi.toml] patched [interpreters.sh] in $configPath"
    Log-Step "[chezmoi.toml] command = `"$expectedCommand`""
    Log-Warn "if THIS apply now fails on a modify_*.sh with 'not a valid Win32 application',"
    Log-Warn "re-run 'chezmoi apply' once more — the patched interpreter is read at startup"
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
