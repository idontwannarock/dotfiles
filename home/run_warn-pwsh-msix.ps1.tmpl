{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_ script (runs every apply) -- WARN ONLY when pwsh is the Microsoft
# Store (MSIX) build. It never removes or installs anything: switching to the MSI
# build needs admin + is destructive + pwsh is chezmoi's .ps1 interpreter
# (chicken-and-egg), so the real switch is a manual, user-run, elevated helper at
# ~/.local/bin/switch-pwsh-to-msi.ps1. This just nudges until that's done, and goes
# silent once pwsh is the MSI build with no MSIX left.
#
# Detection: this script runs UNDER chezmoi's pwsh, so $PSHOME reveals the active
# interpreter (MSIX lives under WindowsApps). The Appx probe also catches a leftover
# MSIX even when an MSI pwsh is the one currently on PATH.

{{ template "scripts/log.ps1" }}

Log-Begin "pwsh MSIX check"
try {
    Log-Section "detect whether pwsh is the Store (MSIX) build — nudge only, never changes anything"
    # Detection must never fail an apply -- this is only a nudge. Any error (e.g. the
    # Appx module failing to load) is swallowed and treated as "can't tell, stay quiet".
    try {
        $isMsixHost = $PSHOME -like '*WindowsApps*'
        $hasAppx    = [bool](Get-AppxPackage Microsoft.PowerShell -ErrorAction SilentlyContinue)
    } catch {
        $isMsixHost = $false
        $hasAppx    = $false
    }

    if ($isMsixHost -or $hasAppx) {
        Log-Warn "pwsh is the Microsoft Store (MSIX) build, not the MSI build in C:\Program Files\PowerShell\7."
        Log-Warn "To switch off Store onto the standard MSI build, run ELEVATED:  switch-pwsh-to-msi.ps1"
        Log-Warn "Safe to ignore -- the MSIX pwsh works fine as chezmoi's .ps1 interpreter. This is a preference nudge."
    } else {
        Log-Skip "[pwsh] already the MSI build with no MSIX left"
    }
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
