# ── private workspace 插座 ──────────────────────────────────────────────────
# private workspace 把只屬於它的 shell 函式放在 ~/.shell_common.d/*.sh，這裡依檔名順序載入。
# 放在所有 OS 片段之後，所以那些檔案可以用 ~/.shell_common 定義的一切。見 docs/private-workspaces.md。
# zsh 預設沒有符合的 glob 會報錯，所以只在這個函式裡開 null_glob。
_shell_common_d() {
    [ -n "${ZSH_VERSION-}" ] && setopt local_options null_glob
    local _f
    for _f in "$HOME"/.shell_common.d/*.sh; do
        [ -r "$_f" ] && . "$_f"
    done
}
_shell_common_d
unset -f _shell_common_d
