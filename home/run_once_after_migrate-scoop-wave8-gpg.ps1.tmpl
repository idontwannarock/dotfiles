{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_after_ script -- Wave 8 cleanup: GnuPG off Scoop.
#
# run_onchange_install-gnupg.ps1.tmpl (earlier phase) installs vanilla GnuPG to
# ~/.local/opt/gnupg. This one-time script removes the old Scoop gpg and the
# stale state it left behind, so nothing recreates the portable-mode bug.
#
# Kept separate from run_once_after_migrate-scoop-cleanup.ps1.tmpl: beyond the
# uninstall it kills daemons, wipes agent sockets and repairs a cmd.exe AutoRun.
#
# Idempotent: each step is a no-op when its target is already gone.

$ErrorActionPreference = "Continue"

{{ template "scripts/log.ps1" }}
{{ template "scripts/scoop-uninstall.ps1" }}

Log-Begin "Wave 8: GnuPG off scoop"
try {
    Log-Section "kill leftover scoop gpg daemons — they hold files the uninstall needs to delete"
    Get-Process gpg-agent,scdaemon,keyboxd,dirmngr -ErrorAction SilentlyContinue |
        Where-Object { $_.Path -like '*\scoop\apps\gpg\*' } |
        Stop-Process -Force -ErrorAction SilentlyContinue

    if (Get-Command "scoop" -ErrorAction SilentlyContinue) {
        Remove-ScoopPackage -Name "gpg" -Reason "scoop's manifest drops an empty gpgconf.ctl that forces portable mode, so GNUPGHOME is ignored"
    } else {
        Log-Skip "scoop not found; skipping uninstall"
    }

    Log-Section "remove orphaned gpg/gpg2 shims — the scoop gpg shim was hijacked to git's gpg"
    $shimDir = Join-Path $env:USERPROFILE "scoop\shims"
    foreach ($f in 'gpg.exe','gpg.shim','gpg2.exe','gpg2.shim') {
        $p = Join-Path $shimDir $f
        if (Test-Path $p) {
            Remove-Item $p -Force -ErrorAction SilentlyContinue
            Log-Step "[shim] removed $f"
        }
    }

    Log-Section "wipe stale gpg-agent sockets — a dead scoop-portable agent socket makes gpg report 'No secret key'"
    Get-ChildItem (Join-Path $env:USERPROFILE ".gnupg\S.gpg-agent*") -Force -ErrorAction SilentlyContinue |
        Remove-Item -Force -ErrorAction SilentlyContinue

    Log-Section "drop the orphaned clink cmd.exe AutoRun — it broke the corp-ssh-askpass handoff (Wave 4 gap)"
    # Only if it points at a clink.bat that no longer exists -- never touch a working AutoRun.
    $cp = 'HKCU:\Software\Microsoft\Command Processor'
    $autorun = (Get-ItemProperty -Path $cp -Name AutoRun -ErrorAction SilentlyContinue).AutoRun
    if ($autorun -match 'clink') {
        $batPath = if ($autorun -match '"([^"]+\.bat)"') { $Matches[1] } else { $null }
        if ($batPath -and -not (Test-Path $batPath)) {
            Remove-ItemProperty -Path $cp -Name AutoRun -ErrorAction SilentlyContinue
            Log-Step "[clink] removed orphaned cmd.exe AutoRun -> $batPath (missing)"
        } else {
            Log-Skip "[clink] AutoRun still points at an existing script; left alone"
        }
    } else {
        Log-Skip "[clink] no clink AutoRun present"
    }
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
