{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_ script — Codex CLI (Windows)
# Installs Codex with the official standalone installer and keeps the
# app-server daemon on the same version as the CLI.
#
# The daemon keeps its own copy of Codex and, by default, updates it hourly.
# When the CLI and the daemon differ, the daemon refuses the CLI ("Background
# server has incompatible feature settings"). Fix: chezmoi owns the version.
# Upgrade the CLI here, turn the daemon updater off, and pin the daemon to the
# CLI package. rc and the mobile app need the daemon, so turning the daemon
# itself off is not an option. Keep this logic identical to the bash twin.
#
# Sorts after install-02-npm-tools, which removes the old npm copy. The
# installer adds its bin dir to User PATH for future shells only, so this
# script calls codex.exe by its full path.

$ErrorActionPreference = "Stop"

{{ template "scripts/log.ps1" }}

Log-Begin "Codex CLI"
try {
    # Read the version from the standalone path, NOT Get-Command: a stale
    # codex shim from an old Node install once satisfied Get-Command and
    # blocked the install.
    Log-Section "install or upgrade Codex CLI with the official standalone installer -- the daemon gets pinned to this CLI below"
    $codexExe = Join-Path $env:LOCALAPPDATA "Programs\OpenAI\Codex\bin\codex.exe"
    $codexCurrent = if (Test-Path $codexExe) { ((& $codexExe --version 2>$null) -split ' ')[-1] } else { "" }
    $codexLatest = try {
        (Invoke-RestMethod "https://releases.openai.com/codex/channels/latest" -TimeoutSec 30).tag_name -replace '^(rust-v|v)', ''
    } catch { "" }
    if (-not $codexLatest) {
        if (-not $codexCurrent) {
            Log-Warn "[codex] release server unreachable and Codex not installed; retrying on the next apply"
            return
        }
        Log-Warn "[codex] release server unreachable; keeping $codexCurrent"
    } elseif ($codexCurrent -eq $codexLatest) {
        Log-Skip "[codex] already at $codexCurrent"
    } else {
        Log-Step "[codex] installing $(if ($codexCurrent) { $codexCurrent } else { 'none' }) -> $codexLatest"
        $env:CODEX_NON_INTERACTIVE = "1"
        $env:CODEX_RELEASE = $codexLatest
        & ([scriptblock]::Create((Invoke-RestMethod "https://chatgpt.com/codex/install.ps1")))
    }

    Log-Section "turn off the daemon updater -- otherwise the daemon moves ahead of the CLI within an hour"
    $codexHome = if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $HOME ".codex" }
    $daemonSettings = Join-Path $codexHome "app-server-daemon\settings.json"
    $settings = if (Test-Path $daemonSettings) { Get-Content -Raw $daemonSettings | ConvertFrom-Json } else { [pscustomobject]@{} }
    $daemonSettingsChanged = $false
    if ($settings.updater -and $settings.updater.autoUpdateEnabled -eq $false) {
        Log-Skip "[codex] daemon updater already off"
    } else {
        Log-Step "[codex] setting updater.autoUpdateEnabled=false in $daemonSettings"
        if (-not $settings.updater) {
            $settings | Add-Member -NotePropertyName updater -NotePropertyValue ([pscustomobject]@{}) -Force
        }
        $settings.updater | Add-Member -NotePropertyName autoUpdateEnabled -NotePropertyValue $false -Force
        New-Item -ItemType Directory -Force -Path (Split-Path $daemonSettings) | Out-Null
        # WriteAllText, not Set-Content: PowerShell 5.1 writes a BOM with
        # -Encoding utf8, and the daemon's JSON parser may reject it.
        [IO.File]::WriteAllText($daemonSettings, ($settings | ConvertTo-Json -Depth 10))
        $daemonSettingsChanged = $true
    }

    # Also pin when the settings just changed: a running updater only reads
    # the new setting after a daemon restart, and the pin restarts the daemon.
    Log-Section "pin the daemon to the CLI package -- a running daemon restarts"
    $daemonCodex = Join-Path $codexHome "packages\app-server-daemon\current\bin\codex.exe"
    $codexCurrent = ((& $codexExe --version 2>$null) -split ' ')[-1]
    if (-not (Test-Path $daemonCodex)) {
        Log-Skip "[codex] no daemon package yet; the first daemon start copies the CLI package"
    } else {
        $daemonVersion = ((& $daemonCodex --version 2>$null) -split ' ')[-1]
        if ($daemonVersion -eq $codexCurrent -and -not $daemonSettingsChanged) {
            Log-Skip "[codex] daemon already at $codexCurrent"
        } else {
            Log-Step "[codex] pinning daemon $daemonVersion -> CLI $codexCurrent"
            $pinOut = & $codexExe app-server daemon update --from-cli --yes 2>$null
            if ($LASTEXITCODE -ne 0) {
                Log-Warn "[codex] daemon pin failed: $pinOut"
            }
        }
    }
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
