#!/usr/bin/env bash
# corp-ssh-askpass — SSH_ASKPASS helper for password+OTP hosts.
#
# Invoked by openssh when SSH_ASKPASS_REQUIRE=force is set and openssh would
# otherwise prompt via the TTY. Reads ~/.corp-ssh/hosts.yaml (local-only, not
# in the dotfiles repo) to decide which hosts to answer for; credentials come
# from a running, unlocked `bw serve` (Bitwarden CLI) on localhost:8087.
#
# See docs/corp-ssh-setup.md for the full setup guide.

set -eu

prompt="${1:-}"
hosts_file="$HOME/.corp-ssh/hosts.yaml"

# 0. Fallback for prompts this helper does not own. SSH_ASKPASS_REQUIRE=force
#    routes EVERY openssh question here, including host-key confirmations
#    ("Are you sure you want to continue connecting (yes/no/...)?") and password
#    prompts for hosts outside hosts.yaml. Exiting 1 answers those with "no":
#    connecting to any new host then fails with "Host key verification failed."
#    So hand the question back to the human instead. openssh gives this helper
#    no TTY of its own, so open /dev/tty directly; with no controlling terminal
#    (cron, agents, CI) there is nobody to ask and declining stays correct.
ask_human() {
  { exec 3<>/dev/tty; } 2>/dev/null || exit 1
  printf '%s' "$prompt" >&3
  if [[ "$prompt" == *"(yes/no"* ]]; then
    read -r reply <&3 || exit 1          # host-key answer, echo it back
  else
    read -rs reply <&3 || exit 1         # password, keep it off the screen
    printf '\n' >&3
  fi
  printf '%s\n' "$reply"
  exit 0
}

# 1. Parse hostname from the prompt. Two shapes exist, one per auth method:
#      keyboard-interactive (PAM) → "(user@host.fqdn) Password:"
#      password (openssh builtin) → "user@host.fqdn's password: "
#    Greedy "(.+@)?" in both handles user principals containing '@',
#    e.g. "(ad-user@corp-domain@actual-host.fqdn) Password:".
#    Regexes stored in variables to avoid bash inline-regex parser quirks.
kbdint_re='\((.+@)?([^)]+)\) '
passwd_re="^(.+@)?(.+)'s password: ?\$"
if [[ "$prompt" =~ $kbdint_re ]] || [[ "$prompt" =~ $passwd_re ]]; then
  target_host="${BASH_REMATCH[2]}"
else
  ask_human   # prompt format unrecognized → not ours, ask the human
fi
short_host="${target_host%%.*}"

# 2. Only answer for hosts listed in hosts.yaml (either FQDN or short form).
[[ -r "$hosts_file" ]] || ask_human
if ! grep -qE "^[[:space:]]*-[[:space:]]*(${short_host}|${target_host})[[:space:]]*\$" "$hosts_file"; then
  ask_human   # not a corp host → ask the human, as plain ssh would
fi

# 3. Resolve the Bitwarden item prefix from yaml. The shared AD credential is
#    the item named "$pass_path" (password + TOTP seed).
pass_path=$(awk -F: '/^pass_path:/ { print $2 }' "$hosts_file" | tr -d ' ')
[[ -n "$pass_path" ]] || ask_human

# bw serve listens on localhost only. Under WSL, localhost is the Linux VM, so
# reach a Windows-side bw serve through curl.exe, which runs on the Windows side.
curl_bin=curl
command -v curl.exe >/dev/null 2>&1 && curl_bin=curl.exe
api=http://localhost:8087

# Under ProxyJump the jump ssh runs with -W, so its stdin is the tunnel, and
# this helper inherits it. WSL interop forwards stdin to curl.exe, which then
# eats tunnel bytes and breaks the inner connection ("Bad packet length").
exec </dev/null

fail() {
  echo "corp-ssh-askpass: $1" >&2
  echo "corp-ssh-askpass: Start and unlock bw serve — see docs/corp-ssh-setup.md." >&2
  exit 1
}

# 3b. Hosts with their own local account (not the shared AD principal) keep
#     their password in the item "$pass_path/hosts/<short_host>". One list
#     request answers both lookups. A locked or stopped bw serve fails the
#     request, and the helper fails closed — it never falls back to the shared
#     password because a per-host lookup failed.
if [[ "$prompt" != *"One-time Password:"* ]]; then
  # Sync first, so a password rotated in the vault reaches ssh at once.
  # An offline sync is not fatal: the cached vault still answers. The sync is
  # the one request bw serve forwards to the Bitwarden server, so cap it at 5 s:
  # a firewall that drops packets would otherwise hang ssh here.
  "$curl_bin" -s -m 5 -X POST "$api/sync" >/dev/null 2>&1 || true
fi
items=$("$curl_bin" -s "$api/list/object/items?search=$pass_path" 2>/dev/null) \
  && jq -e '.success == true' >/dev/null 2>&1 <<<"$items" \
  || fail "bw serve not reachable or locked."
host_entry="$pass_path/hosts/$short_host"
pick() { jq -r --arg n "$1" --arg f "$2" \
  'first(.data.data[] | select(.name == $n) | .[$f] // .login[$f]) // empty' <<<"$items"; }

# 4. Dispatch by prompt content.
#    Match order matters: "One-time Password:" must come first because bash
#    `case` is first-match and "*Password:*" would otherwise swallow it.
case "$prompt" in
  *"One-time Password:"*)
    id=$(pick "$pass_path" id)
    [[ -n "$id" ]] || fail "no Bitwarden item named $pass_path."
    out=$("$curl_bin" -s "$api/object/totp/$id" 2>/dev/null | jq -r '.data.data // empty') ;;
  *"Password:"*|*"'s password:"*)
    out=$(pick "$host_entry" password)
    [[ -n "$out" ]] || out=$(pick "$pass_path" password) ;;
  *) ask_human ;;
esac

[[ -n "$out" ]] || fail "empty answer from bw serve for ${target_host}."

printf '%s\n' "$out"
