{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 容器與雲端工具安裝（Unix/macOS/WSL）
# macOS: brew, Linux/WSL: apt + 官方 repo

set -euo pipefail

{{ template "scripts/log.sh" }}
{{ template "scripts/pkg-install.sh" . }}
{{- if eq .chezmoi.os "darwin" }}
{{ template "scripts/brew-cask-install.sh" }}
{{- end }}

log_begin "container & cloud tools"

{{- if eq .chezmoi.os "darwin" }}

log_section "check Homebrew is available — every install below goes through it"
if ! command -v brew &>/dev/null; then
    log_warn "[containers] Homebrew not found; skipping"
    exit 0
fi

log_section "install Docker Desktop — ships both the docker CLI and compose"
brew_install_cask docker

log_section "install Kubernetes CLI tooling"
pkg_install kubectl
pkg_install kubelogin

log_section "install Lens — the Kubernetes GUI"
brew_install_cask lens

{{- else }}

log_section "install Docker Engine via the upstream convenience script"
if command -v docker &>/dev/null; then
    log_skip "[docker] already installed"
else
    log_step "[docker] installing via official script"
    curl -fsSL https://get.docker.com | sh
fi

log_section "install the docker compose plugin"
if docker compose version &>/dev/null 2>&1; then
    log_skip "[docker-compose] already installed"
else
    log_step "[docker-compose] installing plugin via apt"
    sudo apt-get install -y docker-compose-plugin 2>/dev/null \
        || log_warn "[docker-compose] install manually if Docker was not installed via apt"
fi

log_section "install kubectl from the upstream Kubernetes apt repo"
if command -v kubectl &>/dev/null; then
    log_skip "[kubectl] already installed"
else
    log_step "[kubectl] adding the pkgs.k8s.io repo and installing"
    curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.32/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg 2>/dev/null || true
    echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.32/deb/ /' | sudo tee /etc/apt/sources.list.d/kubernetes.list > /dev/null
    sudo apt-get update -q && sudo apt-get install -y kubectl
fi

log_section "check kubelogin — no apt package, so this only reports"
if command -v kubelogin &>/dev/null; then
    log_skip "[kubelogin] already installed"
else
    log_warn "[kubelogin] install manually: https://github.com/Azure/kubelogin"
fi

log_section "skip Lens — GUI app, belongs to the host OS on Linux/WSL"
log_skip "[lens] GUI app; install manually on Linux/WSL if needed"

{{- end }}
{{ end -}}
