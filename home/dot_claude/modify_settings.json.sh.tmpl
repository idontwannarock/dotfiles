#!/usr/bin/env bash
# chezmoi modify_ script — patch Claude Code settings.json
#
# 策略：
# 只 patch 穩定的「個人偏好」欄位，保留 enabledPlugins / extraKnownMarketplaces
# 等會被 Claude Code runtime 寫入的部分。
#
# 同步的欄位：
# - model = claude-opus-5（200K context 變體，非 [1m] 1M variant）
# - effortLevel、autoUpdatesChannel、skipDangerousModePermissionPrompt
# - outputStyle = ELI5（output style 本體在 output-styles/ELI5.md）
# - permissions.defaultMode = bypassPermissions
# - permissions.allow 併入 "Skill(*)"（union + unique，不覆蓋現有 entries）
# - permissions.deny 併入四個內建工具（union + unique）。deny 不只是執行期攔截，
#   它會把工具 schema 整個從 system prompt 移除：實測 prompt 29,135 → 18,513
#   token，其中 Workflow 一個就佔 ~8,100。ListAgents 刻意不列 —— coordinate
#   skill 靠它做艦隊定址。
# - skillOverrides 併入 13 個 "off"（object merge，不覆蓋其他 entries）：內建
#   skill 中零使用、且與自訂 code:* / git:* 指令重疊的那些。
# - statusLine（跨平台處理執行檔路徑）
# - hooks.UserPromptSubmit（註冊 handoff-reminder.sh，context 用量階梯提醒）
# - hooks.SessionStart（union-append claude-memory-seed；**不** hard-assign，
#   以保留 herdr / agent-sessions 等工具於 runtime 註冊的 SessionStart entries）
#
# 主動刪除（modify_ 是 patch 而非 render，停止寫入不會抹掉既有部署的舊值）：
# - env.CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS —— 退役的 handoff-cleanup hook
#   殘留，跨機器 del 清除。
# - hooks.SessionEnd 只**外科式**移除 handoff-cleanup 那一條（該 hook 靠 SessionEnd
#   做刪檔、會拖慢觸發 timeout，已退役）；保留其餘 SessionEnd entries，尤其
#   agent-sessions 於 runtime 註冊的 `emit end`（本地 append，不會 timeout）。
# - hooks.PreToolUse 只**外科式**移除 rtk-rewrite 那一條（rtk 已退役——它摘要 Bash
#   輸出，會靜默扭曲 git status / wc -l 的結果）；保留其餘 PreToolUse entries，
#   陣列清空後連 key 一併 del，不留空殼。
#
# 注意：CLAUDE_HANDOFF_CONTEXT_WINDOW 故意**不**設 — 讓 statusline 寫的
# per-session cache 成為主要來源；這個 env var 只保留給 debug/override 用
# （需要時手動 export，不進 settings.json）。
#
# model 固定為 claude-opus-5。context 上限由 env.CLAUDE_CODE_DISABLE_1M_CONTEXT
# = "1" 壓到 200K：選單移除 1M 變體，原生 1M 的 model 也當成 200K，session 在
# 200K auto-compact。需要 1M 時在該 repo 的 .claude/settings.local.json 覆寫
# 成 "0"；此處 patch 的是各機器的預設值。

set -euo pipefail

input="$(cat)"
# 新機器 bootstrap：檔案不存在時以空物件為起點
if [ -z "$input" ]; then
    input='{}'
fi

# 強制 LF 結尾：Windows 版 jq.exe 輸出 CRLF，但 Claude Code 寫入時用 LF，
# 若不統一 chezmoi 每次 apply 都會看到全檔 diff。
echo "$input" | jq \
  --arg statusline_cmd '{{ .chezmoi.homeDir }}/.local/bin/statusline{{ if eq .chezmoi.os "windows" }}.exe{{ end }}' \
{{- if eq .chezmoi.os "windows" }}
{{- /* git-bash detection mirrors .chezmoi.toml.tmpl: non-scoop first, scoop last; joinPath yields backslashes */}}
{{-   $gbCands := list (joinPath .chezmoi.homeDir ".local/opt/git/bin/bash.exe") (joinPath "C:/Program Files" "Git/bin/bash.exe") (joinPath .chezmoi.homeDir "scoop/apps/git/current/bin/bash.exe") }}
{{-   $gitBash := "" }}
{{-   range $c := $gbCands }}{{ if and (eq $gitBash "") (stat $c) }}{{ $gitBash = $c }}{{ end }}{{ end }}
{{-   if eq $gitBash "" }}{{ $gitBash = (joinPath "C:/Program Files" "Git/bin/bash.exe") }}{{ end }}
  --arg git_bash '{{ $gitBash }}' \
{{- end }}
  '
    .model = "claude-opus-5"
    | .effortLevel = "high"
    | .outputStyle = "ELI5"
    | .autoUpdatesChannel = "latest"
    | .skipDangerousModePermissionPrompt = true
    | .skillListingBudgetFraction = 0.02
    | .permissions = (.permissions // {})
    | .permissions.defaultMode = "bypassPermissions"
    | .permissions.allow = (((.permissions.allow // []) + ["Skill(*)"]) | unique)
    | .permissions.deny = (
        ((.permissions.deny // []) + [
          "ReportFindings",
          "ScheduleWakeup",
          "SendFeedback",
          "Workflow"
        ]) | unique
      )
    | .skillOverrides = ((.skillOverrides // {}) + {
        "claude-api": "off",
        "code-review": "off",
        "dataviz": "off",
        "fewer-permission-prompts": "off",
        "init": "off",
        "keybindings-help": "off",
        "loop": "off",
        "run": "off",
        "schedule": "off",
        "security-review": "off",
        "simplify": "off",
        "update-config": "off",
        "workflow-authoring": "off"
      })
    | .statusLine = {
        type: "command",
        command: $statusline_cmd,
        padding: 0
      }
    | .env = (.env // {})
    | .env.CLAUDE_CODE_NO_FLICKER = "1"
    | .env.CLAUDE_CODE_DISABLE_1M_CONTEXT = "1"
    | .env |= del(.CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS)
{{- if eq .chezmoi.os "windows" }}
    | .env.CLAUDE_CODE_GIT_BASH_PATH = $git_bash
    | .env.CLAUDE_CODE_USE_POWERSHELL_TOOL = "1"
{{- else }}
    | .env |= del(.CLAUDE_CODE_GIT_BASH_PATH)
{{- end }}
    | .hooks = (.hooks // {})
    | .hooks.SessionEnd = (
        (.hooks.SessionEnd // [])
        | map(select(
            ((.hooks // []) | map(.command // "") | any(test("handoff-cleanup"))) | not
          ))
      )
    | if (.hooks.SessionEnd | length) == 0 then .hooks |= del(.SessionEnd) else . end
    | .hooks.PreToolUse = (
        (.hooks.PreToolUse // [])
        | map(select(
            ((.hooks // []) | map(.command // "") | any(test("rtk-rewrite"))) | not
          ))
      )
    | if (.hooks.PreToolUse | length) == 0 then .hooks |= del(.PreToolUse) else . end
    | .hooks.UserPromptSubmit = [
        {
          hooks: [
            {
              type: "command",
              command: "bash ~/.claude/hooks/handoff-reminder.sh"
            }
          ]
        }
      ]
    | .hooks.SessionStart = (
        (.hooks.SessionStart // []) as $ss
        | if ($ss | map((.hooks // []) | map(.command // "")) | flatten | any(test("claude-memory-seed")))
          then $ss
          else $ss + [
            {
              matcher: "*",
              hooks: [
                {
                  type: "command",
                  command: "bash ~/.local/bin/claude-memory-seed apply"
                }
              ]
            }
          ]
          end
      )
  ' | tr -d '\r'
