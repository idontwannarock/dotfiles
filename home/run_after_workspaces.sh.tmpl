#!/usr/bin/env bash
# chezmoi run_after_ script -- private workspaces (every OS; Windows runs it
# through Git Bash per [interpreters.sh]).
#
# A workspace is a separate private chezmoi source repo. This script reads the
# workspace list, asks once per machine which workspaces to install, and applies
# each chosen one with its own config and persistent state. The list repo is
# cloned to a temp dir and deleted after reading, so the full list never stays
# on disk. Design and file formats: docs/private-workspaces.md.
#
# Only `chezmoi update` reaches the network (list fetch, clone, pull). `apply`
# applies what is already cloned, like the public repo itself.

{{ template "scripts/log.sh" }}
set -u
log_begin "private workspaces"

state="$HOME/.config/chezmoi/workspaces.json"
cfg_root="$HOME/.config/chezmoi/workspaces"
parent=$(dirname "${CHEZMOI_WORKING_TREE:-}")
cz=${CHEZMOI_EXECUTABLE:-chezmoi}
# Test seam: the suite cannot give the script a TTY.
interactive=${DOTFILES_WS_INTERACTIVE:-}
[ -n "$interactive" ] || { [ -t 0 ] && interactive=1 || interactive=0; }

command -v jq >/dev/null 2>&1 || { log_warn "jq not found -- workspaces not processed"; exit 0; }
# jq.exe on Windows ends each output line with \r\n. Git Bash strips only the
# last one, so ids read in a loop keep a \r and match nothing in the list.
jq() { command jq "$@" | tr -d '\r'; return "${PIPESTATUS[0]}"; }
[ -f "$state" ] || { mkdir -p "${state%/*}"; printf '{}\n' >"$state"; }

save() { jq "$@" "$state" >"$state.tmp" && mv "$state.tmp" "$state"; }
ask_yes() {
    local reply
    printf '%s [y/N] ' "$1" >&2
    read -r reply || return 1
    case $reply in y|Y|yes) return 0 ;; esac
    return 1
}

log_section "list repo: asked once per machine; empty means no workspaces"
if [ "$(jq -r 'has("listRepo")' "$state")" != true ]; then
    if [ "$interactive" != 1 ]; then
        log_skip "list repo not set and no TTY to ask"
        exit 0
    fi
    printf 'Workspace list repo URL (empty = this machine uses no workspaces): ' >&2
    read -r answer || answer=""
    save --arg u "$answer" '.listRepo = $u'
    log_step "saved the list repo answer to $state"
fi
list_repo=$(jq -r '.listRepo' "$state")
[ -n "$list_repo" ] || { log_skip "this machine uses no workspaces"; exit 0; }

if [ "${CHEZMOI_COMMAND:-}" = update ]; then
    log_section "fetch list: read it, ask about new workspaces, delete the copy"
    tmp=$(mktemp -d)
    list=""
    if git clone --quiet --depth 1 "$list_repo" "$tmp/l" >/dev/null 2>&1; then
        list=$("$cz" execute-template --with-stdin '{{ "{{" }} .chezmoi.stdin | fromToml | toJson {{ "}}" }}' \
            <"$tmp/l/workspaces.toml" 2>/dev/null) || list="!"
    fi
    rm -rf "$tmp"

    if [ -z "$list" ]; then
        log_warn "cannot reach the workspace list -- keeping the saved answers"
    elif [ "$list" = "!" ]; then
        log_warn "workspaces.toml is missing from the list repo or is not valid TOML"
        exit 1
    else
        errors=$(jq -r '
            def fields: ["desc", "name", "retired", "url"];
            if (.schema | type) != "number" then "schema: missing or not a number"
            elif .schema > 2 then "schema \(.schema): this checkout reads schema 2 -- update the public dotfiles repo"
            elif .schema == 1 then "schema 1 is no longer read: remove every os field and set schema = 2"
            elif .schema != 2 then "schema \(.schema): unknown"
            else
              (del(.schema) | to_entries[] | .key as $k | .value as $v |
                if ($k | test("^w[0-9]+$") | not) then "\($k): id must be w<number>"
                elif ($v | type) != "object" then "\($k): must be a table"
                elif ($v | keys) != fields then "\($k): fields must be exactly \(fields | join(", "))"
                elif ($v.name | type) != "string" or ($v.name | test("^[a-z0-9][a-z0-9-]*$") | not) then "\($k): name must match [a-z0-9-]"
                elif ($v.desc | type) != "string" or $v.desc == "" then "\($k): desc must be a non-empty string"
                elif ($v.url | type) != "string" or $v.url == "" then "\($k): url must be a non-empty string"
                elif ($v.retired | type) != "boolean" then "\($k): retired must be true or false"
                else empty end),
              (del(.schema) | [.[].name?] | group_by(.)[] | select(length > 1) | "name \(.[0]): used by more than one id")
            end' <<<"$list")
        if [ -n "$errors" ]; then
            while IFS= read -r e; do log_warn "workspaces.toml: $e"; done <<<"$errors"
            exit 1
        fi

        for id in $(jq -r 'del(.schema) | keys[]' <<<"$list"); do
            entry=$(jq -c --arg id "$id" '.[$id]' <<<"$list")
            answered=$(jq -r --arg id "$id" '(.answers // {}) | has($id)' "$state")
            enabled=$(jq -r --arg id "$id" '.answers[$id].enabled == true' "$state")
            if [ "$answered" = true ]; then
                # Keep the saved copy of a chosen workspace in step with the list.
                [ "$enabled" = true ] && save --arg id "$id" --argjson e "$entry" '.answers[$id] = ({enabled: true} + $e)'
                continue
            fi
            name=$(jq -r '.name' <<<"$entry")
            if [ "$(jq -r '.retired' <<<"$entry")" = true ]; then
                log_skip "$id ($name) is retired"
                continue
            fi
            if [ "$interactive" != 1 ]; then
                log_skip "$id ($name) is new; no TTY to ask -- asking next time"
                continue
            fi
            if ask_yes "Install workspace '$name' -- $(jq -r '.desc' <<<"$entry")?"; then
                save --arg id "$id" --argjson e "$entry" '.answers[$id] = ({enabled: true} + $e)'
                log_step "$id ($name): enabled"
            else
                save --arg id "$id" '.answers[$id] = {enabled: false}'
                log_step "$id ($name): declined"
            fi
        done

        for id in $(jq -r '(.answers // {}) | keys[]' "$state"); do
            [ "$(jq -r --arg id "$id" 'has($id)' <<<"$list")" = true ] ||
                log_warn "$id is no longer in the list -- mark it retired instead of deleting it"
        done
    fi
fi

failed=0
for id in $(jq -r '(.answers // {}) | to_entries[] | select(.value.enabled == true) | .key' "$state"); do
    name=$(jq -r --arg id "$id" '.answers[$id].name' "$state")
    url=$(jq -r --arg id "$id" '.answers[$id].url' "$state")
    dir="$parent/dotfiles-$name"
    log_section "workspace $name: sync and apply"

    if [ "$(jq -r --arg id "$id" '.answers[$id].retired' "$state")" = true ]; then
        log_warn "workspace $name is retired -- no longer applied; its clone stays at $dir"
        continue
    fi

    if [ "${CHEZMOI_COMMAND:-}" = update ]; then
        if [ -d "$dir/.git" ]; then
            before=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
            if git -C "$dir" pull --quiet --ff-only >/dev/null 2>&1; then
                [ "$(git -C "$dir" rev-parse HEAD)" = "$before" ] && log_skip "$name is up to date" ||
                    log_step "$name: pulled"
            else
                log_warn "$name: pull failed -- applying the local copy"
            fi
        elif git clone --quiet "$url" "$dir" >/dev/null 2>&1; then
            log_step "$name: cloned to $dir"
        else
            log_warn "$name: clone failed"
        fi
    fi

    if [ ! -d "$dir" ]; then
        log_warn "$name: no clone at $dir -- run chezmoi update"
        continue
    fi
    mkdir -p "$cfg_root/$id"
    cfg="$cfg_root/$id/chezmoi.toml"
    # init regenerates the workspace's own config, so a prompt it gains is asked
    # here; --apply then applies it with its own persistent state. A prompt needs
    # a TTY, so without one apply runs on the saved config instead, and a new
    # question waits for the next run in a terminal.
    if [ "$interactive" = 1 ]; then
        set -- init --apply
    else
        root="$dir"
        [ -f "$dir/.chezmoiroot" ] && root="$dir/$(tr -d '\r\n' <"$dir/.chezmoiroot")"
        if [ ! -f "$cfg" ] && ls "$root"/.chezmoi.*.tmpl >/dev/null 2>&1; then
            log_warn "$name: its first apply asks questions -- run chezmoi update in a terminal"
            continue
        fi
        set -- apply
    fi
    if ! "$cz" "$@" --source "$dir" --config "$cfg" \
        --persistent-state "$cfg_root/$id/chezmoistate.boltdb"; then
        log_warn "$name: chezmoi apply failed"
        failed=1
    fi
done
exit "$failed"
