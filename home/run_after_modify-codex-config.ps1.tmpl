{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_after_ script — 合併 codex config（Windows）
# 同步全域設定與通用 MCP servers，但保留本機的 project 與 plugin 設定
#
# ⚠ 雙源：dot_codex/modify_config.toml 是 Unix 版本，此檔是 Windows 版本。
# 兩邊的全域設定（model、profiles、instructions）和 MCP servers 必須同步。
# 修改其中一邊時，務必同時更新另一邊。

{{ template "scripts/log.ps1" }}

Log-Begin "codex config merge"
try {
    $configDir = Join-Path $env:USERPROFILE ".codex"
    $configPath = Join-Path $configDir "config.toml"

    Log-Section "ensure ~/.codex exists"
    if (-not (Test-Path $configDir)) {
        New-Item -ItemType Directory -Path $configDir -Force | Out-Null
        Log-Step "[codex] created $configDir"
    } else {
        Log-Skip "[codex] $configDir already exists"
    }

    Log-Section "salvage the machine-local [projects.*] and [plugins.*] blocks -- a plain overwrite would lose machine-local settings"
    $keptSections = ""
    if (Test-Path $configPath) {
        $lines = Get-Content $configPath -Encoding UTF8
        $inKeep = $false
        $sections = @()
        foreach ($line in $lines) {
            if ($line -match '^\[(projects|plugins)\.') {
                $inKeep = $true
                $sections += $line
            } elseif ($line -match '^\[' -and $inKeep) {
                $inKeep = $false
            } elseif ($inKeep) {
                $sections += $line
            }
        }
        # 丟棄尾端空行。保留範圍到下一個 section header 為止，所以最後一個
        # 保留區塊與 [mcp_servers.*] 之間的空行也被收了進來；原樣保留會和
        # $mcpConfig 開頭那個空行疊加。此腳本重寫的是自己上一輪的輸出，必須是
        # 不動點，否則每次 apply 多一行。分隔一律由 $mcpConfig 單方提供。
        #
        # 用索引回退而非 $sections[0..($sections.Count - 2)]：Count 為 1 時範圍成為
        # 0..-1，PowerShell 展開為 0, -1，而 -1 指最後一個元素——不是清空陣列，
        # 而是複製出兩個元素，迴圈永不結束。
        $lastIdx = $sections.Count - 1
        while ($lastIdx -ge 0 -and $sections[$lastIdx] -match '^\s*$') { $lastIdx-- }
        $sections = if ($lastIdx -ge 0) { @($sections[0..$lastIdx]) } else { @() }

        if ($sections.Count -gt 0) {
            $keptSections = "`n" + ($sections -join "`n")
            Log-Step "[codex] preserving $($sections.Count) line(s) of project and plugin config"
        } else {
            Log-Skip "[codex] no project or plugin blocks to preserve"
        }
    } else {
        Log-Skip "[codex] no existing config.toml"
    }

    Log-Section "compose the global settings block -- must stay in sync with dot_codex/modify_config.toml (Unix)"
    $globalConfig = @'
#:schema https://developers.openai.com/codex/config-schema.json

model = "gpt-5.6-sol"
model_reasoning_effort = "high"
model_verbosity = "medium"
hide_agent_reasoning = true
project_doc_fallback_filenames = ["CLAUDE.md"]
project_doc_max_bytes = 65536

instructions = """
Prefer native Codex features over Claude-specific abstractions.
If a repository contains .claude/CLAUDE.md, read it when project workflow matters.
For non-trivial coding tasks, suggest using the $dev-workflow skill before implementation.
When a task ends with meaningful progress, ask whether it should be recorded in worklog.
"""

[tui]
alternate_screen = "never"
status_line = ["model-with-reasoning", "current-dir", "git-branch", "context-used", "five-hour-limit", "thread-title"]

[profiles.quick]
model_reasoning_effort = "low"
model_verbosity = "low"

[profiles.deep]
model_reasoning_effort = "high"
model_verbosity = "medium"

[profiles.research]
model_reasoning_effort = "high"
model_verbosity = "medium"
web_search = "live"
'@

    Log-Section "compose the MCP server block -- all entries are remote URLs, so this block is identical on every OS"
    $mcpConfig = @'

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"
'@

    Log-Section "write config.toml without a BOM -- PowerShell 5.x would otherwise emit one and Codex rejects it"
    $result = $globalConfig + $keptSections + $mcpConfig
    [System.IO.File]::WriteAllText($configPath, $result + "`n", [System.Text.UTF8Encoding]::new($false))
    Log-Step "[codex] wrote $configPath"
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
