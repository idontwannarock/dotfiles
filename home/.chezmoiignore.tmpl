# 註：repo 基礎建設（README.md、docs/、passgen/、claude/statusline 等）已移出 source
# root（見 ../.chezmoiroot，source 改從 home/ 讀取），chezmoi 看不到它們，故不再需要
# ignore 規則。新增的非部署檔只要放在 repo root（home/ 之外）即可，無須在此排除。

# ── Windows 專屬（非 Windows 環境排除）─────────────────────────────────────
{{- if ne .chezmoi.os "windows" }}
Documents
{{- end }}

# ── codex config（Windows 用 run_after_ 處理，排除 modify_ script）────────
{{- if eq .chezmoi.os "windows" }}
.codex/config.toml
{{- end }}

# ── rtk config（Windows 讀 AppData/Roaming，由 install-05 處理）───────────
{{- if eq .chezmoi.os "windows" }}
.config/rtk
.config/rtk/config.toml
{{- end }}

# ── zsh 設定（只部署到 macOS）───────────────────────────────────────────────
{{- if ne .chezmoi.os "darwin" }}
.zshrc
{{- end }}

# ── bash 設定（macOS 使用 zsh，不需要 bash）───────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
.bashrc
{{- end }}

# ── corp-ssh-askpass: bash helper deploys on Linux/WSL only ─────────
{{- if ne .chezmoi.os "linux" }}
.local/bin/corp-ssh-askpass
{{- end }}

# ── corp-ssh-askpass: PowerShell helper + .cmd shim deploy on Windows only ──
{{- if ne .chezmoi.os "windows" }}
.local/bin/corp-ssh-askpass.ps1
.local/bin/corp-ssh-askpass.cmd
{{- end }}

# ── switch-pwsh-to-msi: Windows-only helper (Store/MSIX pwsh -> official MSI) ──
{{- if ne .chezmoi.os "windows" }}
.local/bin/switch-pwsh-to-msi.ps1
{{- end }}

# ── PowerShell profile fragment 30-ssh-askpass: Windows only ───────────
{{- if ne .chezmoi.os "windows" }}
Documents/_shared-profile.d/30-ssh-askpass.ps1
{{- end }}

# ── vim wrappers: deploy only on Windows (paired with chezmoi-external archive) ──
# 15 .cmd files in ~/.local/bin/ delegating to ~/.local/share/vim/current/*.exe.
# Mirror scoop vim.json bin[] flags. See .chezmoiexternal.toml Wave 7 block.
{{- if ne .chezmoi.os "windows" }}
.local/bin/vim.cmd
.local/bin/vi.cmd
.local/bin/ex.cmd
.local/bin/view.cmd
.local/bin/rvim.cmd
.local/bin/rview.cmd
.local/bin/vimdiff.cmd
.local/bin/gvim.cmd
.local/bin/gview.cmd
.local/bin/evim.cmd
.local/bin/eview.cmd
.local/bin/rgvim.cmd
.local/bin/rgview.cmd
.local/bin/gvimdiff.cmd
.local/bin/xxd.cmd
{{- end }}

# ── Wave 10 toolchain: java version aliases (Windows only) ─────────────────
# 5 .cmd wrappers delegate java8/11/17/21/25 to ~/.local/opt/jdk-N/bin/java.exe.
# The use-java switcher lives under Documents/, already excluded on non-Windows.
# See .chezmoiexternal.toml Wave 10 block.
{{- if ne .chezmoi.os "windows" }}
.local/bin/java.cmd
.local/bin/javac.cmd
.local/bin/java8.cmd
.local/bin/java11.cmd
.local/bin/java17.cmd
.local/bin/java21.cmd
.local/bin/java25.cmd
.local/bin/python3.11.cmd
.local/bin/python3.13.cmd
{{- end }}
