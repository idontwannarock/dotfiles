# Windows Terminal OSC 9;9 - 報告當前工作目錄，讓 duplicate pane 繼承目錄
# 必須在 Starship 初始化之前定義
function Invoke-Starship-PreCommand {
    $loc = $executionContext.SessionState.Path.CurrentLocation
    $esc = [char]27
    $bel = [char]7
    $dq = [char]34
    $host.ui.Write($esc + ']9;12' + $bel)
    if ($loc.Provider.Name -eq 'FileSystem') {
        $host.ui.Write($esc + ']9;9;' + $dq + $loc.ProviderPath + $dq + $bel)
    }
}

{{ if lookPath "starship" -}}
# starship init is inlined when `chezmoi apply` renders this file. It is NOT run
# at shell start any more.
#
# `starship init powershell --print-full-init` only prints a fixed block of
# PowerShell code. The text changes when starship is upgraded, never between
# sessions, so asking for it at every shell start bought nothing.
#
# It bought nothing and cost about 280 ms: ~200 ms to start starship.exe and
# ~83 ms for the `Get-Command starship` PATH scan that guarded it. Starting any
# process on this class of machine costs about 110 ms -- `cmd /c exit` measures
# the same, so the price is CreateProcess, not starship.
#
# The block below therefore belongs to the starship binary this machine had at
# the last apply. After upgrading starship, run `chezmoi apply` to regenerate it.
# A stale block is loud, not silent: starship prints
# `error: Found argument ... which wasn't expected` on every prompt.
# See docs/starship.md.
{{ output "starship" "init" "powershell" "--print-full-init" }}
{{- else -}}
# starship was not on PATH when chezmoi rendered this file, so fall back to
# initialising at shell start. The next `chezmoi apply` inlines it.
if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (& starship init powershell --print-full-init | Out-String)
}
{{- end }}
