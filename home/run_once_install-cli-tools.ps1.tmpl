{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_ script — CLI 工具安裝（Windows）
#
# The only install left here is twg (Atlassian Teamwork Graph CLI), from its
# official installer. Every former scoop package below has moved elsewhere; the
# header is kept as a historical record of where each landed.
#
# Scoop uninstall for every package below is handled by the single
# run_once_after_migrate-scoop-cleanup.ps1.tmpl (which merged the former
# per-wave migrate scripts), except where noted.
#
# ── Archive ──────────────────────────────────────────────────────────────
# 7z moved to .chezmoiexternal.toml in Wave 12b (2026-06-18). The source is an
# MSI (chezmoi-external cannot extract MSI), so the external only downloads the
# pinned MSI; run_once_after_migrate-scoop-wave12b.ps1.tmpl does `msiexec /a` to
# lay it out under ~/.local/opt/7zip, registers the COM shell-extension (right-
# click menu), and uninstalls scoop's 7zip. The 7z.cmd wrapper puts it on PATH.
#
# ── Network ──────────────────────────────────────────────────────────────
# curl moved out of scoop in Wave 3 (2026-05-20). Win10 build 17063+ ships
# curl.exe in C:\Windows\System32\, and Git for Windows bundles a copy in
# <git>\mingw64\bin\.
#
# wget removed from Windows in Wave 3 (2026-05-20). No PowerShell or Git Bash
# script in this repo calls wget on Windows; the curl||wget fallback in
# run_onchange_install-03-claude-config.sh.tmpl is .sh.tmpl (Linux/macOS only).
#
# ── Media ────────────────────────────────────────────────────────────────
# ffmpeg moved to .chezmoiexternal.toml in Wave 6 (2026-05-25). Three archive-file
# entries (ffmpeg.exe + ffprobe.exe + ffplay.exe) share a single BtbN/FFmpeg-Builds
# zip, pinned to a dated autobuild tag for reproducibility.
#
# ── Shell enhancement ────────────────────────────────────────────────────
# clink removed from dotfiles install in Wave 4 (2026-05-21). dotfiles never
# invoked `clink autorun install`, and starship already provides prompt
# enhancement across PowerShell / Git Bash / zsh.
#
# ── WiX toolset ──────────────────────────────────────────────────────────
# dark removed from dotfiles install in Wave 4 (2026-05-21). Verified unused
# across the repo and not declared as a dependency by any installed scoop
# manifest. Soft unmanage: existing installs are left untouched.
#
# ── Static site / Network diagnostics / Video download ─────────────────
# hugo (extended), nexttrace, yt-dlp moved to .chezmoiexternal.toml in Wave 2
# (2026-05-20).
#
# ── Vim tutor ────────────────────────────────────────────────────────────
# vimtutor removed from dotfiles install in Wave 4 (2026-05-21). Interactive
# tutorial, no scripted dependency. Soft unmanage: existing installs are left
# untouched.
#
# vim itself moved to .chezmoiexternal.toml in Wave 7 (2026-05-25). The archive
# entry extracts the full vim distribution to ~/.local/share/vim/vim92/, and 15
# .cmd wrappers under ~/.local/bin/ mirror scoop vim.json bin[] aliases
# (vim/vi/ex/view/rvim/rview/vimdiff/gvim/gview/evim/eview/rgvim/rgview/gvimdiff/xxd).
#
# ── Go tooling ───────────────────────────────────────────────────────────
# golangci-lint moved to .chezmoiexternal.toml in Wave 2 (2026-05-20).
#
# ── Windows package managers ─────────────────────────────────────────────
# winget removed from dotfiles install in Wave 4 (2026-05-21). Win10 1809+ and
# Win11 ship winget.exe OS-bundled at
# %LOCALAPPDATA%\Microsoft\WindowsApps\winget.exe via the Microsoft.DesktopApp
# Installer Store package, so the scoop shim was pure duplication.
#
# winget-ps (Microsoft.WinGet.Client PowerShell module) removed in the same
# wave -- no dotfiles script imports it. Note that 99-command-not-found.ps1
# uses the separate PowerToys Microsoft.WinGet.CommandNotFound module, which
# is independent of winget-ps.
#
# ── GPG + password store for corp-ssh-askpass (Phase 2) ─────────────────
# gpg moved OFF scoop in Wave 8 (2026-06-10): scoop's manifest dropped an empty
# bin\gpgconf.ctl that forced GnuPG into portable mode (empty homedir, GNUPGHOME
# ignored), breaking corp-ssh decryption on every `scoop update gpg`. Now self-
# managed via run_onchange_install-gnupg.ps1.tmpl (vanilla gnupg.org installer,
# no gpgconf.ctl), with scoop uninstall in run_once_after_migrate-scoop-wave8-gpg.
# gopass moved to .chezmoiexternal.toml in Wave 3 (2026-05-20).

$ErrorActionPreference = "Stop"

{{ template "scripts/log.ps1" }}

Log-Begin "Windows CLI tools"
try {
    Log-Section "install twg (Atlassian Teamwork Graph CLI) -- replaces the Atlassian MCP; login stays manual"
    # -SkipSkills: the agent reads twg's bundled skills on demand via
    #   `twg help discover-skills`, and 10 of the 13 installed skills route to
    #   credit-consuming commands. -Yes records the terms consent unattended.
    # Credit-consuming commands are removed by TWG_COMMAND_SURFACE_RESTRICTION
    #   (Documents/exact__shared-profile.d/27-twg.ps1), not here.
    $twgExe = Join-Path $env:LOCALAPPDATA "Programs\twg\bin\twg.exe"
    if (Test-Path $twgExe) {
        Log-Skip "[twg] already installed"
    } else {
        Log-Step "[twg] installing via official installer"
        $installer = Join-Path $env:TEMP "twg-install.ps1"
        curl.exe -fsSL --retry 2 https://teamwork-graph.atlassian.com/cli/install.ps1 -o $installer
        if ($LASTEXITCODE -eq 0) {
            powershell -NoProfile -ExecutionPolicy Bypass -File $installer -SkipSkills -SkipLogin -Yes
        }
        if (Test-Path $twgExe) {
            Log-Step "[twg] run 'twg login' once in a terminal to authenticate"
        } else {
            Log-Warn "[twg] install failed. See https://developer.atlassian.com/cloud/twg-cli/"
        }
    }
} catch {
    Log-End -ErrorRecord $_
    throw
} finally {
    Log-End
}
{{ end -}}
