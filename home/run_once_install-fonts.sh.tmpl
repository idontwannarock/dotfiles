{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 字型安裝（Unix/macOS/WSL）
# macOS: brew cask, Linux/WSL: 手動下載提示

set -euo pipefail

{{ template "scripts/log.sh" }}
{{- if eq .chezmoi.os "darwin" }}
{{ template "scripts/brew-cask-install.sh" }}
{{- end }}

log_begin "fonts"

{{- if eq .chezmoi.os "darwin" }}

log_section "check Homebrew is available — casks are the only install path here"
if ! command -v brew &>/dev/null; then
    log_warn "[fonts] Homebrew not found; skipping"
    exit 0
fi

log_section "install the terminal fonts referenced by the Windows Terminal / shell config"
brew_install_cask font-caskaydia-cove-nerd-font
brew_install_cask font-jetbrains-mono

{{- else }}

log_section "report font sources — on Linux/WSL the host OS terminal owns fonts, not this shell"
log_skip "[fonts] managed by the host OS terminal emulator"
log_step "CaskaydiaCove Nerd Font: https://www.nerdfonts.com/font-downloads"
log_step "JetBrains Mono: https://www.jetbrains.com/lp/mono/"

{{- end }}
{{ end -}}
