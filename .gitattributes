* text=auto

# Programming languages
*.go text eol=lf

# Scripts (Unix)
*.sh text eol=lf
*.sh.tmpl text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.py text eol=lf

# Scripts (Windows)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Chezmoi ps1 templates: LF, not CRLF like the .ps1 above. Each one inlines
# .chezmoitemplates fragments, which the rule below forces to LF, so a CRLF
# body would render mixed endings. pwsh 7 -- the configured .ps1 interpreter
# -- reads LF fine.
*.ps1.tmpl text eol=lf

# Every other chezmoi template. Patterns match the whole basename, so a .tmpl
# suffix escapes every bare-extension rule above -- *.md never matches
# SKILL.md.tmpl -- leaving only `* text=auto`, which on Windows checks out CRLF.
# Templates inline .chezmoitemplates fragments (forced LF below), so that would
# render mixed endings. The .sh.tmpl and .ps1.tmpl rules above are this same
# rule, discovered one extension at a time; they stay only for their comments.
*.tmpl text eol=lf

# Everything deployed to ~/.local/bin/ -- extensionless wrappers, .cmd shims, and
# the .ps1 helpers alike. This rule sits after the extension rules above and last
# match wins, so it deliberately overrides *.ps1 -> CRLF and *.cmd -> CRLF here.
# pwsh 7 and cmd.exe both read LF fine.
# Paths are under home/ since the chezmoi source root moved there (.chezmoiroot).
home/dot_local/bin/* text eol=lf

# Git hooks (POSIX sh, run by git-bash on Windows — force LF)
home/dot_config/git/hooks/* text eol=lf

# Chezmoi template fragments (shell scripts, force LF)
home/.chezmoitemplates/** text eol=lf

# Config files
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ideavimrc text eol=lf
.ideavimrc text eol=lf
*.vimrc text eol=lf
.vimrc text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
