#!/bin/sh
# claude-memory-seed — unify Claude Code's autoMemoryDirectory across ALL git
# repos so every checkout/worktree of a repo shares one auto-memory home at
# ~/.claude/memory/<id>, where <id> is the slug (path with '/'->'-') of the
# repo's CANONICAL ROOT: the main checkout for a normal repo, the container for
# a bare+worktree layout. Anchoring on dirname(git-common-dir) makes <id> stable
# across all worktrees of a repo and unique across repos (no folder-name clash).
#
# On first apply for a repo it also MIGRATES existing memory into the new home
# (old basename scheme, then Claude's default projects/<id>/memory) by moving the
# memory/ dir only — transcripts are left in place. Migration runs only when the
# target is absent/empty; an already-populated target is never clobbered.
#
# Idempotent and self-gating: a non-git cwd or missing jq no-op silently; an
# autoMemoryDirectory pointing outside the managed roots (~/.claude/memory,
# ~/.claude/projects) is respected and never overwritten.
#
# Called from two triggers sharing this single source of truth:
#   - Claude SessionStart hook  (covers pre-existing repos, no git event)
#   - global post-checkout hook (covers new worktrees at `worktree add`/checkout)
#
# usage: claude-memory-seed {apply | where}
set -eu

common=$(git rev-parse --git-common-dir 2>/dev/null) || common=""
toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || toplevel=""

# Canonical root = dirname(realpath(common-dir)) — parent of .git (normal repo)
# or parent of .bare (bare+worktree). Stable across every worktree of the repo.
canonical_root() {
    [ -n "$common" ] || return 1
    rp=$(CDPATH= cd -- "$common" 2>/dev/null && pwd -P) || return 1
    dirname "$rp"
}

# slug: absolute path with '/' -> '-' (matches Claude's projects-dir encoding).
repo_id() {
    root=$(canonical_root) || return 1
    printf '%s' "$root" | tr '/' '-'
}

do_apply() {
    [ -n "$toplevel" ] || return 0            # not a git repo: no-op
    id=$(repo_id) || return 0
    command -v jq >/dev/null 2>&1 || return 0 # no jq: no-op, never block caller

    memroot="$HOME/.claude/memory"
    target="$memroot/$id"

    # Migrate existing memory into the new home — only when target absent/empty.
    if [ ! -d "$target" ] || [ -z "$(ls -A "$target" 2>/dev/null)" ]; then
        root=$(canonical_root)
        for src in "$memroot/$(basename "$root")" "$HOME/.claude/projects/$id/memory"; do
            [ "$src" = "$target" ] && continue
            [ -d "$src" ] && [ -n "$(ls -A "$src" 2>/dev/null)" ] || continue
            [ -d "$target" ] && rmdir "$target" 2>/dev/null || true  # drop empty target so mv renames
            mkdir -p "$(dirname "$target")"
            mv "$src" "$target"
            printf 'claude-memory-seed: migrated %s -> %s\n' "$src" "$target" >&2
            break
        done
    fi

    value="~/.claude/memory/$id"
    settings="$toplevel/.claude/settings.local.json"
    if [ -f "$settings" ]; then
        cur=$(jq -r '.autoMemoryDirectory // ""' "$settings" 2>/dev/null) || cur=""
        [ "$cur" = "$value" ] && return 0           # already canonical: nothing to do
        case "$cur" in
            ""|"~/.claude/memory/"*|"~/.claude/projects/"*) ;;  # missing/managed: (re)write
            *) return 0 ;;                          # custom value: respect, never overwrite
        esac
        input=$(cat "$settings")
    else
        input='{}'
    fi
    [ -n "$input" ] || input='{}'

    mkdir -p "$toplevel/.claude"
    printf '%s' "$input" | jq --arg d "$value" '.autoMemoryDirectory = $d' \
        | tr -d '\r' >"$settings"
    printf 'claude-memory-seed: set autoMemoryDirectory=%s\n' "$value" >&2
}

cmd=${1:-apply}
case "$cmd" in
    apply) do_apply ;;
    where) id=$(repo_id 2>/dev/null) && [ -n "$id" ] && printf '~/.claude/memory/%s\n' "$id" || echo ;;
    *)     echo "usage: claude-memory-seed {apply | where}" >&2; exit 1 ;;
esac
