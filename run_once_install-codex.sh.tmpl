{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 安裝 Codex CLI（Unix/macOS/WSL）
# 只在 codex 指令不存在時執行安裝，冪等設計

if command -v codex &>/dev/null; then
    exit 0
fi

{{ template "scripts/load-nvm" }}

if ! command -v npm &>/dev/null; then
    echo "[codex] npm not found, skipping install."
    exit 0
fi

echo "Installing Codex CLI..."
npm install -g @openai/codex
{{ end -}}
