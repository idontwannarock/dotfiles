{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 字型安裝（Unix/macOS/WSL）

set -euo pipefail

echo "=== Font Setup ==="

if ! command -v brew &>/dev/null; then
    echo "[fonts] Homebrew not found. Skipping."
    exit 0
fi

brew_install_cask() {
    local name="$1"
    local cask="${2:-$1}"
    if brew list --cask "$cask" &>/dev/null 2>&1; then
        echo "[$cask] already installed, skipping."
    else
        echo "[$cask] Installing via brew cask..."
        brew install --cask "$cask"
    fi
}

{{- if eq .chezmoi.os "darwin" }}
# macOS: brew cask fonts
brew_install_cask "font-caskaydia-cove-nerd-font"
brew_install_cask "font-jetbrains-mono"
{{- else }}
# Linux/WSL: fonts are typically managed at the OS level
echo "[fonts] Linux/WSL — install fonts via system package manager or download manually."
echo "  CaskaydiaCove Nerd Font: https://www.nerdfonts.com/font-downloads"
echo "  JetBrains Mono: https://www.jetbrains.com/lp/mono/"
{{- end }}

echo "=== Font setup complete. ==="
{{ end -}}
