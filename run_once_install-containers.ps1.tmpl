{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_ script — 容器與雲端工具安裝（Windows）

$ErrorActionPreference = "Stop"

Write-Host "=== Container & Cloud Tools Setup ===" -ForegroundColor Cyan

if (-not (Get-Command "scoop" -ErrorAction SilentlyContinue)) {
    Write-Host "scoop not found. Cannot install tools." -ForegroundColor Red
    exit 1
}

function Install-ScoopPackage {
    param([string]$Name, [string]$Package = $Name)
    if (Get-Command $Name -ErrorAction SilentlyContinue) {
        Write-Host "[$Name] already installed, skipping." -ForegroundColor Gray
    } else {
        Write-Host "[$Package] Installing via scoop..." -ForegroundColor Yellow
        scoop install $Package
    }
}

# ── Docker ───────────────────────────────────────────────────────────────
# docker and docker-compose moved to .chezmoiexternal.toml in Wave 5 (2026-05-25).
# Engine runs in WSL2 Ubuntu; Windows side is CLI-only via tcp://127.0.0.1:2375.
# lazydocker (TUI) intentionally stays on scoop (not chezmoi-managed).

# ── Kubernetes ───────────────────────────────────────────────────────────
# kubectl and kubelogin moved to .chezmoiexternal.toml in Wave 2 (2026-05-20).
# Lens stays on scoop — it's a GUI app, not a single binary.

# ── Lens (K8s GUI) ──────────────────────────────────────────────────────
scoop bucket add extras 2>$null
Install-ScoopPackage "lens"

Write-Host "=== Container tools setup complete. ===" -ForegroundColor Cyan
{{ end -}}
