{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_ script — Claude Code plugin 安裝（Unix/macOS/WSL）
# 腳本內容改變時自動重新執行

set -euo pipefail

{{ template "scripts/load-nvm" }}

echo "=== Claude Code Plugin Setup ==="

if ! command -v claude &>/dev/null; then
    echo "WARNING: claude command not found. Skipping plugin setup." >&2
    exit 0
fi

# 1. 新增 superpowers marketplace
echo "[1/3] Adding superpowers marketplace..."
claude plugin marketplace add obra/superpowers-marketplace 2>&1 || true

# 2. 安裝 superpowers plugin
echo "[2/4] Installing superpowers plugin..."
claude plugin install superpowers 2>&1 || true

# 3. 安裝 code-review plugin（官方）
echo "[3/5] Installing code-review plugin..."
claude plugin install code-review 2>&1 || true

# 4. 安裝 slack plugin（官方）
echo "[4/5] Installing slack plugin..."
claude plugin install slack 2>&1 || true

# 5. 安裝 jdtls（Java LSP 依賴）
echo "[5/6] Installing jdtls..."
JDTLS_DIR="$HOME/.local/share/jdtls"
if ! command -v jdtls &>/dev/null && [ ! -f "$JDTLS_DIR/bin/jdtls" ]; then
    JDTLS_VERSION="1.58.0-202602271700"
    JDTLS_URL="https://download.eclipse.org/jdtls/snapshots/jdt-language-server-${JDTLS_VERSION}.tar.gz"
    echo "  Downloading jdtls ${JDTLS_VERSION}..."
    mkdir -p "$JDTLS_DIR"
    if command -v curl &>/dev/null; then
        curl -fsSL "$JDTLS_URL" | tar xz -C "$JDTLS_DIR"
    elif command -v wget &>/dev/null; then
        wget -qO- "$JDTLS_URL" | tar xz -C "$JDTLS_DIR"
    else
        echo "  WARNING: curl/wget not found. Install jdtls manually to $JDTLS_DIR" >&2
    fi
else
    echo "  jdtls already installed, skipping."
fi

# 6. 清理不需要的 plugin cache
echo "[6/6] Cleaning up stale plugin caches..."
PLUGIN_CACHE="$HOME/.claude/plugins/cache"
# explanatory-output-style: 已被 learning-output-style 完全取代
rm -rf "$PLUGIN_CACHE/claude-plugins-official/explanatory-output-style" 2>/dev/null && echo "  Removed explanatory-output-style" || true
# superpowers marketplace 版: 已改用 official 版
rm -rf "$PLUGIN_CACHE/superpowers-marketplace/superpowers" 2>/dev/null && echo "  Removed marketplace superpowers" || true

echo "=== Plugin setup complete. Restart Claude Code to activate. ==="
{{ end -}}
