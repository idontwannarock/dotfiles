{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 註冊 Claude Code MCP servers（Unix/macOS/WSL）
# claude mcp add 是冪等操作，已存在的 server 會被覆寫

{{ template "scripts/load-nvm" }}

if ! command -v claude &>/dev/null; then
    echo "[mcp] claude CLI not found, skipping MCP setup."
    exit 0
fi

echo "[mcp] Setting up Claude Code MCP servers..."

add_npx_mcp() {
    local name="$1"; shift
    claude mcp add --scope user "$name" -- npx "$@"
    echo "[mcp] $name registered."
}

if command -v npx &>/dev/null; then
    add_npx_mcp "agent-browser" "agent-browser-mcp"
    add_npx_mcp "chrome-devtools" "-y" "chrome-devtools-mcp@latest"
else
    echo "[mcp] npx not found, skipping MCP setup."
fi

echo "[mcp] Done."
{{ end -}}
