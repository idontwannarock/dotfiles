{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_onchange_before_ script — 安裝後續 phase 需要的 CLI 依賴
#
# jq:       modify_settings.json.sh.tmpl 用來 patch Claude Code settings.json
# dos2unix: run_onchange_install-03-claude-config.ps1.tmpl 用來修正 plugin .sh 的 CRLF

if (-not (Get-Command "scoop" -ErrorAction SilentlyContinue)) {
    Write-Host "scoop not available. Install prereqs manually:" -ForegroundColor Red
    Write-Host "  scoop install jq dos2unix" -ForegroundColor Yellow
    exit 1
}

function Ensure-ScoopTool {
    param([string]$Name)
    if (Get-Command $Name -ErrorAction SilentlyContinue) { return }
    Write-Host "Installing $Name (required by later chezmoi scripts)..." -ForegroundColor Cyan
    scoop install $Name
}

Ensure-ScoopTool "jq"
Ensure-ScoopTool "dos2unix"
{{ end -}}
