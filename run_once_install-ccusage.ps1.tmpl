{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_ script — 安裝 ccusage CLI（Windows）
# 只在 ccusage 指令不存在時執行安裝，冪等設計

if (Get-Command "ccusage" -ErrorAction SilentlyContinue) {
    exit 0  # 已安裝，跳過
}

if (Get-Command "bun" -ErrorAction SilentlyContinue) {
    Write-Host "Installing ccusage (bun)..." -ForegroundColor Cyan
    bun install -g ccusage
} elseif (Get-Command "npm" -ErrorAction SilentlyContinue) {
    Write-Host "Installing ccusage (npm)..." -ForegroundColor Cyan
    npm install -g ccusage
} else {
    Write-Host "[ccusage] Neither bun nor npm found, skipping install." -ForegroundColor Yellow
    exit 0
}
{{ end -}}
