{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 開發語言與 runtime 安裝（Unix/macOS/WSL）
# macOS: 全部用 brew
# Linux/WSL: 一般工具用 apt，有版本管理需求的（JDK, Python, Go 等）用 brew
# 每個工具各自做冪等檢查，已安裝則跳過

set -euo pipefail

echo "=== Runtime & Language Setup ==="

# ── NVM ──────────────────────────────────────────────────────────────────
if [ -s "$HOME/.nvm/nvm.sh" ]; then
    echo "[nvm] already installed, skipping."
else
    echo "[nvm] Installing..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash
fi

{{ template "scripts/load-nvm" }}

# ── Node.js (via nvm) ───────────────────────────────────────────────────
if command -v node &>/dev/null; then
    echo "[node] already installed ($(node -v)), skipping."
elif command -v nvm &>/dev/null || type nvm &>/dev/null; then
    echo "[node] Installing latest LTS via nvm..."
    nvm install --lts
else
    echo "[node] nvm not available, skipping node install."
fi

# ── Vim ──────────────────────────────────────────────────────────────────
if command -v vim &>/dev/null; then
    echo "[vim] already installed, skipping."
else
{{- if eq .chezmoi.os "darwin" }}
    echo "[vim] Installing via brew..."
    brew install vim
{{- else }}
    echo "[vim] Installing via apt..."
    sudo apt-get install -y vim
{{- end }}
fi

# ── Starship (shell prompt) ──────────────────────────────────────────────
if command -v starship &>/dev/null; then
    echo "[starship] already installed, skipping."
else
{{- if eq .chezmoi.os "darwin" }}
    echo "[starship] Installing via brew..."
    brew install starship
{{- else }}
    echo "[starship] Installing via official installer..."
    curl -sS https://starship.rs/install.sh | sh -s -- --yes
{{- end }}
fi

# ── 以下為版本管理工具，統一用 brew ─────────────────────────────────────

if ! command -v brew &>/dev/null; then
    echo "[brew] Homebrew not found. Skipping version-managed tool installs (Go, Python, JDKs, etc.)."
    echo "  Install: /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    echo "=== Runtime setup partially complete (brew-based tools skipped). ==="
    exit 0
fi

brew_install() {
    local cmd="$1"
    local pkg="${2:-$1}"
    if command -v "$cmd" &>/dev/null; then
        echo "[$cmd] already installed, skipping."
    else
        echo "[$pkg] Installing via brew..."
        brew install "$pkg"
    fi
}

brew_install_cask() {
    local name="$1"
    local cask="${2:-$1}"
    if brew list --cask "$cask" &>/dev/null 2>&1; then
        echo "[$cask] already installed, skipping."
    else
        echo "[$cask] Installing via brew cask..."
        brew install --cask "$cask"
    fi
}

# ── Go ───────────────────────────────────────────────────────────────────
brew_install go

# ── Python ───────────────────────────────────────────────────────────────
brew_install python3 python@3.11
brew install python@3.13 2>/dev/null || echo "[python@3.13] already installed or unavailable."

# ── uv (Python package manager) ─────────────────────────────────────────
brew_install uv

# ── Rust ─────────────────────────────────────────────────────────────────
brew_install rustup rustup-init
if command -v rustup &>/dev/null && ! rustup show active-toolchain &>/dev/null 2>&1; then
    echo "[rust] Initializing default toolchain..."
    rustup default stable
fi

# ── Maven ────────────────────────────────────────────────────────────────
brew_install mvn maven

# ── JDKs (Adoptium Temurin) ──────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
# macOS: brew cask from adoptium tap
brew tap adoptium/openjdk 2>/dev/null || true
for ver in 8 11 17 21 25; do
    brew_install_cask "temurin${ver}" "temurin@${ver}"
done
{{- else }}
# Linux/WSL: brew formulae
for ver in 8 11 17 21 25; do
    pkg="temurin${ver}"
    if brew list "$pkg" &>/dev/null 2>&1; then
        echo "[$pkg] already installed, skipping."
    else
        echo "[$pkg] Installing via brew..."
        brew install "$pkg" 2>/dev/null || echo "[$pkg] not available in brew, skipping."
    fi
done
{{- end }}

echo "=== Runtime setup complete. ==="
{{ end -}}
