{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — 開發語言與 runtime 安裝（Unix/macOS/WSL）
#
# 安裝策略：
#   系統工具（vim, starship, go）：Linux apt / 官方 installer、macOS brew
#   Node.js  : nvm（兩平台）
#   Rust     : rustup 官方 installer（兩平台）
#   uv       : Linux 官方 installer、macOS brew
#   Python   : 完全由 uv 管理（`uv python install`）
#   Java/JDK : sdkman（兩平台，pinned Temurin identifier）
#   Maven    : sdkman（兩平台）
#
# sdkman 的 Temurin identifier 會隨上游更新漂移，下方 JDK_VERSIONS 是 pinned 值。
# ⚠ 每半年 review 一次最新 Temurin identifier：
#     sdk list java | grep tem
# 最後 review 日期：2026-04-20

set -euo pipefail

# ── pinned JDK versions (sdkman) — REVIEW EVERY 6 MONTHS ────────────────
JDK_VERSIONS=(
    "8.0.442-tem"
    "11.0.26-tem"
    "17.0.14-tem"
    "21.0.6-tem"
    "25.0.1-tem"
)

echo "=== Runtime & Language Setup ==="

# ── NVM ──────────────────────────────────────────────────────────────────
if [ -s "$HOME/.nvm/nvm.sh" ]; then
    echo "[nvm] already installed, skipping."
else
    echo "[nvm] Installing..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash
fi

{{ template "scripts/load-nvm" }}

# ── Node.js (via nvm) ───────────────────────────────────────────────────
if command -v node &>/dev/null; then
    echo "[node] already installed ($(node -v)), skipping."
elif command -v nvm &>/dev/null || type nvm &>/dev/null; then
    echo "[node] Installing latest LTS via nvm..."
    nvm install --lts
else
    echo "[node] nvm not available, skipping node install."
fi

# ── Vim ──────────────────────────────────────────────────────────────────
if command -v vim &>/dev/null; then
    echo "[vim] already installed, skipping."
else
{{- if eq .chezmoi.os "darwin" }}
    echo "[vim] Installing via brew..."
    brew install vim
{{- else }}
    echo "[vim] Installing via apt..."
    sudo apt-get install -y vim
{{- end }}
fi

# ── Starship (shell prompt) ──────────────────────────────────────────────
if command -v starship &>/dev/null; then
    echo "[starship] already installed, skipping."
else
{{- if eq .chezmoi.os "darwin" }}
    echo "[starship] Installing via brew..."
    brew install starship
{{- else }}
    echo "[starship] Installing via official installer..."
    curl -sS https://starship.rs/install.sh | sh -s -- --yes
{{- end }}
fi

# ── Go ───────────────────────────────────────────────────────────────────
# Go 官方沒提供像 rustup / sdkman 的 version manager；Go 1.21+ 內建
# GOTOOLCHAIN 可自動下載專案需求版本，所以裝一份基礎版本即可。
if command -v go &>/dev/null; then
    echo "[go] already installed ($(go version | awk '{print $3}')), skipping."
else
{{- if eq .chezmoi.os "darwin" }}
    echo "[go] Installing via brew..."
    brew install go
{{- else }}
    echo "[go] Installing via apt..."
    sudo apt-get install -y golang-go
{{- end }}
fi

# ── Rust (rustup 官方 installer，兩平台) ────────────────────────────────
if command -v rustup &>/dev/null; then
    echo "[rustup] already installed, skipping."
else
    echo "[rustup] Installing via official installer..."
    # --no-modify-path: 由我們自己在 shell rc 管 PATH（~/.cargo/bin 已在 $HOME/.local/bin 之後）
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --no-modify-path
fi

# Make cargo bin available in this session
[ -s "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# ── uv (Python package + version manager) ───────────────────────────────
if command -v uv &>/dev/null; then
    echo "[uv] already installed, skipping."
else
{{- if eq .chezmoi.os "darwin" }}
    echo "[uv] Installing via brew..."
    brew install uv
{{- else }}
    echo "[uv] Installing via official installer..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
{{- end }}
fi

# uv 官方 installer 裝到 ~/.local/bin；確保本次 session 能找到
export PATH="$HOME/.local/bin:$PATH"

# ── Python (由 uv 管理) ─────────────────────────────────────────────────
# uv python install 本身是冪等的：已安裝會 reuse。
if command -v uv &>/dev/null; then
    echo "[python] Ensuring 3.13 is installed via uv..."
    uv python install 3.13
else
    echo "[python] uv not available, skipping python install."
fi

# ── SDKMAN (Java / JVM toolchain manager) ───────────────────────────────
if [ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]; then
    echo "[sdkman] already installed, skipping."
else
    echo "[sdkman] Installing via official installer (rcupdate=false)..."
    # rcupdate=false: 避免 sdkman 自動改 .bashrc / .zshrc（chezmoi 管理中，改動會被覆蓋）
    curl -s "https://get.sdkman.io?rcupdate=false" | bash
fi

{{ template "scripts/load-sdkman" }}

if command -v sdk &>/dev/null; then
    # 非互動模式：避免 `sdk install` 詢問 "set as default?"
    SDKMAN_CONFIG="$HOME/.sdkman/etc/config"
    if [ -f "$SDKMAN_CONFIG" ]; then
        if grep -q '^sdkman_auto_answer=' "$SDKMAN_CONFIG"; then
            sed -i.bak 's/^sdkman_auto_answer=.*/sdkman_auto_answer=true/' "$SDKMAN_CONFIG"
            rm -f "${SDKMAN_CONFIG}.bak"
        else
            echo "sdkman_auto_answer=true" >> "$SDKMAN_CONFIG"
        fi
    fi

    # ── JDKs via sdkman (Temurin) ────────────────────────────────────────
    for ver in "${JDK_VERSIONS[@]}"; do
        if [ -d "$HOME/.sdkman/candidates/java/${ver}" ]; then
            echo "[jdk ${ver}] already installed, skipping."
        else
            echo "[jdk ${ver}] Installing via sdkman..."
            if ! sdk install java "$ver"; then
                echo "[jdk ${ver}] install failed — identifier may be stale."
                echo "  Refresh with: sdk list java | grep tem"
            fi
        fi
    done

    # ── Maven via sdkman ─────────────────────────────────────────────────
    if [ -d "$HOME/.sdkman/candidates/maven/current" ]; then
        echo "[maven] already installed, skipping."
    else
        echo "[maven] Installing via sdkman..."
        sdk install maven || echo "[maven] install failed."
    fi
else
    echo "[sdkman] sdk command not available in this session — JDK/Maven skipped."
fi

echo "=== Runtime setup complete. ==="
{{ end -}}
