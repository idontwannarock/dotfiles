{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_ script — CLI 工具安裝（Windows）

$ErrorActionPreference = "Stop"

Write-Host "=== CLI Tools Setup ===" -ForegroundColor Cyan

if (-not (Get-Command "scoop" -ErrorAction SilentlyContinue)) {
    Write-Host "scoop not found. Cannot install tools." -ForegroundColor Red
    exit 1
}

function Install-ScoopPackage {
    param([string]$Name, [string]$Package = $Name)
    if (Get-Command $Name -ErrorAction SilentlyContinue) {
        Write-Host "[$Name] already installed, skipping." -ForegroundColor Gray
    } else {
        Write-Host "[$Package] Installing via scoop..." -ForegroundColor Yellow
        scoop install $Package
    }
}

scoop bucket add extras 2>$null

# ── Archive ──────────────────────────────────────────────────────────────
Install-ScoopPackage "7z" "7zip"

# ── Network ──────────────────────────────────────────────────────────────
# curl moved out of scoop in Wave 3 (2026-05-20). Win10 build 17063+ ships
# curl.exe in C:\Windows\System32\, and Git for Windows bundles a copy in
# <git>\mingw64\bin\. The migration script run_once_after_migrate-scoop-wave3.ps1.tmpl
# handles scoop uninstall on existing machines.
#
# wget removed from Windows in Wave 3 (2026-05-20). No PowerShell or Git Bash
# script in this repo calls wget on Windows; the curl||wget fallback in
# run_onchange_install-03-claude-config.sh.tmpl is .sh.tmpl (Linux/macOS only).

# ── Media ────────────────────────────────────────────────────────────────
# ffmpeg moved to .chezmoiexternal.toml in Wave 6 (2026-05-25). Three archive-file
# entries (ffmpeg.exe + ffprobe.exe + ffplay.exe) share a single BtbN/FFmpeg-Builds
# zip, pinned to a dated autobuild tag for reproducibility. The migration script
# run_once_after_migrate-scoop-wave6.ps1.tmpl handles scoop uninstall on existing
# machines.

# ── Shell enhancement ────────────────────────────────────────────────────
# clink removed from dotfiles install in Wave 4 (2026-05-21). dotfiles never
# invoked `clink autorun install`, and starship already provides prompt
# enhancement across PowerShell / Git Bash / zsh. The migration script
# run_once_after_migrate-scoop-wave4.ps1.tmpl handles scoop uninstall on
# existing machines.

# ── WiX toolset ──────────────────────────────────────────────────────────
# dark removed from dotfiles install in Wave 4 (2026-05-21). Verified unused
# across the repo and not declared as a dependency by any installed scoop
# manifest. Soft unmanage: existing installs are left untouched.

# ── Static site / Network diagnostics / Video download ─────────────────
# hugo (extended), nexttrace, yt-dlp moved to .chezmoiexternal.toml in Wave 2
# (2026-05-20). The migration script run_once_after_migrate-scoop-wave2.ps1.tmpl
# handles scoop uninstall on existing machines.

# ── Vim tutor ────────────────────────────────────────────────────────────
# vimtutor removed from dotfiles install in Wave 4 (2026-05-21). Interactive
# tutorial, no scripted dependency. Soft unmanage: existing installs are left
# untouched.
#
# vim itself moved to .chezmoiexternal.toml in Wave 7 (2026-05-25). The archive
# entry extracts the full vim distribution to ~/.local/share/vim/vim92/, and 15
# .cmd wrappers under ~/.local/bin/ mirror scoop vim.json bin[] aliases
# (vim/vi/ex/view/rvim/rview/vimdiff/gvim/gview/evim/eview/rgvim/rgview/gvimdiff/xxd).
# The migration script run_once_after_migrate-scoop-wave7.ps1.tmpl handles
# scoop uninstall on existing machines.

# ── Go tooling ───────────────────────────────────────────────────────────
# golangci-lint moved to .chezmoiexternal.toml in Wave 2 (2026-05-20).

# ── Windows package managers ─────────────────────────────────────────────
# winget removed from dotfiles install in Wave 4 (2026-05-21). Win10 1809+ and
# Win11 ship winget.exe OS-bundled at
# %LOCALAPPDATA%\Microsoft\WindowsApps\winget.exe via the Microsoft.DesktopApp
# Installer Store package, so the scoop shim was pure duplication.
#
# winget-ps (Microsoft.WinGet.Client PowerShell module) removed in the same
# wave -- no dotfiles script imports it. Note that 99-command-not-found.ps1
# uses the separate PowerToys Microsoft.WinGet.CommandNotFound module, which
# is independent of winget-ps.
#
# The migration script run_once_after_migrate-scoop-wave4.ps1.tmpl handles
# scoop uninstall on existing machines (winget + winget-ps).

# ── GPG + password store for corp-ssh-askpass (Phase 2) ─────────────────
# gpg suite stays on scoop: multi-binary suite (gpg + gpg-agent + gpgconf +
# pinentry + DLLs) with installer side-effects (gpgconf.ctl, gpg2.exe alias,
# $persist_dir/home relocation). Upstream is gnupg.org NSIS .exe, not GitHub.
Install-ScoopPackage "gpg"
# gopass moved to .chezmoiexternal.toml in Wave 3 (2026-05-20).

Write-Host "=== CLI tools setup complete. ===" -ForegroundColor Cyan
{{ end -}}
