{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_after_ script — Wave 1 Scoop → chezmoi-external migration
#
# Runs after .chezmoiexternal.toml has deployed the 5 binaries into ~/.local/bin/:
#   (1) Uninstall the matching scoop packages (if installed)
#   (2) Ensure User PATH puts ~/.local/bin before ~/scoop/shims so the
#       chezmoi-managed binaries take precedence over any stale scoop shim
#
# Idempotent: skips uninstall if scoop is unaware of the package, skips PATH
# rewrite if the order is already correct.

$ErrorActionPreference = "Continue"
$pkgs = @("starship", "zellij", "uv", "jq", "ripgrep")

Write-Host "=== Wave 1: Scoop -> chezmoi-external migration ===" -ForegroundColor Cyan

# --- (1) Scoop uninstall ----------------------------------------------------
if (Get-Command "scoop" -ErrorAction SilentlyContinue) {
    foreach ($pkg in $pkgs) {
        $installed = $false
        try {
            $listOutput = scoop list $pkg 2>$null | Out-String
            if ($listOutput -match "(?im)^\s*$pkg\s") { $installed = $true }
        } catch {}
        if ($installed) {
            Write-Host "[$pkg] uninstalling from scoop..." -ForegroundColor Yellow
            scoop uninstall $pkg 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0) {
                Write-Warning "[$pkg] scoop uninstall returned non-zero exit; continuing."
            }
        } else {
            Write-Host "[$pkg] not installed via scoop, skipping." -ForegroundColor Gray
        }
    }
} else {
    Write-Host "scoop not found, skipping uninstall phase." -ForegroundColor Gray
}

# --- (2) PATH reorder -------------------------------------------------------
$localBin   = (Join-Path $env:USERPROFILE ".local\bin").TrimEnd('\')
$scoopShims = (Join-Path $env:USERPROFILE "scoop\shims").TrimEnd('\')
$userPath   = [Environment]::GetEnvironmentVariable("Path", "User")

if (-not $userPath) {
    Write-Host "[PATH] User PATH is empty; prepending ~/.local/bin." -ForegroundColor Yellow
    [Environment]::SetEnvironmentVariable("Path", $localBin, "User")
    Write-Warning "User PATH updated. Restart your terminal/SSH session for changes to take effect."
    Write-Host "=== Migration complete. ===" -ForegroundColor Cyan
    return
}

$entries = @($userPath.Split(';') | Where-Object { $_ -ne '' })
$localIdx = -1
$shimIdx  = -1
for ($i = 0; $i -lt $entries.Count; $i++) {
    $expanded = [Environment]::ExpandEnvironmentVariables($entries[$i]).TrimEnd('\')
    if ($localIdx -lt 0 -and $expanded -ieq $localBin)   { $localIdx = $i }
    if ($shimIdx  -lt 0 -and $expanded -ieq $scoopShims) { $shimIdx  = $i }
}

$needsRewrite = $false
if ($shimIdx -ge 0) {
    if ($localIdx -lt 0 -or $localIdx -gt $shimIdx) { $needsRewrite = $true }
} elseif ($localIdx -lt 0) {
    $needsRewrite = $true
}

if (-not $needsRewrite) {
    Write-Host "[PATH] order already correct, no change." -ForegroundColor Gray
    Write-Host "=== Migration complete. ===" -ForegroundColor Cyan
    return
}

Write-Host "[PATH] before: ~/.local/bin idx=$localIdx, ~/scoop/shims idx=$shimIdx" -ForegroundColor Gray

$newEntries = New-Object System.Collections.Generic.List[string]
$inserted   = $false
foreach ($entry in $entries) {
    $expanded = [Environment]::ExpandEnvironmentVariables($entry).TrimEnd('\')
    if ($expanded -ieq $localBin) { continue }
    if (-not $inserted -and $expanded -ieq $scoopShims) {
        $newEntries.Add($localBin)
        $inserted = $true
    }
    $newEntries.Add($entry)
}
if (-not $inserted) {
    $newEntries.Insert(0, $localBin)
}

$newPath = $newEntries -join ';'
[Environment]::SetEnvironmentVariable("Path", $newPath, "User")
Write-Host "[PATH] after:  ~/.local/bin moved before ~/scoop/shims (or prepended)" -ForegroundColor Yellow
Write-Warning "User PATH updated. Restart your terminal/SSH session for changes to take effect."

Write-Host "=== Migration complete. ===" -ForegroundColor Cyan
{{ end -}}
