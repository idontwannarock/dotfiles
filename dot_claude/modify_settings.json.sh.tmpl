#!/usr/bin/env bash
# chezmoi modify_ script — patch Claude Code settings.json
#
# 策略：
# 只 patch 穩定的「個人偏好」欄位，保留 enabledPlugins / extraKnownMarketplaces
# 等會被 Claude Code runtime 寫入的部分。
#
# 同步的欄位：
# - model = claude-opus-4-8（200K context 變體，非 [1m] 1M variant）
# - effortLevel、autoUpdatesChannel、skipDangerousModePermissionPrompt
# - permissions.defaultMode = bypassPermissions
# - permissions.allow 併入 "Skill(*)"（union + unique，不覆蓋現有 entries）
# - statusLine（跨平台處理執行檔路徑）
# - hooks.PreToolUse（註冊 rtk-rewrite.sh，Bash matcher）
# - hooks.UserPromptSubmit（註冊 handoff-reminder.sh，context 用量階梯提醒）
# - hooks.SessionEnd（註冊 handoff-cleanup.sh，清理 per-session cache）
# - hooks.SessionStart（union-append claude-memory-seed；**不** hard-assign，
#   以保留 herdr / agent-sessions 等工具於 runtime 註冊的 SessionStart entries）
#
# 注意：CLAUDE_HANDOFF_CONTEXT_WINDOW 故意**不**設 — 讓 statusline 寫的
# per-session cache 成為主要來源；這個 env var 只保留給 debug/override 用
# （需要時手動 export，不進 settings.json）。
#
# model 固定為 claude-opus-4-8（200K context）。需要 1M 時用 /model 臨時切，
# 或在該機器的 settings.local.json 覆寫；此處 patch 的是各機器的預設值。

set -euo pipefail

input="$(cat)"
# 新機器 bootstrap：檔案不存在時以空物件為起點
if [ -z "$input" ]; then
    input='{}'
fi

# 強制 LF 結尾：Windows 版 jq.exe 輸出 CRLF，但 Claude Code 寫入時用 LF，
# 若不統一 chezmoi 每次 apply 都會看到全檔 diff。
echo "$input" | jq \
  --arg statusline_cmd '{{ .chezmoi.homeDir }}/.local/bin/statusline{{ if eq .chezmoi.os "windows" }}.exe{{ end }}' \
{{- if eq .chezmoi.os "windows" }}
  --arg git_bash '{{ printf "%s/scoop/apps/git/current/bin/bash.exe" .chezmoi.homeDir | replace "/" "\\" }}' \
{{- end }}
  '
    .model = "claude-opus-4-8"
    | .effortLevel = "high"
    | .autoUpdatesChannel = "latest"
    | .skipDangerousModePermissionPrompt = true
    | .skillListingBudgetFraction = 0.02
    | .permissions = (.permissions // {})
    | .permissions.defaultMode = "bypassPermissions"
    | .permissions.allow = (((.permissions.allow // []) + ["Skill(*)"]) | unique)
    | .statusLine = {
        type: "command",
        command: $statusline_cmd,
        padding: 0
      }
    | .env = (.env // {})
    | .env.CLAUDE_CODE_NO_FLICKER = "1"
    | .env.CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS = "10000"
{{- if eq .chezmoi.os "windows" }}
    | .env.CLAUDE_CODE_GIT_BASH_PATH = $git_bash
    | .env.CLAUDE_CODE_USE_POWERSHELL_TOOL = "1"
{{- else }}
    | .env |= del(.CLAUDE_CODE_GIT_BASH_PATH)
{{- end }}
    | .hooks = (.hooks // {})
    | .hooks.PreToolUse = [
        {
          matcher: "Bash",
          hooks: [
            {
              type: "command",
              command: "bash ~/.claude/hooks/rtk-rewrite.sh"
            }
          ]
        }
      ]
    | .hooks.UserPromptSubmit = [
        {
          hooks: [
            {
              type: "command",
              command: "bash ~/.claude/hooks/handoff-reminder.sh"
            }
          ]
        }
      ]
    | .hooks.SessionEnd = [
        {
          hooks: [
            {
              type: "command",
              command: "bash ~/.claude/hooks/handoff-cleanup.sh"
            }
          ]
        }
      ]
    | .hooks.SessionStart = (
        (.hooks.SessionStart // []) as $ss
        | if ($ss | map((.hooks // []) | map(.command // "")) | flatten | any(test("claude-memory-seed")))
          then $ss
          else $ss + [
            {
              matcher: "*",
              hooks: [
                {
                  type: "command",
                  command: "bash ~/.local/bin/claude-memory-seed apply"
                }
              ]
            }
          ]
          end
      )
  ' | tr -d '\r'
