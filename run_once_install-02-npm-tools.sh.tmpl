{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_once_ script — npm 全域工具安裝（Unix/macOS/WSL）
# 需要 nvm/npm，由 install-01-runtimes 安裝

set -euo pipefail

{{ template "scripts/load-nvm" }}

echo "=== npm Global Tools Setup ==="

if ! command -v npm &>/dev/null; then
    echo "[npm-tools] npm not found, skipping all npm installs."
    exit 0
fi

npm_install() {
    local cmd="$1"
    local pkg="$2"
    if command -v "$cmd" &>/dev/null; then
        echo "[$cmd] already installed, skipping."
    else
        echo "[$cmd] Installing $pkg..."
        npm install -g "$pkg"
    fi
}

# ── Claude Code ──────────────────────────────────────────────────────────
npm_install claude @anthropic-ai/claude-code

# ── Codex CLI ────────────────────────────────────────────────────────────
npm_install codex @openai/codex

# ── OpenSpec CLI ─────────────────────────────────────────────────────────
if command -v openspec &>/dev/null; then
    echo "[openspec] already installed, skipping."
else
    echo "[openspec] Installing..."
    npm install -g @fission-ai/openspec
    # 只產生 SKILL.md，不產生 slash commands（透過 skill description 自動觸發，
    # 省 session-start context，並與全域 dev-workflow skill 整合）
    openspec config set delivery skills
    echo "[openspec] Configured (delivery=skills)."
fi

echo "=== npm tools setup complete. ==="
{{ end -}}
