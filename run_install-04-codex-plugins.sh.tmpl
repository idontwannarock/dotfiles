{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_ script — install Codex plugins
# Codex ships the `openai-curated` marketplace; superpowers is published there.
#
# Uses run_ (reruns every apply), not run_onchange_: the guard is idempotent (skip
# if installed) and cheap. If an apply no-ops because codex isn't on PATH yet,
# run_onchange_ would record the content hash and never retry even after the
# environment is fixed; run_ rechecks every apply and self-heals (same rationale as
# install-02-npm-tools).

set -euo pipefail

if ! command -v codex &>/dev/null; then
    echo "[codex-plugins] codex CLI not found, skipping."
    exit 0
fi

echo "=== Codex Plugins Setup ==="

# superpowers: planning / TDD / debugging / review skills — the cross-tool dev-workflow
# skill references these by name (brainstorming, writing-plans, verification-before-completion,
# finishing-a-development-branch, using-git-worktrees).
# Match name + whitespace + "installed" (ERE). NOT '.*installed' — that greedily
# matches the "not installed" status too, so an uninstalled plugin would be
# misread as installed and never get installed. Parity with the .ps1 guard.
if codex plugin list 2>/dev/null | grep -Eq 'superpowers@openai-curated[[:space:]]+installed'; then
    echo "[plugins] superpowers already installed."
else
    echo "[plugins] Installing superpowers..."
    codex plugin add superpowers@openai-curated 2>&1 | sed 's/^/  /' || true
fi

echo "=== Codex plugins setup complete. Restart Codex to activate. ==="
{{ end -}}
