{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_ script — 安裝 OpenSpec CLI + 設定 delivery mode（Windows）
# 只在 openspec 指令不存在時執行安裝，冪等設計

if (Get-Command "openspec" -ErrorAction SilentlyContinue) {
    exit 0  # 已安裝，跳過
}

if (-not (Get-Command "npm" -ErrorAction SilentlyContinue)) {
    Write-Host "[openspec] npm not found, skipping install." -ForegroundColor Yellow
    exit 0
}

Write-Host "[openspec] Installing OpenSpec CLI..." -ForegroundColor Cyan
npm install -g @fission-ai/openspec

# 只產生 slash commands，不產生 SKILL.md（避免與全域 opsx/* commands 重複）
openspec config set delivery commands
Write-Host "[openspec] Installed and configured (delivery=commands)." -ForegroundColor Green
{{ end -}}
