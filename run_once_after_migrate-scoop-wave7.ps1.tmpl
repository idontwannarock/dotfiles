{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_after_ script -- Wave 7 Scoop cleanup
#
# Uninstall scoop packages that dotfiles now manages via .chezmoiexternal.toml:
#   - vim : vim/vim-win32-installer 9.2.0530 unsigned x64 archive; full
#           distribution at ~/.local/share/vim/vim92/, 15 .cmd wrappers at
#           ~/.local/bin/ mirror scoop bin[] aliases.
#
# Wave 1 already handled User PATH ordering (`~/.local/bin` before
# `~/scoop/shims`), so this script does NOT touch PATH.
#
# This script does NOT clean up gvim shell context-menu registry entries
# created by scoop's install-context.reg post-install hook. Those entries
# live under HKCU\Software\Classes and survive scoop uninstall. If the user
# relied on them, they will point to a now-missing scoop path; re-register
# manually via ~/.local/share/vim/vim92/install-context.reg if needed.
#
# Idempotent: skips uninstall if scoop is unaware of the package; skips
# entirely if scoop itself is not installed.

$ErrorActionPreference = "Continue"
$pkgs = @("vim")

Write-Host "=== Wave 7: Scoop cleanup ===" -ForegroundColor Cyan

if (-not (Get-Command "scoop" -ErrorAction SilentlyContinue)) {
    Write-Host "scoop not found, skipping uninstall phase." -ForegroundColor Gray
    Write-Host "=== Wave 7 migration complete. ===" -ForegroundColor Cyan
    return
}

foreach ($pkg in $pkgs) {
    $installed = $false
    try {
        $listOutput = scoop list $pkg 2>$null | Out-String
        $pattern = "(?im)^\s*$([regex]::Escape($pkg))\b"
        if ($listOutput -match $pattern) { $installed = $true }
    } catch {}
    if ($installed) {
        Write-Host "[$pkg] uninstalling from scoop..." -ForegroundColor Yellow
        scoop uninstall $pkg 2>&1 | Out-Null
        if ($LASTEXITCODE -ne 0) {
            Write-Warning "[$pkg] scoop uninstall returned non-zero exit; continuing."
        }
    } else {
        Write-Host "[$pkg] not installed via scoop, skipping." -ForegroundColor Gray
    }
}

Write-Host "=== Wave 7 migration complete. ===" -ForegroundColor Cyan
{{ end -}}
